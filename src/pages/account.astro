---
// 互动页（原 /account/，V38 起删除登录/账号系统；V40 起删除音乐电台）
// 内容：个人博客留言板（giscus / GitHub Discussions，site.ts GISCUS 配置）
// 背景：与全站统一 —— React Bits <Particles /> 粒子层（Base.astro 渲染，跟随浅/深主题）。
// 说明：V53 起去掉 GridScan 固定深色背景与 'auth-route' 深色令牌，改为与其他页面一致的粒子背景。
import Base from '../layouts/Base.astro';
import GiscusComments from '../components/GiscusComments.astro';
import { SITE } from '../site';

const title = '互动';
---
<Base title={title}>
  <div class="room-stage">
    <div class="wrap room">
      <header class="page-head" data-ent>
        <p class="kicker"><b>ROOM</b> / 留言板</p>
        <h1>{title}</h1>
        <p class="sub">把想说的留下。</p>
      </header>

      <section class="room-card" data-ent style="--ad:.12s">
        <GiscusComments
          title="留言板"
          desc="把想说的留下 —— 基于 GitHub Discussions（giscus），登录 GitHub 即可参与。"
        />
      </section>
    </div>
  </div>
</Base>

<style>
  /* ============================================================
     互动页（V53：背景与其他页面统一为全站粒子层）
     这里只负责内容排版与玻璃卡质感，全部使用全站 token，跟随浅/深主题。
     ============================================================ */
  .room-stage {
    position: relative;
    z-index: 1; /* 浮于 .pparticles-layer（z-index:-1）之上 */
    padding: clamp(2rem, 5vw, 4rem) 0 clamp(2.4rem, 6vh, 4.6rem);
  }
  .wrap.room {
    max-width: var(--w-max);
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .room-card {
    padding: 1.5rem 1.7rem 1.7rem;
    border-radius: 20px;
    background: var(--glass);
    border: 1px solid color-mix(in srgb, var(--line-2) 70%, rgba(255, 255, 255, 0.35));
    box-shadow: var(--shadow-sm);
    backdrop-filter: blur(16px) saturate(1.35);
    -webkit-backdrop-filter: blur(16px) saturate(1.35);
  }
</style>
