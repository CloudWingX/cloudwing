---
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';
import { getCollection } from 'astro:content';

type WMeta = {
  no: string;
  title: string;
  summary: string;
  date: string;
  tags: string[];
  cover: string;
  url: string;
};

const fmtDate = (d: Date) => new Date(d).toISOString().slice(0, 10);
const raw = await getCollection('works');
raw.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const works: WMeta[] = raw.map((m) => ({
  no: 'W-' + String(m.data.order ?? 0).padStart(3, '0'),
  title: m.data.title ?? '未命名档案',
  summary: m.data.summary ?? '',
  date: fmtDate(m.data.date),
  tags: m.data.tags ?? [],
  cover: m.data.cover ?? '/covers/blank.svg',
  url: `/works/${m.id}/`,
}));

// 分类统计：按出现次数降序，同次再按拼音
const tagCounts = new Map<string, number>();
works.forEach((w) => w.tags.forEach((t) => tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1)));
const allTags = [...tagCounts.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh'),
);
---
<Base title="作品库" center>
  <div class="wrap">
    <header class="page-head" data-ent>
      <p class="kicker"><b>01</b> / INDEX OF WORKS</p>
      <h1>作品库</h1>
      <p class="sub">按归档日期倒序。点选分类查看对应档案，点「全部」查看所有。</p>
    </header>

    <section class="section" style="padding-top:2rem">
      <!-- 分类分段控件：单条磨砂玻璃条，单选切换 -->
      <div class="catbar-wrap rv" aria-label="作品分类">
        <div class="catbar" id="catbar" role="tablist">
          <span class="catbar-label">分类</span>
          <div class="catbar-segs" role="presentation">
            <button type="button" class="seg on" data-tag="*" role="tab" aria-selected="true">全部</button>
            {allTags.map(([t, n]) => (
              <button type="button" class="seg" data-tag={t} role="tab" aria-selected="false">
                <span>{t}</span>
                <i class="seg-count">{n}</i>
              </button>
            ))}
          </div>
          <span class="catbar-count" id="count">{works.length} 项</span>
        </div>
      </div>
      <ul class="grid rv" id="grid" style="--d:.08s">
        {works.map((w) => <WorkCard w={w} />)}
      </ul>
      <p class="sub" id="empty" hidden>该分类下暂无作品。</p>
      {works.length === 0 && (
        <p class="sub">暂无档案。把作品 Markdown 文件放进 <code>src/content/works/</code> 即可展示。</p>
      )}
    </section>
  </div>
</Base>

<style>
  /* —— 分类分段控件：单条磨砂玻璃条 —— */
  .catbar-wrap { margin-bottom: 2rem; }
  .catbar {
    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: 100%;
    padding: 0.4rem 0.5rem 0.4rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: var(--glass);
    backdrop-filter: blur(16px) saturate(1.3);
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
    box-shadow: var(--shadow-sm);
  }
  .catbar-label {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-3);
    padding-right: 0.9rem;
    border-right: 1px solid var(--line-2);
    white-space: nowrap;
  }
  .catbar-segs {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding: 0.15rem 0;
  }
  .catbar-segs::-webkit-scrollbar { display: none; }
  .catbar .seg {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.5em 1.1em;
    border: 0;
    border-radius: 999px;
    background: transparent;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: var(--ink-2);
    cursor: pointer;
    font: inherit;
    line-height: 1.2;
    transition: background 0.18s ease, color 0.18s ease, box-shadow 0.18s ease;
  }
  .catbar .seg:hover { color: var(--accent-deep); background: var(--accent-soft); }
  .catbar .seg.on {
    background: var(--accent);
    color: var(--on-accent);
    box-shadow: 0 2px 8px -2px color-mix(in srgb, var(--accent) 55%, transparent);
  }
  .catbar .seg-count {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.68em;
    line-height: 1;
    min-width: 1.4em;
    text-align: center;
    border-radius: 999px;
    padding: 0.2em 0.35em;
    background: var(--accent-soft);
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
    transition: background 0.18s ease, color 0.18s ease;
  }
  .catbar .seg:hover .seg-count { color: var(--accent-deep); background: rgba(255, 255, 255, 0.75); }
  .catbar .seg.on .seg-count { color: var(--on-accent); background: color-mix(in srgb, var(--on-accent) 24%, transparent); }
  .catbar-count {
    flex: none;
    margin-left: auto;
    padding-left: 0.9rem;
    border-left: 1px solid var(--line-2);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  /* 深色主题 */
  :global(html[data-theme='dark']) .catbar { background: rgba(24, 24, 28, 0.6); box-shadow: none; }
  :global(html[data-theme='dark']) .catbar .seg:hover { background: rgba(255, 255, 255, 0.1); color: var(--ink); }
  @media (max-width: 720px) {
    .catbar { border-radius: 18px; flex-wrap: wrap; gap: 0.5rem 0.75rem; padding: 0.6rem 0.6rem 0.6rem 0.9rem; }
    .catbar-label { display: none; }
    .catbar-segs { width: 100%; }
    .catbar-count { margin-left: 0; padding-left: 0; border-left: 0; }
  }
</style>

<script>
  // 分类单选筛选（点选一个分类查看，点“全部”恢复）+ 实时数量。
  // document 级事件委托 + DOM 状态驱动：软导航重建后无需重绑，永远有效。
  const selectTag = (segEl) => {
    const bar = segEl.closest('.catbar');
    if (!bar) return;
    const tag = segEl.dataset.tag ?? '*';
    const segs = Array.from(bar.querySelectorAll('button.seg'));
    // 单选：目标段若已选中则回到“全部”，否则选中目标
    let active = tag;
    if (tag !== '*' && segEl.classList.contains('on')) active = '*';
    segs.forEach((s) => {
      const on = s.dataset.tag === active;
      s.classList.toggle('on', on);
      s.setAttribute('aria-selected', String(on));
    });
    applyFilter(active);
  };

  const applyFilter = (active) => {
    const grid = document.getElementById('grid');
    const countEl = document.getElementById('count');
    const emptyEl = document.getElementById('empty');
    if (!grid) return;
    const items = Array.from(grid.querySelectorAll('.wk-item'));
    let n = 0;
    for (const it of items) {
      const tags = (it.dataset.tags ?? '').split(' ').filter(Boolean);
      const show = active === '*' || tags.includes(active);
      it.hidden = !show;
      if (show) n++;
    }
    if (countEl) countEl.textContent = `${n} / ${items.length} 项`;
    if (emptyEl) emptyEl.hidden = n !== 0;
  };

  const onSegClick = (e) => {
    const segEl = e.target.closest('button.seg[data-tag]');
    if (!segEl) return;
    e.preventDefault();
    selectTag(segEl);
  };

  if (!window.__cwWorksFilterWired) {
    window.__cwWorksFilterWired = true;
    document.addEventListener('click', onSegClick);
    // 软导航完成后恢复当前选中态统计
    window.addEventListener('astro:page-load', () => {
      const bar = document.getElementById('catbar');
      const grid = document.getElementById('grid');
      if (!bar || !grid) return;
      const active = bar.querySelector('button.seg.on')?.dataset.tag ?? '*';
      applyFilter(active);
    });
  }
</script>
