---
import SidebarLayout from '../../layouts/SidebarLayout.astro';
import WorkCard from '../../components/WorkCard.astro';
import { getCollection } from 'astro:content';

type WMeta = {
  no: string;
  title: string;
  summary: string;
  date: string;
  tags: string[];
  cover: string;
  url: string;
};

const fmtDate = (d: Date) => new Date(d).toISOString().slice(0, 10);
const raw = await getCollection('works');
raw.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const works: WMeta[] = raw.map((m) => ({
  no: 'W-' + String(m.data.order ?? 0).padStart(3, '0'),
  title: m.data.title ?? '未命名档案',
  summary: m.data.summary ?? '',
  date: fmtDate(m.data.date),
  tags: m.data.tags ?? [],
  cover: m.data.cover ?? '/covers/blank.svg',
  url: `/works/${m.id}/`,
}));

// 分类统计已移到导航栏「作品库」二级菜单（见 components/Header.astro），
// 这里不再自己算，只按 ?tag= 过滤卡片。
---
<SidebarLayout title="作品库" center>
  <div class="wrap">
    <header class="page-head" data-ent>
      <p class="kicker"><b>01</b> / INDEX OF WORKS</p>
      <h1>作品库</h1>
    </header>

    <section class="section" style="padding-top:2rem">
      <!-- 分类选择器已移到导航栏二级菜单；这里只保留「当前筛的是哪个分类」与清除入口 -->
      <div class="catnow-wrap rv" id="catnow" hidden>
        <p class="catnow">
          <span class="catnow-k">分类</span>
          <span class="catnow-v" id="catnow-name">全部</span>
          <span class="catnow-count" id="count">{works.length} 项</span>
          <a class="catnow-clear" id="catnow-clear" href="/works/">清除筛选</a>
        </p>
      </div>
      <ul class="grid rv" id="grid" style="--d:.08s">
        {works.map((w) => <WorkCard w={w} />)}
      </ul>
      <p class="sub" id="empty" hidden>该分类下暂无作品。</p>
      {works.length === 0 && (
        <p class="sub">暂无档案。把作品 Markdown 文件放进 <code>src/content/works/</code> 即可展示。</p>
      )}
    </section>
  </div>
</SidebarLayout>

<style>
  /* —— 当前分类提示条（分类选择器已移到导航栏二级菜单，这里只做回显与清除）—— */
  .catnow-wrap { margin-bottom: 1.6rem; }
  .catnow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0;
    padding: 0.4rem 0.75rem 0.4rem 0.95rem;
    border-radius: 999px;
    border: var(--line-w) solid var(--line-2);
    background: var(--glass);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    box-shadow: var(--shadow-sm);
    font-size: 0.8rem;
  }
  .catnow-k {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .catnow-v {
    font-weight: 700;
    color: var(--accent-deep);
  }
  .catnow-count {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .catnow-clear {
    margin-left: 0.25rem;
    padding: 0.16rem 0.6rem;
    border: var(--line-w) solid var(--line-2);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--ink-2);
    text-decoration: none;
    transition: color 0.16s var(--ease), border-color 0.16s var(--ease), background 0.16s var(--ease);
  }
  .catnow-clear:hover {
    color: var(--accent-deep);
    border-color: var(--accent);
    background: var(--accent-soft);
  }
</style>

<script>
  // 分类筛选：选择器已在导航栏「作品库」二级菜单里，点分类 → /works/?tag=xxx。
  // 这里只负责按 ?tag= 过滤卡片、回显当前分类、以及「清除筛选」。
  // document 级事件委托 + DOM 状态驱动，软导航重建后无需重绑。
  const applyFilter = (active) => {
    const grid = document.getElementById('grid');
    const countEl = document.getElementById('count');
    const emptyEl = document.getElementById('empty');
    const wrap = document.getElementById('catnow');
    const nameEl = document.getElementById('catnow-name');
    if (!grid) return;
    const items = Array.from(grid.querySelectorAll('.wk-item'));
    let n = 0;
    for (const it of items) {
      const tags = (it.dataset.tags ?? '').split(' ').filter(Boolean);
      const show = active === '*' || tags.includes(active);
      it.hidden = !show;
      if (show) n++;
    }
    if (countEl) countEl.textContent = `${n} / ${items.length} 项`;
    if (emptyEl) emptyEl.hidden = n !== 0;
    if (wrap) wrap.hidden = active === '*';
    if (nameEl) nameEl.textContent = active === '*' ? '全部' : active;
  };

  const initFromUrl = () => {
    if (!document.getElementById('grid')) return;
    let want = null;
    try {
      want = new URLSearchParams(location.search).get('tag');
    } catch (err) {
      want = null;
    }
    applyFilter(want || '*');
  };

  if (!window.__cwWorksFilterWired) {
    window.__cwWorksFilterWired = true;
    // 必须挂在 document 上：astro:page-load 由路由器在 document 上派发且不冒泡，
    // 挂 window 永远收不到 —— 于是软导航（例如点导航栏分类）后筛选不会生效。
    document.addEventListener('astro:page-load', initFromUrl);
    // 直接打开 /works/?tag=xxx 时，astro:page-load 可能早于本脚本执行，故再补一次
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFromUrl, { once: true });
    } else {
      initFromUrl();
    }
  }
</script>
