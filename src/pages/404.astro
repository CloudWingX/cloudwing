---
import SidebarLayout from '../layouts/SidebarLayout.astro';
import BrandMark from '../components/BrandMark.astro';
import { SITE } from '../site';
---
<SidebarLayout title="404 · 档案不存在" description="未找到该档案。" center>
  <div class="wrap">
    <div class="e404">
      <p class="kicker center"><b>ERR</b> / RECORD NOT FOUND</p>
      <div class="code">4<b>0</b>4</div>
      <p>你要找的档案不存在、已被移除，或从未归档。</p>
      <div style="display:flex;gap:0.9rem;justify-content:center;flex-wrap:wrap">
        <a class="btn" href="/"><span>返回索引首页</span></a>
        <a class="btn ghost" href="/posts/"><span>阅读文章</span></a>
      </div>
      <p style="margin-top:3rem;font-family:var(--font-mono);font-size:0.74rem;letter-spacing:0.14em">
        <BrandMark variant="icon" height={22} />&nbsp;{SITE.title} · 档案编号校验失败
      </p>
    </div>
  </div>
</SidebarLayout>
