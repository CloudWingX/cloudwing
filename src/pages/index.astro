---
// 首页 —— 内容橱窗（四层结构）
//   ① Hero：大标题 + 定位语 + 技术标签 + 两个 CTA
//   ② 最新作品：3 张卡片（封面 / 项目名 / 一句话说明 / 技术标签）
//   ③ 精选影像：6 张网格 + 悬停预览
//   ④ 关于预览：2–3 句介绍 + 完整档案入口
// 背景：全站统一的暗色视频背景（Base.astro 渲染）+ 既有导航栏。
// 说明：原来的 01/02/03 编号入口卡片已按要求删除 —— 首页直接展示内容，不再只做跳转目录。
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../site';

// —— ② 最新作品：取作品库最新 3 篇（与 /works/ 联动） ——
const worksAll = await getCollection('works');
const latestWorks = worksAll
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3)
  .map((w) => ({
    no: 'W-' + String(w.data.order ?? 0).padStart(3, '0'),
    title: w.data.title ?? '未命名档案',
    summary: w.data.summary ?? '',
    tags: (w.data.tags ?? []).slice(0, 3),
    tools: (w.data.tools ?? []).slice(0, 3),
    cover: w.data.cover ?? '/covers/blank.svg',
    url: `/works/${w.id}/`,
  }));

// —— ③ 精选影像：按日期挑 6 张（优先 16:9，网格更整齐） ——
const allShots = await getCollection('shots');
const featuredShots = allShots
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .filter((s) => s.data.image)
  .slice(0, 6)
  .map((s) => ({
    image: s.data.image,
    title: s.data.title ?? '',
    game: s.data.game ?? '',
    aspect: s.data.aspect ?? '16:9',
  }));

// 关于预览的简介（首页只放 2–3 句，细节留在 /about/）
const aboutPreview = [
  `${SITE.author} —— 计算机科学与技术（本科在读），方向偏 Java 后端与质量保障：能写 Spring Boot 接口，也用测试的眼光对待每一个缺陷。`,
  '这个站把学习轨迹、代码与产出按编号留存，让每一次练习都可追溯。',
];

/* ══════════════════════════════════════════════════════════════
   Hero 数据 —— 版式照 reference（code_20260918.html）复刻，
   内容全部来自站点真实数据（与 ②③④、/works/、/gallery/ 联动）
   ══════════════════════════════════════════════════════════════ */

// 徽标：取最近一条更新记录（changelog）
const changelog = (await getCollection('changelog')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);
const latestKind = changelog[0]?.data.items?.[0]?.kind ?? '更新';
const latestTitle = changelog[0]?.data.items?.[0]?.title ?? '内容持续更新中';

// 两个统计数字（参考是「170+ components / Free forever」）：用站点真实条目数
const worksCount = worksAll.length;
const shotsCount = allShots.length;

// 技术栈标签：由作品 frontmatter 的 tools 现算，取出现最多的 6 个
const toolCount = new Map<string, number>();
for (const w of worksAll) for (const t of w.data.tools ?? []) if (t) toolCount.set(t, (toolCount.get(t) ?? 0) + 1);
const topTools = [...toolCount.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'en'))
  .slice(0, 6)
  .map(([t]) => t);
const stackTop = topTools.length ? topTools : ['Java', 'Spring Boot', 'MySQL', 'Git'];

// 展示卡片下半部分：最近几条真实更新（喂给 code-card，避免用空行凑高）
const recentItems = changelog
  .flatMap((c) => (c.data.items ?? []).map((it) => ({ date: c.data.date, ...it })))
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 6)
  .map((it) => `${it.kind} · ${it.title}`);
---

<Base
  title="首页"
  description="CloudWing 云翼的个人档案站：Java 后端与质量保障方向。这里收录编号作品档案与影像收藏，打开即见最新产出。"
  bodyClass="home-route"
>
  <div class="home">
    <!-- ═══ ① Hero ═══
         版式照 reference（code_20260918.html）像素级复刻：
         左栏 badge → 两行大标题（第二行渐变）→ 副标题 → 两个统计 → 技术标签
         右栏展示卡片（参考位是代码卡片，这里用站点真实技术栈填充同款卡片）
         几何/间距/断点全部取参考实测值；强调色用站点雾蓝（--accent）。 -->
    <section class="hero" id="top">
      <div class="hero-content">
        <div class="hero-badge">
          <span class="badge-dot"></span>
          <span>{latestKind} · {latestTitle}</span>
        </div>

        <h1 class="hero-title">
          code <span class="ht-on">on</span><br />
          clouds,<br />
          life <span class="ht-on">on</span><br />
          <span class="title-gradient">wings.</span>
        </h1>

        <p class="hero-subtitle">
          云上写代码，翼下记生活。{worksCount} 篇编号作品档案与 {shotsCount} 张影像收藏，
          记录前端、设计与日常思考。
        </p>

        <div class="hero-features">
          <div class="feature-item">
            <span class="feature-number">{worksCount}</span>
            <span class="feature-label">篇作品档案</span>
          </div>
          <div class="feature-divider"></div>
          <div class="feature-item">
            <span class="feature-number">{shotsCount}</span>
            <span class="feature-label">张影像收藏</span>
          </div>
        </div>

        <div class="component-tags">
          {stackTop.map((t, i) => <span class:list={['tag', { active: i === 0 }]}>{t}</span>)}
        </div>
      </div>

      <!-- 右栏展示卡片（参考的 code-card 几何：max-width 520 / radius 12 / 玻璃） -->
      <div class="code-card">
        <div class="code-header">
          <span class="code-dot red"></span>
          <span class="code-dot yellow"></span>
          <span class="code-dot green"></span>
          <span class="code-filename">stack.md</span>
        </div>
        <div class="code-body">
          <span class="cl cl-dim"># cloudwing / stack</span>
          <span class="cl"><span class="sl-key">##</span> <span class="sl-val">工具与技术栈</span></span>
          {stackTop.map((t) => (
            <span class="cl"><span class="sl-key">-</span> <span class="sl-val">{t}</span></span>
          ))}
          <span class="cl"><span class="sl-key">##</span> <span class="sl-val">站点</span></span>
          <span class="cl"><span class="sl-key">-</span> <span class="sl-val">作品档案 {worksCount} 篇</span></span>
          <span class="cl"><span class="sl-key">-</span> <span class="sl-val">影像收藏 {shotsCount} 张</span></span>
          <span class="cl"><span class="sl-key">-</span> <span class="sl-val">更新记录 {changelog.length} 天</span></span>
          <span class="cl"><span class="sl-key">##</span> <span class="sl-val">最近更新</span></span>
          {recentItems.map((it) => (
            <span class="cl"><span class="sl-key">-</span> <span class="sl-val">{it}</span></span>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ ② 最新作品 ═══ -->
    <section class="sec sec-works" id="sec-works" aria-labelledby="h-works">
      <div class="wrap">
        <div class="sec-head">
          <h2 id="h-works">最新作品</h2>
          <a class="sec-more" href="/works/">全部作品 <span aria-hidden="true">→</span></a>
        </div>
        <ul class="work-cards">
          {latestWorks.map((w, i) => (
            <li>
              <a class="wc" href={w.url}>
                {/* 固定宽高比容器：图片未加载也不跳版（防 CLS） */}
                <span class="wc-cover">
                  <img
                    src={w.cover}
                    alt={`${w.no} ${w.title} 的封面`}
                    width="1600"
                    height="900"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </span>
                <span class="wc-body">
                  <span class="wc-no">{w.no}</span>
                  <span class="wc-title">{w.title}</span>
                  {w.summary && <span class="wc-desc">{w.summary}</span>}
                  {w.tags.length > 0 && (
                    <span class="wc-tags">
                      {w.tags.map((t) => (
                        <span class="tag">{t}</span>
                      ))}
                    </span>
                  )}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ═══ ③ 精选影像 ═══ -->
    <section class="sec sec-shots" id="sec-shots" aria-labelledby="h-shots">
      <div class="wrap">
        <div class="sec-head">
          <h2 id="h-shots">精选影像</h2>
          <a class="sec-more" href="/gallery/">完整画廊 <span aria-hidden="true">→</span></a>
        </div>
        <ul class="shot-grid">
          {featuredShots.map((s, i) => (
            <li class="shot">
              <a href="/gallery/" class="shot-link" aria-label={`查看影像：${s.game} ${s.title}`}>
                <span class="shot-frame">
                  <img
                    src={s.image}
                    alt={`${s.game} 场景截图：${s.title}`}
                    width="1600"
                    height="900"
                    loading={i < 3 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </span>
                <span class="shot-meta">
                  <span class="shot-game">{s.game}</span>
                  <span class="shot-title">{s.title}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ═══ ④ 关于预览 ═══ -->
    <section class="sec sec-about" id="sec-about" aria-labelledby="h-about">
      <div class="wrap">
        <div class="sec-head">
          <h2 id="h-about">关于</h2>
        </div>
        <div class="about-card">
          {aboutPreview.map((t) => (
            <p>{t}</p>
          ))}
          <a class="cta cta-ghost" href="/about/">查看完整档案 <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  // Hero 的四个动画（ShinyText / BlurText / GradientText / 逐字入场）
  // 2026-09-18 改版：Hero 已按 reference 复刻为静态版式（badge/两行标题/统计/标签），
  // 原来那四个动画的目标 DOM 已不存在，故不再加载 hero-anim.js。
  // 如需恢复动效，先按新结构重写 scripts/hero-anim.js 再引入。
</script>

<style>
  /* 首页路由：整页沉浸背景由全站视频/粒子层承担 —— 隐藏页脚与进度条 */
  :global(body.home-route .site-footer) { display: none; }
  :global(body.home-route .prog) { display: none; }

  /* 区块统一：上下 padding ≥80px（用户规范） */
  .sec {
    position: relative;
    padding: clamp(80px, 11vh, 132px) 0;
  }
  .sec-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(1.6rem, 3vw, 2.4rem);
  }
  .sec-head h2 {
    font-size: clamp(1.5rem, 3.2vw, 2.1rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .sec-more {
    flex: none;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    color: var(--accent-deep);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s var(--ease), color 0.2s var(--ease);
  }
  .sec-more:hover { border-bottom-color: var(--accent); }

  /* ══════════════════════════════════════════════════════════════
     ① Hero —— 版式照 reference（code_20260918.html）像素级复刻
     几何 / 间距 / 断点全部取参考的实测值：
       hero      max-w 1280 / pad 0 32 / flex 两栏 / gap 80 / min-h 100vh
       content   flex 1 / max-w 560
       title     64px / 700 / 1.05 / -0.03em / margin-bottom 24
       subtitle  18px / rgba(255,255,255,.7) / 1.6 / margin-bottom 32
       features  gap 32 / number 28px·600 / label 14px / divider 1×40
       tags      6px 14px / radius 9999 / gap 8
       card      flex 1 / max-w 520 / radius 12 / 玻璃
     颜色改用站点令牌（强调色为雾蓝 --accent，不用参考的紫/粉/红）
     ══════════════════════════════════════════════════════════════ */
  .hero {
    position: relative;
    min-height: 100vh;
    max-width: 1280px;
    margin: 0 auto;
    /* 参考用 px 定值；站点 --gutter 是 clamp(1.25rem,5vw,3.25rem)，会算出 64px，
       所以这里必须显式写死左右内边距（断点里分别 24/20）。 */
    padding: 0 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 80px;
    overflow: hidden;
    /* 参考的 body line-height 是 normal；站点全局 1.8 会把各块撑高 */
    line-height: normal;
  }
  /* 参考的两处柔光（紫/粉）→ 本站映射为雾蓝/灰绿强调色柔光。
     ⚠️ 浓度必须很低：这层柔光会**直接压在 hero 文字后面**，
     白色大标题容不下亮底 —— 实测 15% 的雾蓝柔光就能把底色抬到 rgb(156,207,228)，
     白字对比度掉到 1.69:1（verify-videobg 抓到）。这里压到 6%/4%，
     既保留参考的柔光氛围，又不破坏文字可读性。 */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 50% at 30% -10%, color-mix(in srgb, var(--accent) 6%, transparent) 0%, transparent 70%),
      radial-gradient(ellipse 50% 40% at 90% 30%, color-mix(in srgb, var(--accent-3) 4%, transparent) 0%, transparent 60%);
    pointer-events: none;
    z-index: 0;
  }
  .hero-content {
    position: relative;
    z-index: 1;
    flex: 1;
    max-width: 560px;
    text-align: left;
  }

  /* ── 徽标胶囊（参考 .hero-badge）── */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--line-2);
    font-size: 13px;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 28px;
    max-width: 100%;
  }
  .hero-badge > span:last-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* 参考的紫点 → 站点雾蓝点 */
  .badge-dot {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }

  /* ── 主标题（参考 .hero-title 64/700/1.05/-0.03em）── */
  .hero-title {
    margin: 0 0 24px;
    font-size: 64px;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #ffffff;
  }
  /* 参考的紫→粉→红渐变 → 站点雾蓝系渐变（同一版式，换品牌色）。
     ⚠️ 必须用"压深过的"雾蓝：白色大标题压在**视频亮帧**上，
     实测亮帧可达 rgb(156,207,228)，此时浅雾蓝(#9FD3E8)对白字只有 1.6:1，
     达不到大字 3:1 的要求；要靠遮罩压到 0.9 才能达标，那等于把背景视频关掉。
     所以这里把两端都压深（≈#6f94a2 / 6.05:1），保留雾蓝色相但保证可读。 */
  .title-gradient {
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--accent) 70%, #000),
      color-mix(in srgb, var(--accent) 88%, #000),
      color-mix(in srgb, var(--accent) 70%, #000)
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }
  .ht-on { font-weight: 400; color: rgba(255, 255, 255, 0.45); }

  /* ── 副标题（参考 18px / .7 白 / 1.6）── */
  .hero-subtitle {
    margin: 0 0 32px;
    font-size: 18px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
  }

  /* ── 两个统计（参考 .hero-features）── */
  .hero-features {
    display: flex;
    align-items: center;
    gap: 32px;
    margin-bottom: 36px;
  }
  .feature-item { display: flex; flex-direction: column; gap: 2px; }
  .feature-number { font-size: 28px; font-weight: 600; color: #ffffff; line-height: 1.25; }
  .feature-label { font-size: 14px; line-height: 1.28; color: rgba(255, 255, 255, 0.5); }
  .feature-divider { width: 1px; height: 40px; background: var(--line-2); flex: none; }

  /* ── 技术标签（参考 .component-tags / .tag）── */
  .component-tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .component-tags .tag {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 13px;
    line-height: 16px;
    letter-spacing: normal;
    color: rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--line-2);
    cursor: default;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }
  .component-tags .tag:hover { color: #ffffff; border-color: rgba(255, 255, 255, 0.2); }
  /* 选中态：浅雾蓝底 + 深色字。
     ⚠️ 不能"雾蓝字压半透明雾蓝底"——两者合成后几乎同色，对比度只有 1:1
     （contrast-audit 抓到）。改用不透明浅雾蓝底 + 近黑字，约 12:1。 */
  .component-tags .tag.active {
    color: #0a0a0f;
    background: color-mix(in srgb, var(--accent) 88%, #ffffff);
    border-color: var(--accent);
  }

  /* ── 右栏展示卡片（参考 .code-card 几何）── */
  .code-card {
    position: relative;
    z-index: 1;
    flex: 1;
    max-width: 520px;
    background: rgba(18, 18, 26, 0.7);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border: 1px solid var(--line-2);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  }
  .code-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line-2);
    background: rgba(255, 255, 255, 0.02);
  }
  .code-dot { width: 12px; height: 12px; border-radius: 50%; }
  .code-dot.red { background: #ff5f56; }
  .code-dot.yellow { background: #ffbd2e; }
  .code-dot.green { background: #27c93f; }
  .code-filename {
    margin-left: 12px;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.5);
    font-family: 'SF Mono', Monaco, Consolas, monospace;
  }
  .code-body {
    padding: 20px;
    font-family: 'SF Mono', Monaco, Consolas, monospace;
    font-size: 13px;
    /* 22.1/13 = 1.7，与参考的代码卡片行距一致 */
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.9);
  }
  .cl { display: block; white-space: pre; }
  .sl-key { color: color-mix(in srgb, var(--accent) 70%, transparent); }
  .sl-val { color: #e8edf2; }
  .cl-dim { color: rgba(255, 255, 255, 0.45); }
  .stack-note {
    margin: 16px 0 0;
    font-size: 12px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.5);
  }
  .stack-note a { color: var(--accent-deep); text-decoration: none; border-bottom: 1px solid transparent; }
  .stack-note a:hover { border-bottom-color: var(--accent); }

  /* ── 断点（照参考逐档）── */
  @media (max-width: 1024px) {
    .hero { gap: 40px; padding: 0 24px; }
    .hero-title { font-size: 48px; }
    .code-card { max-width: 440px; }
  }
  @media (max-width: 768px) {
    .hero {
      flex-direction: column;
      justify-content: center;
      gap: 48px;
      padding: 120px 20px 80px;
      text-align: center;
    }
    .hero-content { text-align: center; max-width: 100%; }
    .hero-title { font-size: 36px; }
    .hero-subtitle { font-size: 16px; }
    .hero-features { justify-content: center; gap: 20px; }
    .component-tags { justify-content: center; }
    .feature-number { font-size: 22px; }
