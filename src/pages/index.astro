---
// 首页 —— 内容橱窗（四层结构）
//   ① Hero：大标题 + 定位语 + 技术标签 + 两个 CTA
//   ② 最新作品：3 张卡片（封面 / 项目名 / 一句话说明 / 技术标签）
//   ③ 精选影像：6 张网格 + 悬停预览
//   ④ 关于预览：2–3 句介绍 + 完整档案入口
// 背景：全站统一的暗色视频背景（Base.astro 渲染）+ 既有导航栏。
// 说明：原来的 01/02/03 编号入口卡片已按要求删除 —— 首页直接展示内容，不再只做跳转目录。
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { SITE, ACCENTS, ACCENT_DEFAULT } from '../site';

// —— ② 最新作品：取作品库最新 3 篇（与 /works/ 联动） ——
const worksAll = await getCollection('works');
const latestWorks = worksAll
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3)
  .map((w) => ({
    no: 'W-' + String(w.data.order ?? 0).padStart(3, '0'),
    title: w.data.title ?? '未命名档案',
    summary: w.data.summary ?? '',
    tags: (w.data.tags ?? []).slice(0, 3),
    tools: (w.data.tools ?? []).slice(0, 3),
    cover: w.data.cover ?? '/covers/blank.svg',
    url: `/works/${w.id}/`,
  }));

// —— ③ 精选影像：按日期挑 6 张（优先 16:9，网格更整齐） ——
const allShots = await getCollection('shots');
const featuredShots = allShots
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .filter((s) => s.data.image)
  .slice(0, 6)
  .map((s) => ({
    image: s.data.image,
    title: s.data.title ?? '',
    game: s.data.game ?? '',
    aspect: s.data.aspect ?? '16:9',
  }));

// 关于预览的简介（首页只放 2–3 句，细节留在 /about/）
const aboutPreview = [
  `${SITE.author} —— 计算机科学与技术（本科在读），方向偏 Java 后端与质量保障：能写 Spring Boot 接口，也用测试的眼光对待每一个缺陷。`,
  '这个站把学习轨迹、代码与产出按编号留存，让每一次练习都可追溯。',
];

/* ══════════════════════════════════════════════════════════════
   Hero 数据 —— 版式照 reference（code_20260918.html）复刻，
   内容全部来自站点真实数据（与 ②③④、/works/、/gallery/ 联动）
   ══════════════════════════════════════════════════════════════ */

// 徽标：取最近一条更新记录（changelog）
const changelog = (await getCollection('changelog')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);
const latestKind = changelog[0]?.data.items?.[0]?.kind ?? '更新';
const latestTitle = changelog[0]?.data.items?.[0]?.title ?? '内容持续更新中';

// 两个统计数字（参考是「170+ components / Free forever」）：用站点真实条目数
const worksCount = worksAll.length;
const shotsCount = allShots.length;

// 技术栈标签：由作品 frontmatter 的 tools 现算，取出现最多的 6 个
const toolCount = new Map<string, number>();
for (const w of worksAll) for (const t of w.data.tools ?? []) if (t) toolCount.set(t, (toolCount.get(t) ?? 0) + 1);
const topTools = [...toolCount.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'en'))
  .slice(0, 6)
  .map(([t]) => t);
const stackTop = topTools.length ? topTools : ['Java', 'Spring Boot', 'MySQL', 'Git'];

/* 展示卡片里的代码段（照参考站的 code-card 形态）。
   写的是本站真实的一段：背景视频层怎么用"强调色 + 玻璃材质"落地，纯展示、不参与运行。
   高亮类名沿用参考（keyword / string / function / component / attr / number / punc / comment），
   颜色换成站点令牌，随色卡一起补间。
   ★代码段内一律用英文★（注释也不例外）：混中文会显得像文案而不是代码。
   ★最长行请控制在 47 字符以内★：手机端字号按最长行反解（见 .code-body 注释）。
   ★两条会随色卡变色的行★：带 data-accent-line 的那行会被脚本改写 ——
     .ln-var 换成当前强调色（对应参考里带色块的那个入参），
     .ln-num 换成当前的遮罩数值（照参考"每个数值随预设变"的做法）。 */
const codeSample = [
  '<span class="code-comment">/* backdrop video layer */</span>',
  '<span class="code-keyword">export default function</span> <span class="code-function">VideoBackground</span>() {',
  '  <span class="code-keyword">return</span> (',
  '    &lt;<span class="code-component">div</span> <span class="code-attr">class</span><span class="code-punc">=</span><span class="code-string">"video-bg"</span>&gt;',
  '      &lt;<span class="code-component">video</span> <span class="code-attr">src</span><span class="code-punc">=</span><span class="code-punc">{</span><span class="code-fn">VIDEO_BG</span><span class="code-punc">.</span><span class="code-attr">src</span><span class="code-punc">}</span>',
  '        <span class="code-attr">color</span><span class="code-punc">=</span><span class="ln-val"><span class="ln-swatch"></span><span class="ln-var">#9FD3E8</span></span>',
  '        <span class="code-attr">opacity</span><span class="code-punc">=</span><span class="code-punc">{</span><span class="code-number ln-num">0.50</span><span class="code-punc">}</span> <span class="code-attr">hue</span><span class="code-punc">=</span><span class="code-punc">{</span><span class="code-number ln-num">0</span><span class="code-punc">}</span> <span class="code-punc">/&gt;</span>',
  '    &lt;/<span class="code-component">div</span>&gt;',
  '  );',
  '}',
  '',
  '<span class="code-comment">/* glass: accent as highlight */</span>',
  '<span class="code-component">.video-bg</span> <span class="code-punc">{</span>',
  '  <span class="code-attr">position</span><span class="code-punc">:</span> <span class="code-keyword">fixed</span><span class="code-punc">;</span> <span class="code-attr">z-index</span><span class="code-punc">:</span> <span class="code-number">-4</span><span class="code-punc">;</span>',
  '  <span class="code-attr">backdrop-filter</span><span class="code-punc">:</span> <span class="code-fn">var</span><span class="code-punc">(</span><span class="code-attr">--glass-blur</span><span class="code-punc">);</span>',
  '  <span class="code-attr">color</span><span class="code-punc">:</span> <span class="code-fn">var</span><span class="code-punc">(</span><span class="code-attr">--accent</span><span class="code-punc">);</span>',
  '<span class="code-punc">}</span>',
].join('\n');
---

<Base
  title="首页"
  description="CloudWing 云翼的个人档案站：Java 后端与质量保障方向。这里收录编号作品档案与影像收藏，打开即见最新产出。"
  bodyClass="home-route"
>
  <div class="home">
    <!-- ═══ ① Hero ═══
         版式照 reference（code_20260918.html）像素级复刻：
         左栏 badge → 两行大标题（第二行渐变）→ 副标题 → 两个统计 → 技术标签
         右栏展示卡片（参考位是代码卡片，这里用站点真实技术栈填充同款卡片）
         几何/间距/断点全部取参考实测值；强调色用站点雾蓝（--accent）。 -->
    <section class="hero" id="top">
      <div class="hero-content">
        <div class="hero-badge">
          <span class="badge-dot"></span>
          <span>{latestKind} · {latestTitle}</span>
        </div>

        <h1 class="hero-title">
          <span class="ht-l1">Code on clouds, life on wings</span>
          <span class="ht-l2">Hello this is CloudWing</span>
        </h1>

        <p class="hero-subtitle">记录我的学习，折腾和胡思乱想</p>

        <div class="hero-features">
          <div class="feature-item">
            <span class="feature-number">{worksCount}</span>
            <span class="feature-label">篇作品档案</span>
          </div>
          <div class="feature-divider"></div>
          <div class="feature-item">
            <span class="feature-number">{shotsCount}</span>
            <span class="feature-label">张影像收藏</span>
          </div>
        </div>

        <div class="component-tags">
          {stackTop.map((t, i) => <span class:list={['tag', { active: i === 0 }]}>{t}</span>)}
        </div>
      </div>

      <!-- 右栏展示卡片（参考的 code-card 几何：max-width 520 / radius 12 / 玻璃）。
           内容是一段**关键连续代码**：展示本站设计令牌（雾蓝强调色 + 玻璃材质）
           实际是怎么落到背景视频层上的 —— 配色全部取站点令牌，不用参考的紫粉红。 -->
      <div class="code-card">
        <div class="code-header">
          <span class="code-dot red"></span>
          <span class="code-dot yellow"></span>
          <span class="code-dot green"></span>
          <span class="code-filename">@components/VideoBackground</span>
        </div>
        <pre class="code-body"><code set:html={codeSample}></code></pre>

        {/* 色卡：照参考站卡片底部的 Presets 一排按钮。
            点一下同时换「强调色 + 整页色膜 + 代码语法配色」，中间色缓慢过渡。
            由 scripts/hero-theme.js 接管（document 委托，软导航后仍有效）。 */}
        <div class="code-footer" role="group" aria-label="强调色预设">
          <div class="code-presets">
            {ACCENTS.map((a) => (
              <button
                type="button"
                class="code-preset"
                data-accent-preset={a.key}
                aria-pressed={a.key === ACCENT_DEFAULT ? 'true' : 'false'}
                style={`--swatch:${a.base}`}
              >
                <span class="cp-dot" aria-hidden="true"></span>
                {a.label}
              </button>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ ② 最新作品 ═══ -->
    <section class="sec sec-works" id="sec-works" aria-labelledby="h-works">
      <div class="wrap">
        <div class="sec-head">
          <h2 id="h-works">最新作品</h2>
          <a class="sec-more" href="/works/">全部作品 <span aria-hidden="true">→</span></a>
        </div>
        <ul class="work-cards">
          {latestWorks.map((w, i) => (
            <li>
              <a class="wc" href={w.url}>
                {/* 固定宽高比容器：图片未加载也不跳版（防 CLS） */}
                <span class="wc-cover">
                  <img
                    src={w.cover}
                    alt={`${w.no} ${w.title} 的封面`}
                    width="1600"
                    height="900"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </span>
                <span class="wc-body">
                  <span class="wc-no">{w.no}</span>
                  <span class="wc-title">{w.title}</span>
                  {w.summary && <span class="wc-desc">{w.summary}</span>}
                  {w.tags.length > 0 && (
                    <span class="wc-tags">
                      {w.tags.map((t) => (
                        <span class="tag">{t}</span>
                      ))}
                    </span>
                  )}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ═══ ③ 精选影像 ═══ -->
    <section class="sec sec-shots" id="sec-shots" aria-labelledby="h-shots">
      <div class="wrap">
        <div class="sec-head">
          <h2 id="h-shots">精选影像</h2>
          <a class="sec-more" href="/gallery/">完整画廊 <span aria-hidden="true">→</span></a>
        </div>
        <ul class="shot-grid">
          {featuredShots.map((s, i) => (
            <li class="shot">
              <a href="/gallery/" class="shot-link" aria-label={`查看影像：${s.game} ${s.title}`}>
                <span class="shot-frame">
                  <img
                    src={s.image}
                    alt={`${s.game} 场景截图：${s.title}`}
                    width="1600"
                    height="900"
                    loading={i < 3 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </span>
                <span class="shot-meta">
                  <span class="shot-game">{s.game}</span>
                  <span class="shot-title">{s.title}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ═══ ④ 关于预览 ═══ -->
    <section class="sec sec-about" id="sec-about" aria-labelledby="h-about">
      <div class="wrap">
        <div class="sec-head">
          <h2 id="h-about">关于</h2>
        </div>
        <div class="about-card">
          {aboutPreview.map((t) => (
            <p>{t}</p>
          ))}
          <a class="cta cta-ghost" href="/about/">查看完整档案 <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  </div>
</Base>

{/* 色卡数据以 JSON 内联给 scripts/hero-theme.js（避免把配色表再抄一份到 JS 里） */}
<script type="application/json" data-accent-presets set:html={JSON.stringify(ACCENTS)} />

<script>
  // 色卡切换：强调色 + 整页色膜 + 代码高亮的补间，见 scripts/hero-theme.js
  import { initHeroTheme } from '../scripts/hero-theme.js';
  initHeroTheme();
  // 软导航会重建 DOM（按钮是新的），但脚本不会重跑 —— 这里补一次首屏同步
  document.addEventListener('astro:page-load', initHeroTheme);
</script>

<script>
  // Hero 的四个动画（ShinyText / BlurText / GradientText / 逐字入场）
  // 2026-09-18 改版：Hero 已按 reference 复刻为静态版式（badge/两行标题/统计/标签），
  // 原来那四个动画的目标 DOM 已不存在，故不再加载 hero-anim.js。
  // 如需恢复动效，先按新结构重写 scripts/hero-anim.js 再引入。
</script>

<style>
  /* 首页路由：整页沉浸背景由全站视频/粒子层承担 —— 隐藏页脚与进度条 */
  :global(body.home-route .site-footer) { display: none; }
  :global(body.home-route .prog) { display: none; }

  /* 区块统一：上下 padding ≥80px（用户规范） */
  .sec {
    position: relative;
    padding: clamp(80px, 11vh, 132px) 0;
  }
  .sec-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(1.6rem, 3vw, 2.4rem);
  }
  .sec-head h2 {
    font-size: clamp(1.5rem, 3.2vw, 2.1rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .sec-more {
    flex: none;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    color: var(--accent-deep);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s var(--ease), color 0.2s var(--ease);
  }
  .sec-more:hover { border-bottom-color: var(--accent); }

  /* ══════════════════════════════════════════════════════════════
     ① Hero —— 版式照 reference（code_20260918.html）像素级复刻
     几何 / 间距 / 断点全部取参考的实测值：
       hero      max-w 1280 / pad 0 32 / flex 两栏 / gap 80 / min-h 100vh
       content   flex 1 / max-w 560
       title     64px / 700 / 1.05 / -0.03em / margin-bottom 24
       subtitle  18px / rgba(255,255,255,.7) / 1.6 / margin-bottom 32
       features  gap 32 / number 28px·600 / label 14px / divider 1×40
       tags      6px 14px / radius 9999 / gap 8
       card      flex 1 / max-w 520 / radius 12 / 玻璃
     颜色改用站点令牌（强调色为雾蓝 --accent，不用参考的紫/粉/红）
     ══════════════════════════════════════════════════════════════ */
  .hero {
    position: relative;
    min-height: 100vh;
    /* 与全局主内容容器对齐（--w-max 1300 + --gutter 左右内边距），
       否则 hero 会比下方区块窄一圈，看着"上窄下宽"（实测 1440：hero 左缘 133 vs 区块 53）。
       ⚠️ 只改容器本身：内部两栏的 max-width（左栏 700 / 卡片 400）只服务于版式比例，
       容器一变它们就跟着失效，见下面 .hero-content / .code-card 的注释。 */
    max-width: var(--w-max);
    margin: 0 auto;
    /* 左右内边距改成与全局 .wrap 同一套 --gutter，这样 hero 与下方区块的
       "内容左缘/右缘"精确重合（实测改前差 80px）。
       顶部 96px 是"最小呼吸位"：内容比视口矮时居中即可，内容更高时 min-height 失效、
       就靠这 96px 保证徽标不被固定导航栏压住。
       断点里（≤1024 24px、≤768 20px）仍按原值收紧，移动端不变。 */
    padding: 96px var(--gutter) 48px;
    display: flex;
    /* ★2026-09-18 三轮：用户要求"整块（大标题＋代码卡片）挪到屏幕正中心"★
       行的交叉轴 = 竖直方向，所以这两条决定竖向位置。取值有讲究（试过三版）：
       1. `align-items: center` **不行** —— flex 会把这一行的行盒高度收缩成内容高度，
          "居中"就退化成没有效果（实测卡片仍停在 294，正是偏上的样子）。
       2. `align-items: flex-start` + `align-content: center` + `flex-wrap: wrap`
          **才是有效解**：行盒被单独居中放在 hero 的整个内容盒里，
          而 `padding-top: 96px` 保证了内容盒高度 ≥ 视口高 − 144，
          于是"居中"永远真的在中间，视口再高也不会跑偏。
       3. 卡片自身还要与标题顶齐平，那是**视觉**偏移，由 hero-theme.js 写
          `--card-shift` + 下面的 `position: relative; top` 完成 ——
          ⚠️ 千万不要用 margin-top 去挪：外边距会参与行盒高度计算，
          把行盒撑高后"居中"结果又被推下去，形成越调越偏的正反馈（实测漂了 5 轮）。
       ⚠️ 卡片高度 > 可视高时 flex 的 safe-center 会自动回落成 flex-start，不会切顶。
       ⚠️ ≤768px 是列向堆叠，那边显式写了 `align-items: stretch` 与
       `justify-content: center`（移动端不动）。 */
    align-items: flex-start;
    align-content: center;
    flex-wrap: wrap;
    /* 横向对齐：用 flex-start，让左栏左缘与下方区块的"内容左缘"精确重合
       （两者同宽同内边距：max-width 都是 --w-max、左右都是 --gutter）。
       这里不能用 center —— 那会把整块往里推，看上去比下方区块窄一圈。 */
    justify-content: flex-start;
    /* 两栏间隔 = 96px（用户要求"把大标题与右侧代码卡片的间隔也加大"；原值 80）。
       布局是"左栏 + 间隔 + 卡片 = 1196（容器净宽）"：
         左栏 700 + 96 + 卡片 400 = 1196，正好铺满，卡片右缘与下方区块的右缘重合。
       左栏 645→700 与卡片 440→400 是为"大标题加大字号"腾的空间：
       标题第一行 28 字符在 52px 下实宽 686px，645 的栏塞不下（会折行）。
       ⚠️ 1025–1195px 视口下这三条一起失效（净宽不够），左栏会被挤到 ~534、
       卡片压到 ~400 的下限 —— 实测不溢出，只是标题改折行，属预期。
       ≤1024 的 72、≤768 的 40 两个断点值不动，移动端不受影响。 */
    gap: 96px;
    overflow: hidden;
    /* 参考的 body line-height 是 normal；站点全局 1.8 会把各块撑高 */
    line-height: normal;
  }
  /* ★★ 这里曾经有一层 `.hero::before` 强调色柔光 —— 已删除（2026-09-18 四轮修订）★★
     它原本是参考页两处柔光（紫/粉）的雾蓝/灰绿映射，浓度只有 6% / 4%，
     看上去"几乎看不见"，但**它是在主容器盒里画的**：
       · `position: absolute; inset: 0` 的包含块是 `.hero`（1300px），
       · `.hero` 又带 `overflow: hidden`，
     于是两处 radial-gradient 的尾巴被**沿着容器左右边缘切断**，
     在背景上留下两条竖着的明暗分界线（正是用户报的"导航栏左右两侧 + 代码卡片右侧"）。

     实测（1440×900，`scripts/diag-edges.mjs`，跨容器边缘取 4px 均值的 ΔL）：
       glow 在：  导航条带左缘 +0.00071 ｜ 卡片行左缘 -0.00065 ｜ 卡片行右缘 -0.00073
       glow 去掉：导航条带左缘 -0.00007 ｜ 卡片行左缘 +0.00004 ｜ 卡片行右缘 -0.00018
     （-0.00018 那一档是视频**自身**的横向亮度梯度，各带都在同一量级，属本底噪声。）

     ⚠️ 结论与上一版 `.hero::after` 完全同源，可以当规则记：
     **任何"只铺在容器里"的装饰层，都会在容器边缘留下一条边界线。**
     用户要的是"背景像子页面一样干净"（子页面 = 全屏视频 + 色调层 + 网格 + 粒子，没有额外薄膜），
     所以这里直接**删掉**，而不是改铺到全屏 —— 铺到全屏又会变成"盖在内容上的一层膜"，
     前两轮已经因为这件事返工两次。
     背景的观感（亮度/浓度）只允许在**视频自己的图层**上调，见 src/site.ts 的 VIDEO_BG。 */
  /* ★★ 这里曾经有一层 `.hero::after` 压暗膜 —— 已删除（2026-09-18 三轮修订）★★
     它原是为了压住背景视频中段的亮带、把字幕对比度从 3.66 拉回 4.5。
     但它在页面上留下了肉眼可见的痕迹（用户连续两次指出"标题后方一层黑色矩形"、
     "首页两边有瑕疵"），试了两种写法都不成立：
       · `position: absolute; inset: 0` → 相对 `.hero` 的盒子（1300px 主容器 + overflow:hidden），
         只在容器范围内压暗 → 左右各留一条未压暗的区域，四边硬边；
       · `position: fixed` + 纵向渐变 → 逐列采样证明"容器边缘两侧差值只有 1~3/255"，
         压暗本身没有边界，但**它仍然是一层覆盖整屏的深色薄膜**，
         在暗背景视频上会整体压暗画面（左右两侧尤其明显），用户照样看成瑕疵。
     **正解：不在页面上叠任何东西，改去调视频自己的图层。**
     三轮当时是去调 `VIDEO_BG.scrimMid`（视频之上的全屏遮罩）；**三轮后期连那层遮罩也删了**
     （用户第三次指出"在导航栏和主容器两侧能看见边缘"），改成
     `VIDEO_BG.dim` 的 `filter: brightness()` + 纯深色兜底底 —— 见 `VideoBackground.astro` 的注释。
     教训：**"压暗"要压在被压对象自己的图层里，不要在内容层上再盖一层。** */

  .hero-content {
    position: relative;
    z-index: 1;
    /* flex-basis:0 + max-width → 两栏按比例分配剩余空间。
       ⚠️ 必须 min-width:0：flex 项默认 min-width:auto 会拿 min-content 当不可缩的底线，
       标题 nowrap 时 min-content ≈ 686px，于是左栏永远占满、把卡片挤扁（踩过）。 */
    flex: 1 1 0;
    min-width: 0;
    /* 左栏弹性上限 645 → **700**（2026-09-18 三轮，配合"大标题加大字号"）：
       标题第一行 28 字符在 52px 下实宽 686px，645 的栏塞不下（会折成 3 行）。
       700 是"能放下 52px 那一行"的最小值（686 + 14 余量）。
       ⚠️ 三块是联动的：左栏 700 + gap 96 + 卡片 400 = 1196 = 容器净宽，
       改任何一个都要同时改另两个（否则卡片右缘与下方区块右缘对不齐）。 */
    max-width: 700px;
    text-align: left;
  }

  /* ── 徽标胶囊（参考 .hero-badge）── */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--line-2);
    font-size: 13px;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 28px;
    max-width: 100%;
  }
  .hero-badge > span:last-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* 参考的紫点 → 站点雾蓝点 */
  .badge-dot {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }

  /* ── 主标题 ──
     字号照"第一行必须放得下"反解，上限 48 → **52px**（2026-09-18 三轮，用户要求"加大一点字号"）。
     ★为什么不是参考站的 66px★：我们的标题文案比参考长得多 —— 第一行 28 字符，
     实测每字号实宽 13.19px，66px 需要 870px，而左栏只有 700px。
     想再大就得同时牺牲"严格两行"或"卡片宽度"，先说一声。 */
  .hero-title {
    margin: 0 0 24px;
    /* 单一反解式（只改了两个数：上限 48 → 52、分母 13.19 → 13.7）。
       分母 13.7 不是拍的：要求"1440 下左栏 700 里放得下 52px 那一行"，
       即 52 = (1440 − k) / 13.7 且 52 × 13.19 = 686 ≤ 700，解得 k ≈ 726，取 730。
       30px 下限保证窄屏也读得清 —— 此时左栏放不下一行，靠自动换行兜住，不会溢出。
       实测：1440/1920 → 52px（第一行 686，左栏 700）；1200 → 稳定 34.3px，都放得下。 */
    font-size: max(30px, min(52px, calc((100vw - 730px) / 13.7)));
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #ffffff;
  }
  .ht-l1,
  .ht-l2 { display: block; }
  /* 只在"真的能放下"的宽度上锁两行：左栏拿到满 700px 时（≈1300px 视口起；
     留了滚动条的余量），第一行在 52px 上限下放得下（实宽 686px）。
     更窄时左栏被压缩、字号也随 vw 变小，第一行放开换行 —— 否则 nowrap 会顶出容器
     （实测 1152px 下 633px 的文字塞进 498px 的栏）。
     ⚠️ 这道 1200 的门槛与字号公式一起看：1200–1300 区间字号已降到 ≤34px
     （第一行 ≤455px），即使左栏只有 ~534px 也放得下，不会溢出。 */
  @media (min-width: 1200px) {
    .ht-l1,
    .ht-l2 { white-space: nowrap; }
  }
  /* 第一行纯白（继承 .hero-title），第二行走雾蓝渐变强调色。
     渐变必须用"压深过的"雾蓝：白色/亮色大字压在视频亮帧上，
     浅雾蓝(#9FD3E8)对白字只有 1.6:1；压深后 ≈#6f94a2（对比 6:1）。 */
  .ht-l2 {
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--accent) 70%, #000),
      color-mix(in srgb, var(--accent) 88%, #000),
      color-mix(in srgb, var(--accent) 70%, #000)
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }

  /* ── 副标题（参考 18px / .7 白 / 1.6）──
     ⚠️ 不透明度 .7 → .92（2026-09-18 三轮）：Hero 竖直居中后副标题正压着背景视频的
     亮带，18px 正文要求 4.5:1，.7 白在亮帧上只剩 3.66。**提亮文字比继续压暗视频划算**
     （压暗会把整片画面洗掉，而且上次那层"压暗膜"在页面上留下了可见痕迹）。
     .92 而不是 1：保留一点层次感，同时留出对比度余量。
     同时背景侧也一起处理了：兜底底改成纯深色 + `VIDEO_BG.dim`（0.85）的 brightness 压暗，
     不再依赖任何"遮罩层"（那层已在三轮后期删除，见上方 .hero::after 的注释）。 */
  .hero-subtitle {
    margin: 0 0 32px;
    font-size: 18px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.92);
  }

  /* ── 两个统计（参考 .hero-features）── */
  /* ── 两个统计 ──
     字号按参考的比例给（参考：标题 66px 时数字 26px、说明 13px，
     即 ≈ 标题的 0.394 / 0.197 倍）。标题字号是随视口算的，
     所以这里在 ≥660px 用 vw 跟随，窄屏回落。 */
  .hero-features {
    display: flex;
    align-items: center;
    gap: 32px;
    margin-bottom: 36px;
  }
  .feature-item { display: flex; flex-direction: column; gap: 2px; }
  .feature-number {
    font-size: clamp(22px, 1.8vw, 26px);
    font-weight: 600;
    color: #ffffff;
    line-height: 1.25;
  }
  .feature-label { font-size: clamp(13px, 0.9vw, 13.5px); line-height: 1.28; color: rgba(255, 255, 255, 0.5); }
  .feature-divider { width: 1px; height: 40px; background: var(--line-2); flex: none; }

  /* ── 技术标签（参考 .component-tags / .tag）── */
  .component-tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .component-tags .tag {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 13px;
    line-height: 16px;
    letter-spacing: normal;
    color: rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--line-2);
    cursor: default;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }
  .component-tags .tag:hover { color: #ffffff; border-color: rgba(255, 255, 255, 0.2); }
  /* 选中态：浅雾蓝底 + 深色字。
     ⚠️ 不能"雾蓝字压半透明雾蓝底"——两者合成后几乎同色，对比度只有 1:1
     （contrast-audit 抓到）。改用不透明浅雾蓝底 + 近黑字，约 12:1。 */
  .component-tags .tag.active {
    color: #0a0a0f;
    background: color-mix(in srgb, var(--accent) 88%, #ffffff);
    border-color: var(--accent);
  }

  /* ── 右栏展示卡片（参考 .code-card 几何）── */
  .code-card {
    position: relative;
    z-index: 1;
    /* 必须 flex:1 1 0（不是 0 1 auto）：auto 时卡片停在自身内容宽（实测 388），
       撑不到上限。min-width:0 见左栏注释。 */
    flex: 1 1 0;
    min-width: 0;
    /* 卡片上限 440 → **400**（2026-09-18 三轮）：把省下的 40px 让给左栏，
       好让大标题放到 52px。三块联动：左栏 700 + gap 96 + 卡片 400 = 1196（容器净宽），
       所以卡片右缘仍与下方区块的右缘精确重合（实测右侧余量 0）。
       代码行长 47 字符 × 7.1475px ≈ 336px，400 的卡片（正文左右内边距 48）放得下。 */
    max-width: 400px;
    /* "大标题与卡片顶部齐平"（视觉对齐）：hero 现在是竖向居中（见 .hero 的注释），
       卡片会与左栏顶部对齐后再整体居中；这里再给一个**不参与布局**的视觉位移，
       让卡片顶与标题顶对齐。
       ⚠️ 必须用 position: relative + top（或 --card-shift=0 时不生效），
       **不能用 margin-top**：外边距会撑高 flex 行盒、把居中结果推下去，越调越偏（踩过）。
       位移量由 scripts/hero-theme.js 实测写入 --card-shift（写死会随断点/字号失准）。 */
    position: relative;
    top: var(--card-shift, 0px);
    margin-top: 0;
    background: rgba(18, 18, 26, 0.7);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border: 1px solid var(--line-2);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  }
  .code-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line-2);
    background: rgba(255, 255, 255, 0.02);
  }
  .code-dot { width: 12px; height: 12px; border-radius: 50%; }
  .code-dot.red { background: #ff5f56; }
  .code-dot.yellow { background: #ffbd2e; }
  .code-dot.green { background: #27c93f; }
  .code-filename {
    margin-left: 12px;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.5);
    font-family: 'SF Mono', Monaco, Consolas, monospace;
  }
  .code-body {
    margin: 0;
    padding: 20px 22px 22px 26px; /* 左侧多留一点：等宽字形起始位偏左，20px 时首列会被切 */
    font-family: 'SF Mono', Monaco, Consolas, 'Liberation Mono', monospace;
    font-size: 13px;
    /* 行高走令牌（见 :root 的 --code-lh 注释） */
    line-height: var(--code-lh, 1.55);
    color: var(--brand-cloud); /* 代码正文：品牌纸白 */
    white-space: pre; /* 保留缩进与单行不折行（照参考） */
    overflow-x: auto;
    tab-size: 2;
    /* ⚠️ 必须显式左对齐：hero 在移动端是 text-align:center，会被继承过来，
       代码段落一旦居中，"缩进"在视觉上就消失了（像没缩进一样）。 */
    text-align: left;
  }
  .code-body code { font-family: inherit; }

  /* ── 首页专属的"可换色"令牌 ──
     写在首页而不是 global.css：只有首页有色卡，其它页没必要多背这几个变量。
     :global(:root) 是必须的 —— 普通 :root 会被 Astro 作用域成 ...:where(...)，
     那样 scripts/hero-theme.js 就没法通过 documentElement 改它了。
     默认值全部由当前强调色（--accent）派生，所以默认态与改版前一致。 */
  :global(:root) {
    /* 色膜：默认浓度 0 = 完全没有颜色滤镜（默认态画面与之前一模一样） */
    --tint-c: #9fd3e8;
    --tint-a: 0;
    /* 代码行高：卡片缩到 440 后代码行数变多，用参考的 1.7 会让卡片高到把 hero 顶出视口，
       收到 1.55 压回来（参考卡片更宽、代码更短，所以它用 1.7 也不会超）。
       这个值也决定了"卡片能否与标题齐平后仍留在视口内"，改动前先量 1440 下的卡片高。 */
    --code-lh: 1.55;
    /* 强调色的 RGB 分量：给 rgba(var(--accent-rgb), a) 用。
       色卡切换时由 hero-theme.js 一并补间，所以半透明底也会跟着平滑变色。 */
    --accent-rgb: 159, 211, 232;
    /* 代码高亮（由强调色派生，切换色卡时补间这几个） */
    --code-key: color-mix(in srgb, var(--accent) 82%, #ffffff);
    --code-attr: color-mix(in srgb, var(--accent) 88%, #ffffff);
    --code-str: color-mix(in srgb, var(--accent) 58%, #7fd6a8);
    --code-fn: color-mix(in srgb, var(--accent) 72%, #8fb4f0);
    --code-comp: color-mix(in srgb, var(--accent) 42%, #ffffff);
    --code-num: color-mix(in srgb, var(--accent) 62%, #e8d98a);
    --code-dim: #9aa7b6;
  }

  /* ── 语法高亮：全部由强调色派生（--code-*），色卡切换时补间这几个变量，
       代码段就会跟着一起变色（含中间色过渡）。
       类名照参考站：keyword / string / function / component / attr / number / punc / comment。
       ⚠️ 必须 :global()：代码是 set:html 注入的，元素上没有 Astro 作用域属性。 */
  .code-body :global(.code-keyword) { color: var(--code-key); }
  .code-body :global(.code-attr) { color: var(--code-attr); }
  .code-body :global(.code-string) { color: var(--code-str); }
  .code-body :global(.code-fn),
  .code-body :global(.code-function) { color: var(--code-fn); }
  .code-body :global(.code-component) { color: var(--code-comp); font-weight: 500; }
  .code-body :global(.code-number) { color: var(--code-num); }
  .code-body :global(.code-punc) { color: rgba(255, 255, 255, 0.62); }
  .code-body :global(.code-comment) { color: var(--code-dim); font-style: italic; }
  /* 会随色卡变色的那个"色值胶囊"（照参考的 swatch + 值）：底色与色块都随之补间 */
  .code-body :global(.ln-val) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 1px 6px;
    border-radius: 6px;
    background: rgba(var(--accent-rgb), 0.16);
  }
  .code-body :global(.ln-swatch) {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    flex: none;
    background: var(--accent);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }
  .code-body :global(.ln-var) { color: var(--accent-deep); }

  /* ── 色卡（照参考站卡片底部的 Presets）── */
  .code-footer {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 20px 14px 26px;
  }
  .code-presets { display: flex; flex-wrap: wrap; gap: 6px; }
  .code-preset {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 11px;
    border-radius: 9999px;
    border: 1px solid var(--line-1);
    background: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.55);
    font-size: 12px;
    line-height: 1.4;
    letter-spacing: 0.01em;
    cursor: pointer;
    transition: color 0.25s var(--ease), border-color 0.25s var(--ease), background 0.25s var(--ease);
  }
  .code-preset:hover { color: rgba(255, 255, 255, 0.85); background: rgba(255, 255, 255, 0.08); }
  .code-preset:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .cp-dot {
    width: 9px;
    height: 9px;
    border-radius: 9999px;
    flex: none;
    background: var(--swatch);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.18) inset;
  }
  /* 选中态：**圆点**用强调色、文字保持高对比（雾蓝底上再写雾蓝字只有 1:1，
     contrast-audit 抓到了）。所以强调色只落在圆点与边框上，文字用纸白。
     底色用 rgba(var(--accent-rgb), …) 而不是 color-mix(…, transparent)：
     后者会被对比度审计当成"不透明的强调色"，算出假的 1.5:1。 */
  .code-preset[aria-pressed='true'] {
    color: var(--brand-cloud);
    border-color: rgba(var(--accent-rgb), 0.55);
    background: rgba(var(--accent-rgb), 0.16);
  }
  .code-preset[aria-pressed='true'] .cp-dot {
    background: var(--accent);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.25) inset, 0 0 10px var(--accent);
  }
  .stack-note {
    margin: 16px 0 0;
    font-size: 12px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.5);
  }
  .stack-note a { color: var(--accent-deep); text-decoration: none; border-bottom: 1px solid transparent; }
  .stack-note a:hover { border-bottom-color: var(--accent); }

  /* ── 断点（照参考逐档）──
     ⚠️ 这里**不要**再写死 .hero-title 的字号：标题字号由基础规则的 calc(...)
     按"最长行必须放得下"统一控制，写死会盖掉它，把两行 nowrap 的文字顶出容器
     （踩过：390px 下需要 634px、容器只有 350px）。只有 <660px 那档例外（见下）。 */
  @media (max-width: 1024px) {
