--- 
// 首页 —— hero 大字标题 + 打字机标语 + 下方三个板块（可滚动）
// 背景：全站统一 React Bits <Particles /> 粒子背景（Base.astro 渲染，fixed 全页）
import Base from '../layouts/Base.astro';
import TextType from '../components/TextType.astro';
import HomeStrokeTitle from '../components/HomeStrokeTitle.jsx';
import HomeWorksCardSwap from '../components/HomeWorksCardSwap.jsx';
import HomeGalleryAccordion from '../components/HomeGalleryAccordion.jsx';
import { getCollection } from 'astro:content';
import { SITE } from '../site';

const words = SITE.latin.split(/\s+/).filter(Boolean);
const lastWord = words.pop() ?? 'CloudWing';

// 01 板块右下角堆叠卡：取作品库最新 3 篇（与 /works/ 联动）
const latestWorks = (await getCollection('works'))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3)
  .map((w) => ({
    no: 'W-' + String(w.data.order ?? 0).padStart(3, '0'),
    title: w.data.title ?? '未命名档案',
    tags: w.data.tags ?? [],
    cover: w.data.cover ?? '/covers/blank.svg',
    url: `/works/${w.id}/`,
  }));
---
<Base title="首页" bodyClass="home-route">
  <div class="home">
    <header class="hero" id="top">
      <div class="wrap">
        <h1 class="display display-tilt" data-ent style="--ad:.12s">
          {/* 主标题只保留**一行核心信息**（用户要求）：
              "HELLO THIS IS CLOUDWING" 一行说完，字号由 --display-size 控制在 48–72px。
              仍走 ReactBits <StrokeText />（先描边画出再填满），外层 h1 是 3D 倾斜宿主。 */}
          <HomeStrokeTitle client:load lines={[`HELLO THIS IS ${lastWord}`]} />
        </h1>
        <TextType
          className="typed-hero"
          text={['代码与图集 · 学习档案', '编号档案 · 过程可追溯', 'CloudWing / 云翼']}
          speed={64}
          pause={1500}
        />
      </div>
    </header>

    <!-- 下方三个板块：进入视口时逐块滚动显现（脚本见 ui.js 的 scrollFade；
         这里不用 data-ent —— 那是“加载即播放”，下方板块多半在首屏之外） -->
    <!-- 01 板块：卡片锚定右下角；滚动进入时弹出、进入 02 前淡出（见下方脚本） -->
    <section class="home-block works-block" id="sec-works">
      <div class="wrap wb-grid">
        <div class="wb-copy">
          <p class="kicker"><b>01</b> / WORKS 作品库</p>
          <h2>作品档案</h2>
          <p class="hb-desc">编号作品与配方档案：封面、工艺标签、过程说明，每件都可追溯。
            这里是最新入库，点卡片即可打开对应档案，<a href="/works/">进入作品库 →</a>。</p>
        </div>
        {/* 卡片堆：位于内容列内、与文案同属一个栅格，随列宽自适应 */}
        <div class="wb-deck">
          <HomeWorksCardSwap client:load items={latestWorks} />
        </div>
      </div>
    </section>

    <section class="home-block gallery-block" id="sec-gallery">
      <div class="wrap">
        <p class="kicker"><b>02</b> / GALLERY 画廊精选</p>
        <h2>影像收藏</h2>
        <p class="hb-desc">跨越不同时段的 MC 场景截图 · 悬停/点击可展开查看 · 完整图库见「<a href="/gallery/">画廊</a>」页。</p>
        <div class="acc-holder">
          <HomeGalleryAccordion client:load />
        </div>
      </div>
    </section>

    <section class="home-block about-home" id="sec-about">
      <div class="wrap">
        <p class="kicker"><b>03</b> / ABOUT 关于</p>
        <h2>关于本站</h2>
        <p class="hb-desc">一句话认识这里：这是谁、为什么做这个站，以及它想留下什么。</p>
        <div class="ph-card about-teaser">
          <p class="at-txt">
            <b>{SITE.author}</b> —— 计算机科学与技术（本科在读），方向偏后端与质量保障：
            能写 Java / Spring Boot 接口，也用测试的眼光对待每一个缺陷。
            这个站把学习轨迹、代码与产出按编号留存，让每一次练习都可追溯。
          </p>
          <a class="at-link" href="/about/">查看完整档案 <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  /* 首页路由：整页沉浸背景由全站 Particles 层承担 —— 隐藏页脚/进度条 */
  :global(body.home-route .site-footer) { display: none; }
  :global(body.home-route .prog) { display: none; }

  .hero {
    position: relative;
    min-height: calc(100vh - 76px);
    overflow: hidden;
    /* 关键：整个 hero 区域放行指针事件，让底层 Particles 的鼠标悬浮能生效
       （否则透明全屏层会吃掉所有光标移动，粒子 hover 效果不触发） */
    pointer-events: none;
  }

  /* 文字层浮于背景上：仅真实可交互/标题视差元素恢复指针 */
  .hero .wrap {
    position: relative;
    z-index: 2;
  }
  .hero .wrap :is(.display-tilt, a, button) {
    pointer-events: auto;
  }

  .home .display { color: var(--ink); }
  .home .display .line1 { opacity: 0.94; }
  .home .display .stroke {
    filter: drop-shadow(0 12px 24px rgba(0, 0, 0, 0.18));
  }
  /* —— ReactBits <StrokeText /> 适配（首页主标题）——
     官方组件量测/描边都在"内部坐标"里做，视觉大小由外部 font-size 决定：
     这里让根节点继承主标题字号，并把 SVG 高度从官方写死的 fontSize*1.3 改成 1em，
     这样宽高与 .display 同量级、且随 clamp() 一起响应式缩放。
     竖直方向有 pad（strokeWidth 与 fontSize*0.1 取大者）造成的余量，
     用负外边距收回，避免把首屏撑高。
     主标题现在只有一行（用户要求"只保留一行核心信息"），故不再需要"两行之间"的负边距。 */
  :global(.home .display .stroke-line) {
    display: block;
    /* 字号与 .display 共用 --display-size（48–72px，见 global.css 的 :root） */
    font-size: var(--display-size);
    /* 占位也要占住高度：否则挂载瞬间会把下方内容顶下去（"加载出来前错位"） */
    min-height: 1em;
    margin: -0.06em 0 -0.02em;
    /* 暗色电影感：标题不抢画面，靠留白与字号建立层级，不靠粗字重 */
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  :global(.home .display .stroke-line .stroke-text__svg) {
    height: 1em;
  }
  :global(.home .display .stroke-line .stroke-text__stroke),
  :global(.home .display .stroke-line .stroke-text__fill) {
    /* 与 .display 的字体族/字重保持一致（SVG text 会继承 color，但字体需显式给出） */
    font-family: var(--font-display);
  }
  :global(.home .typed-hero) { color: var(--ink-2); }
  :global(.home .typed-hero .typed-caret) { color: var(--accent-deep); }

  /* —— 首页下方占位板块（三屏可滚动内容） —— */
  .home-block {
    position: relative;
    padding: clamp(2.6rem, 7vw, 5rem) 0;
  }
  /* 板块文字区：01 靠左、02 靠右、03 靠左（左右交错排版，替代统一居中） */
  .home-block .wrap { text-align: center; }
  .works-block .wrap,
  .about-home .wrap {
    text-align: left;
  }
  .gallery-block .wrap {
    text-align: right;
  }
  .works-block .kicker,
  .about-home .kicker {
    justify-content: flex-start;
  }
  .gallery-block .kicker {
    justify-content: flex-end;
  }
  .home-block .kicker::after { display: none; }
  .home-block h2 {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: clamp(1.7rem, 4.6vw, 3rem);
    letter-spacing: -0.01em;
    margin: 0 0 0.4em;
  }
  .hb-desc {
    margin: 0 auto;
    max-width: 40em;
    color: var(--ink-2);
    font-size: 1rem;
    line-height: 1.9;
  }
  .works-block .hb-desc,
  .about-home .hb-desc {
    margin-left: 0;   /* 靠左：文本左缘对齐 */
    margin-right: auto;
  }
  .gallery-block .hb-desc {
    margin-left: auto; /* 靠右：文本右缘对齐 */
    margin-right: 0;
  }
  .gallery-block .acc-holder { text-align: left; } /* 手风琴组件本身仍从左开始铺排 */
  .hb-desc a {
    color: var(--accent-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .hb-desc a:hover { text-decoration-thickness: 2px; }

  /* —— 02 板块：AccordionGallery 手风琴画廊（标题下方全宽展示） —— */
  .gallery-block { padding-bottom: clamp(3.2rem, 8vw, 6rem); }
  .acc-holder { margin-top: clamp(1.6rem, 3.5vw, 2.6rem); }
  .acc-holder :global(.accordion-gallery) {
    /* 让手风琴在浅色主题下更醒目：面板自带深底，无需额外适配 */
    text-align: left;
  }
  .ph-card {
    margin: 1.6rem auto 0;
    min-height: min(44vh, 340px);
    max-width: var(--w-max);
    border-radius: var(--r-l);
    background: var(--glass);
    border: 1px dashed var(--line-2);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: var(--shadow-sm);
    display: grid;
    place-items: center;
    padding: 1.5rem;
  }
  .ph-note {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    color: var(--ink-3);
    text-transform: uppercase;
  }
  /* 03 板块：关于本站简介卡（靠左排版，与板块文字同侧） */
  .about-teaser {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    text-align: left;
    gap: 1.1rem;
    padding: clamp(1.6rem, 3.4vw, 2.4rem);
    min-height: auto;
  }
  .about-teaser .at-txt { margin: 0; color: var(--ink-2); font-size: 1rem; line-height: 1.9; }
  .about-teaser .at-txt b { color: var(--ink); font-weight: 500; }
  .at-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 999px;
    padding: 0.55rem 1.15rem;
    transition: transform 0.16s var(--ease), box-shadow 0.16s ease, background 0.16s ease;
  }
  .at-link span { transition: transform 0.16s var(--ease); }
  .at-link:hover { transform: translateY(0) scale(1.02); box-shadow: var(--shadow-sm); }
  .at-link:hover span { transform: translateX(3px); }

  /* —— 01 板块：标题居上，卡片堆在内容列内与正文并排。
     原先卡片堆用 position:absolute 锚在板块右下角（right: clamp(6px,2vw,24px)，
     已跑出内容列右侧 ~121px），而卡片是围绕容器中心铺开的 → 整叠被板块的
     overflow:clip 切断，还会顶进上方导航、压到下方 02 板块的文字。 */
  .works-block {
    position: relative;
    min-height: min(96vh, 860px);
    overflow: clip; /* 卡片掉落动画不溢出到 02 板块 */
    /* 卡片堆从板块顶边开始向下铺开，上沿会略微超出文案块；
       给板块足够的上下内边距，保证整叠（含后排高出的部分）落在板块内部、
       既不会顶到上方导航栏，也不会压到下一个板块。 */
    padding-top: clamp(1.5rem, 4vh, 3rem);
    padding-bottom: clamp(3.5rem, 9vh, 6.5rem);
  }
  /* 内容列内两栏：文案在左，卡片堆在右；两者同属 .wrap，天然与页面栅格对齐。
     卡片堆是普通流里的元素，不再绝对定位 —— 位置随列走，永远不会跑出页面。 */
  .works-block .wb-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    align-items: center;
  }
  .works-block .wb-copy { min-width: 0; }
  .works-block .wb-deck { min-width: 0; }
  @media (min-width: 1024px) {
    .works-block .wb-grid {
      /* 文案列略窄、卡片列略宽：卡片堆需要横向空间铺开 */
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
      gap: clamp(1.5rem, 3vw, 3rem);
      /* 顶对齐：卡片堆从板块顶边开始，整叠不会向上越界（越界会被 overflow:clip 切掉） */
      align-items: start;
    }
    /* 后排卡片按 --distY 向上铺开，会高出容器顶边；给卡片列留出这段高度，
       整叠才完整落在板块内（含板块 padding），不会顶到上方导航栏或被板块的
       overflow:clip 切掉上沿 —— 实测至少需要 ~0.2×容器高。 */
    .works-block .wb-deck { margin-top: clamp(1.25rem, 4vw, 3rem); }
  }
  /* 磨砂玻璃卡片材质。
     注意：这里必须用**不透明**的卡面（--glass-card / --paper），不能用半透明玻璃 ——
     卡片是叠起来的，前排要能盖住后排的文字；半透明会让后排的标题透出来，
     看起来就像"两行字压在一起"（原始显示 bug 的一部分）。 */
  .works-block :global(.card) {
    background: linear-gradient(165deg, var(--paper-1), var(--paper-2));
    border: 1px solid var(--line-glass);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.22),
      0 2px 10px rgba(0, 0, 0, 0.18);
    color: var(--ink);
    overflow: hidden;
  }
  html[data-theme='dark'] .works-block :global(.card) {
    background: linear-gradient(165deg, var(--paper-3), var(--paper-2));
  }
  /* ★单卡尺寸必须比容器小★：CardSwap 把它的 width/height 同时当作容器尺寸与单卡的
     内联尺寸写进 <Card>，而卡片要从容器中心向外铺开 ±dist —— 两者相等时卡片必然伸出
     容器，被外层 overflow:clip 切掉（这就是之前的显示 bug）。
     这里用 --deck-card-w/h（由组件按容器实测宽度算好并下发）把单卡压回"容器 − 2×dist"。
     !important 是必要的：内联样式优先级高于类选择器。 */
  .works-block :global(.card-swap-container .card) {
    width: var(--deck-card-w) !important;
    height: var(--deck-card-h) !important;
  }
  /* 卡片堆容器：**宽高由组件内联给出**（HomeWorksCardSwap 按外层实测宽度算出整叠尺寸，
     容器必须比单卡更大，否则卡片会被裁）。这里只负责层级与滚动显隐的初始态，
     千万不要写 height/width，否则会盖掉内联尺寸、又把卡片切掉。 */
  .works-block :global(.card-swap-container) {
    position: relative;
    top: auto;
    right: auto;
    bottom: auto;
    left: auto;
    margin: 0 auto;
    transform: translateY(30px);
    opacity: 0;
    z-index: 3;
    will-change: opacity, transform;
  }
</style>

<script>
  // 01 板块 CardSwap 滚动显隐：进入板块时整体上浮弹出，滚向 02 板块时整体淡出。
  // 用“实时查询容器 + 全局单次监听”实现：软导航切走再切回时容器重建也能立即接管。
  const getDeck = () => document.querySelector('.works-block .card-swap-container');

  let raf = 0;
  let wired = false;

  const step = () => {
    raf = 0;
    const deck = getDeck();
    if (!deck) return; // 不在首页时跳过
    const r = deck.getBoundingClientRect();
    const v = window.innerHeight;
    const H = r.height || 480;

    // 进入（从下方滑入视口时弹出）
    const inStart = v * 0.98;
    const inEnd = v * 0.55;
    const pIn = Math.min(1, Math.max(0, (inStart - r.top) / (inStart - inEnd)));
    // 淡出（滚过 01、接近顶部时消失，到完全离屏结束）
    const outStart = v * 0.12;
    const outEnd = -H - 40;
    const pOut = Math.min(1, Math.max(0, (r.top - outEnd) / (outStart - outEnd)));

    const o = pIn * pOut;
    const lift = (1 - o) * 34;
    // 尺寸与水平位置现在全在宿主层按容器实测算（HomeWorksCardSwap），
    // 这里只做"进入视口上浮 / 离开淡出"，不再需要缩放或水平微调。
    deck.style.opacity = o.toFixed(3);
    deck.style.transform = `translateY(${lift.toFixed(1)}px)`;
    deck.style.pointerEvents = o > 0.05 ? 'auto' : 'none';
  };

  const tick = () => {
    if (!raf) raf = requestAnimationFrame(step);
  };

  function wireDeck() {
    if (wired) return;
    wired = true;
    window.addEventListener('scroll', tick, { passive: true });
    window.addEventListener('resize', tick);
    // 每次软导航完成（含切回首页）后，多次延迟重算，覆盖 React 岛水合晚于 page-load 的情况
    window.addEventListener('astro:page-load', () => {
      [0, 120, 400, 900].forEach((ms) => setTimeout(tick, ms));
    });
    document.addEventListener('DOMContentLoaded', tick);
    window.addEventListener('load', () => {
      tick();
      setTimeout(tick, 300);
      setTimeout(tick, 900);
    });
    tick();
  }
  wireDeck();
</script>
