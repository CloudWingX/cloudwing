  }
  .wc:hover { transform: scale(1.02); border-color: var(--line-hover); }
  /* 固定宽高比容器：防 CLS */
  .wc-cover { display: block; aspect-ratio: 16 / 9; overflow: hidden; background: rgba(255, 255, 255, 0.04); }
  .wc-cover img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s var(--ease); }
  .wc:hover .wc-cover img { transform: scale(1.04); }
  .wc-body { display: flex; flex-direction: column; gap: 0.4rem; padding: 1rem 1.1rem 1.2rem; }
