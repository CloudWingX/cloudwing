---
// 归档页：从网站创立开始的**每一条改动与更新**，按日精确记录，时间轴呈现。
// 数据源 = changelog（改动/更新）+ posts（文章发布日）；
// 每天一句话概括；当天发过文章的，文字可点进 /posts/[slug]/ 详情。
import SidebarLayout from '../../layouts/SidebarLayout.astro';
import { getCollection } from 'astro:content';

/* ---------- 数据：changelog 全量 + 文章发布日 ---------- */
const logs = (await getCollection('changelog'))
  .flatMap((e) =>
    (e.data.items ?? []).map((it) => ({
      date: new Date(e.data.date).toISOString().slice(0, 10),
      year: new Date(e.data.date).getFullYear(),
      kind: it.kind || '更新',
      title: it.title,
      note: it.note || '',
    })),
  )
  .sort((a, b) => (a.date < b.date ? 1 : -1));

const posts = (await getCollection('posts')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);
/* 文章发布日 → 详情页链接（当天发多篇取最新一篇） */
const postByDay = new Map(
  posts.map((p) => [new Date(p.data.date).toISOString().slice(0, 10), p]),
);

/* 按日聚合（改动与更新为主，文章发布日并入同一天） */
const days = new Map();
for (const it of logs) {
  const d = days.get(it.date) ?? { date: it.date, year: it.year, items: [] };
  d.items.push(it);
  days.set(it.date, d);
}
for (const p of posts) {
  const key = new Date(p.data.date).toISOString().slice(0, 10);
  if (!days.has(key)) {
    days.set(key, {
      date: key,
      year: new Date(p.data.date).getFullYear(),
      items: [{ date: key, year: new Date(p.data.date).getFullYear(), kind: '文章', title: `发布《${p.data.title}》`, note: '' }],
    });
  } else {
    const d = days.get(key);
    if (!d.items.some((it) => it.kind === '文章')) {
      d.items.push({ date: key, year: d.year, kind: '文章', title: `发布《${p.data.title}》`, note: '' });
    }
  }
}

/* 年份分组（新 → 旧）；每天一句话概括 */
const years = new Map();
for (const d of [...days.values()].sort((a, b) => (a.date < b.date ? 1 : -1))) {
  const oneLine =
    d.items.length === 1
      ? d.items[0].title
      : `${d.items[0].title} 等 ${d.items.length} 条更新`;
  const post = postByDay.get(d.date);
  years.set(d.year, [...(years.get(d.year) ?? []), { ...d, oneLine, post }]);
}
const yearList = [...years.entries()].sort((a, b) => b[0] - a[0]);
const totalDays = [...days.values()].length;
---
<SidebarLayout title="归档" bodyClass="archive-route">
  <div class="archive-root">
    <div class="wrap">
      <header class="page-head" data-ent>
        <p class="kicker"><b>ARCHIVE</b> / 归档 · 时间线</p>
        <h1>归档</h1>
        <p class="head-sub">
          自 {2025} 年创立以来的每一条改动与更新 · 共 {totalDays} 天 · 精确到日
        </p>
      </header>

      {yearList.map(([year, list]) => (
        <section class="tl-year" data-ent aria-label={`${year} 年（${list.length} 天）`}>
          <h2 class="tl-yy">{year}</h2>
          <ol class="tl">
            {list.map((d) => {
              const hasPost = !!d.post;
              const body = hasPost ? (
                <a class="tl-text" href={`/posts/${d.post.id}/`}>{d.oneLine}</a>
              ) : (
                <span class="tl-text">{d.oneLine}</span>
              );
              return (
                <li class="tl-day">
                  <span class="tl-dot" aria-hidden="true"></span>
                  <time class="tl-date" datetime={d.date}>{d.date.slice(5).replace('-', '.')}</time>
                  <div class="tl-body">
                    {body}
                    {hasPost && (
                      <a class="tl-more" href={`/posts/${d.post.id}/`}>
                        阅读《{d.post.data.title}》 →
                      </a>
                    )}
                    {!hasPost && d.items.length > 1 && (
                      <span class="tl-kinds" aria-hidden="true">
                        {d.items.map((it) => it.kind).filter((k, i, a) => a.indexOf(k) === i).join(' · ')}
                      </span>
                    )}
                  </div>
                </li>
              );
            })}
          </ol>
        </section>
      ))}
    </div>
  </div>
</SidebarLayout>

<style>
  .archive-root { padding: 2.4rem 0 3rem; }
  .page-head { margin-bottom: 2rem; }
  .head-sub { margin: 0.4rem 0 0; font-size: 0.92rem; color: var(--ink-2); }

  .tl-year { margin-bottom: 2.4rem; }
  .tl-yy {
    margin: 0 0 0.9rem; font-size: clamp(1.9rem, 4vw, 2.6rem); font-weight: 600;
    color: var(--accent); letter-spacing: 0.02em; font-variant-numeric: tabular-nums;
  }

  /* 时间轴：左侧竖线 + 每天一个圆点 */
  .tl { list-style: none; margin: 0; padding: 0 0 0 1.1rem; position: relative; }
  .tl::before {
    content: ''; position: absolute; left: 0.28rem; top: 0.45rem; bottom: 0.45rem;
    width: 1px; background: var(--line-2); opacity: 0.7;
  }
  .tl-day {
    position: relative;
    display: flex; align-items: baseline; gap: 0.9rem;
    padding: 0.34rem 0;
  }
  .tl-dot {
    position: absolute; left: -1.1rem; top: 50%; transform: translateY(-50%);
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--accent); opacity: 0.85;
    box-shadow: 0 0 0 3px rgba(var(--accent-rgb), 0.15);
  }
  .tl-day:hover .tl-dot { opacity: 1; box-shadow: 0 0 0 4px rgba(var(--accent-rgb), 0.22); }
  .tl-date {
    flex: none; width: 3.4em;
    font-family: var(--font-mono); font-size: 0.8rem; color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .tl-body { min-width: 0; display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.3rem 0.9rem; }
  .tl-text { color: var(--ink-2); font-size: 0.94rem; line-height: 1.6; }
  a.tl-text { color: var(--ink); text-decoration: none; }
  a.tl-text:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .tl-more { font-size: 0.84rem; color: var(--accent); text-decoration: none; white-space: nowrap; }
  .tl-more:hover { text-decoration: underline; text-underline-offset: 3px; }
  .tl-kinds { font-size: 0.72rem; color: var(--ink-3); }

  @media (max-width: 640px) {
    .tl-day { flex-direction: column; gap: 0.15rem; }
    .tl-date { width: auto; }
  }
</style>
