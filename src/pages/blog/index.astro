---
// 归档页：从网站创立开始的**每一条改动与更新**，按日精确记录，时间轴呈现。
// 数据源 = changelog（全量）；时间线上的文字链接到当天的站点日志文章
// （/posts/ 里 date 相同的日志帖，优先主题文章）。
import SidebarLayout from '../../layouts/SidebarLayout.astro';
import { getCollection } from 'astro:content';

/* ---------- 数据：changelog 全量（改动/更新）---------- */
const logs = (await getCollection('changelog'))
  .flatMap((e) =>
    (e.data.items ?? []).map((it) => ({
      date: new Date(e.data.date).toISOString().slice(0, 10),
      year: new Date(e.data.date).getFullYear(),
      kind: it.kind || '更新',
      title: it.title,
      note: it.note || '',
    })),
  )
  .sort((a, b) => (a.date < b.date ? 1 : -1));

/* ---------- 文章：日期 → 详情链接（优先主题文章，其次当日日志）---------- */
const posts = (await getCollection('posts'))
  .filter((p) => !p.data.link)
  .sort((a, b) => {
    const aLog = a.data.title.startsWith('站点更新日志') ? 1 : 0;
    const bLog = b.data.title.startsWith('站点更新日志') ? 1 : 0;
    return aLog - bLog || new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  });
const postByDay = new Map();
posts.forEach((p) => {
  const key = new Date(p.data.date).toISOString().slice(0, 10);
  if (!postByDay.has(key)) postByDay.set(key, p);
});

/* ---------- 按日聚合 + 按年份分组（新 → 旧）---------- */
const days = new Map();
for (const it of logs) {
  const d = days.get(it.date) ?? { date: it.date, year: it.year, items: [] };
  d.items.push(it);
  days.set(it.date, d);
}

const years = new Map();
for (const d of [...days.values()].sort((a, b) => (a.date < b.date ? 1 : -1))) {
  const n = d.items.length;
  const kindCount = new Map();
  d.items.forEach((it) => kindCount.set(it.kind, (kindCount.get(it.kind) ?? 0) + 1));
  const oneLine =
    n === 1
      ? `${d.items[0].kind}：${d.items[0].title}`
      : `${d.items[0].kind}：${d.items[0].title} 等 ${n} 条更新`;
  const post = postByDay.get(d.date);
  years.set(d.year, [...(years.get(d.year) ?? []), { ...d, n, oneLine, post }]);
}
const yearList = [...years.entries()].sort((a, b) => b[0] - a[0]);
const totalDays = days.size;

/* ---------- 热力图：按日更新条数，GitHub contributions 风格（§55，2026-09-20）----------
   口径与时间轴一致 = changelog 条目数；列 = 周（周日始），行 = 周日..周六；
   范围 = 首条更新所在周的周日 → 构建日。零客户端 JS：tooltip 用原生 title。 */
const UTC = (s) => new Date(s + 'T00:00:00Z');
const todayKey = new Date().toISOString().slice(0, 10);
const hmStart = UTC([...days.keys()].sort()[0]);
hmStart.setUTCDate(hmStart.getUTCDate() - hmStart.getUTCDay()); // 回到所在周的周日
const hmCells = [];
for (let d = new Date(hmStart); d <= UTC(todayKey); d.setUTCDate(d.getUTCDate() + 1)) {
  const key = d.toISOString().slice(0, 10);
  hmCells.push({ key, dow: d.getUTCDay(), n: days.get(key)?.items.length ?? 0 });
}
while (hmCells.length % 7 !== 0) hmCells.push(null); // 补齐最后一周
const hmWeeks = [];
for (let i = 0; i < hmCells.length; i += 7) hmWeeks.push(hmCells.slice(i, i + 7));
const hmLevel = (n) => (n === 0 ? 0 : n === 1 ? 1 : n <= 3 ? 2 : n <= 7 ? 3 : 4);
const hmTotal = logs.length;
/* 月份标签：本周首日（周日）的月份与上周不同 → 在该列上方标月份 */
const hmMonths = hmWeeks.map((w, i) => {
  if (!w[0]) return null;
  const m = UTC(w[0].key).getUTCMonth() + 1;
  const prev = i > 0 && hmWeeks[i - 1][0] ? UTC(hmWeeks[i - 1][0].key).getUTCMonth() + 1 : null;
  return m !== prev ? `${m}月` : null;
});
---
<SidebarLayout title="归档" bodyClass="archive-route">
  <div class="archive-root">
    <div class="wrap">
      <header class="page-head" data-ent>
        <p class="kicker"><b>ARCHIVE</b> / 归档</p>
        <h1>归档</h1>
      </header>

      <section class="hm" data-ent aria-label="更新热力图">
        <div class="hm-meta">
          <span class="hm-stat">
            {hmCells[0].key.slice(0, 7).replace('-', '.')} – {todayKey.slice(0, 7).replace('-', '.')}
            {' '}共 <b>{hmTotal}</b> 条更新 · 活跃 <b>{totalDays}</b> 天
          </span>
          <span class="hm-legend" aria-hidden="true">
            少
            {[0, 1, 2, 3, 4].map((l) => <i class={`hm-c hm-l${l}`}></i>)}
            多
          </span>
        </div>
        <div class="hm-scroll" tabindex="0" role="img" aria-label="按日更新条数热力图，颜色越深当天更新越多">
          <div class="hm-grid">
            <div class="hm-months" aria-hidden="true">
              {hmMonths.map((m) => <span class="hm-month">{m}</span>)}
            </div>
            <div class="hm-cols">
              {hmWeeks.map((w) => (
                <div class="hm-week">
                  {w.map((c) =>
                    c ? (
                      <i
                        class={`hm-c hm-l${hmLevel(c.n)}`}
                        title={`${c.key}：${c.n} 条更新`}
                      ></i>
                    ) : (
                      <i class="hm-c"></i>
                    )
                  )}
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      {yearList.map(([year, list]) => (
        <section class="tl-year" data-ent aria-label={`${year} 年（${list.length} 天）`}>
          <h2 class="tl-yy">{year}</h2>
          <ol class="tl">
            {list.map((d) => (
              <li class="tl-day">
                <span class="tl-dot" aria-hidden="true"></span>
                <time class="tl-date" datetime={d.date}>{d.date.slice(5).replace('-', '.')}</time>
                <div class="tl-body">
                  {d.post ? (
                    <a class="tl-text" href={`/posts/${d.post.id}/`}>{d.oneLine}</a>
                  ) : (
                    <span class="tl-text">{d.oneLine}</span>
                  )}
                  {d.post && (
                    <span class="tl-kinds" aria-hidden="true">
                      {d.items.map((it) => it.kind).filter((k, i, a) => a.indexOf(k) === i).join(' · ')}
                    </span>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </div>
</SidebarLayout>

<style>
  .archive-root { padding: 2.4rem 0 3rem; }
  .page-head { margin-bottom: 1.6rem; }

  /* ── 更新热力图（§55）：GitHub contributions 风格，站点 accent 色阶 ──
     位置 = 标题下、内容上；不设 margin-top（保持 verify-shell 的 1.6rem 间距口径）。 */
  .hm { margin-bottom: 2.2rem; }
  .hm-meta {
    display: flex; align-items: baseline; justify-content: space-between;
    flex-wrap: wrap; gap: 0.4rem 1rem; margin-bottom: 0.7rem;
  }
  .hm-stat { font-size: 0.84rem; color: var(--ink-2); }
  .hm-stat b { color: var(--accent); font-variant-numeric: tabular-nums; }
  .hm-legend {
    display: inline-flex; align-items: center; gap: 3px;
    font-size: 0.72rem; color: var(--ink-3);
  }
  .hm-scroll { overflow-x: auto; padding-bottom: 2px; }
  .hm-months { display: flex; gap: 3px; margin-bottom: 3px; }
  .hm-month { flex: 1 1 0; min-width: 0; font-size: 0.7rem; color: var(--ink-3); white-space: nowrap; }
  .hm-cols { display: flex; gap: 3px; }
  .hm-week { display: flex; flex-direction: column; gap: 3px; flex: 1 1 0; min-width: 0; }
  /* 格子随列宽等比拉伸（2026-09-20 站长要求「宽一点大一点」）：不再写死 10px，
     列均分内容列宽度，aspect-ratio 保正方形。图例里的小色块单独定回固定尺寸。 */
  .hm-c {
    width: auto; height: auto; aspect-ratio: 1 / 1;
    border-radius: 3px; flex: none;
    background: rgba(var(--accent-rgb), 0.13);
    box-shadow: inset 0 0 0 1px rgba(var(--accent-rgb), 0.1);
  }
  .hm-legend .hm-c { width: 10px; height: 10px; aspect-ratio: auto; flex: none; }
  .hm-l1 { background: rgba(var(--accent-rgb), 0.34); box-shadow: none; }
  .hm-l2 { background: rgba(var(--accent-rgb), 0.55); box-shadow: none; }
  .hm-l3 { background: rgba(var(--accent-rgb), 0.78); box-shadow: none; }
  .hm-l4 { background: rgba(var(--accent-rgb), 1); box-shadow: 0 0 4px rgba(var(--accent-rgb), 0.4); }
  .hm-c:hover { transform: scale(1.35); }

  .tl-year { margin-bottom: 2.4rem; }
  .tl-yy {
    margin: 0 0 0.9rem; font-size: clamp(1.9rem, 4vw, 2.6rem); font-weight: 600;
    color: var(--accent); letter-spacing: 0.02em; font-variant-numeric: tabular-nums;
  }

  /* 时间轴：左侧竖线 + 每天一个圆点 */
  .tl { list-style: none; margin: 0; padding: 0 0 0 1.1rem; position: relative; }
  .tl::before {
    content: ''; position: absolute; left: 0.28rem; top: 0.45rem; bottom: 0.45rem;
    width: 1px; background: var(--line-2); opacity: 0.7;
  }
  .tl-day {
    position: relative;
    display: flex; align-items: baseline; gap: 0.9rem;
    padding: 0.34rem 0;
  }
  .tl-dot {
    position: absolute; left: -1.1rem; top: 50%; transform: translateY(-50%);
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--accent); opacity: 0.85;
    box-shadow: 0 0 0 3px rgba(var(--accent-rgb), 0.15);
  }
  .tl-day:hover .tl-dot { opacity: 1; box-shadow: 0 0 0 4px rgba(var(--accent-rgb), 0.22); }
  .tl-date {
    flex: none; width: 3.4em;
    font-family: var(--font-mono); font-size: 0.8rem; color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .tl-body { min-width: 0; display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.3rem 0.9rem; }
  .tl-text { color: var(--ink-2); font-size: 0.94rem; line-height: 1.6; }
  a.tl-text { color: var(--ink); text-decoration: none; }
  a.tl-text:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .tl-kinds { font-size: 0.72rem; color: var(--ink-3); }

  @media (max-width: 640px) {
    .tl-day { flex-direction: column; gap: 0.15rem; }
    .tl-date { width: auto; }
  }
</style>
