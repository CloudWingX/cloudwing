---
// 画廊（原“影集”，V44 重做）：去掉沉浸式 DomeGallery 球幕，
// 改为与全站风格统一的玻璃卡片网格 + 点击大图浏览；背景沿用全站 Particles。
import SidebarLayout from '../../layouts/SidebarLayout.astro';
import { getCollection } from 'astro:content';
import { imgUrl } from '../../site';

const fmt = (d: Date) => new Date(d).toISOString().slice(0, 10);
const all = await getCollection('shots');

// 内容里的 title 清一色是「2024-06-25 · MC」——和 date + game 完全重复。
// 这里不再把它当标题显示（否则卡片上日期出现两遍），改成按「同一天同游戏」分组
// 生成有用的标签：Minecraft · 03/06。**不改内容文件**，只改展示层。
const groups = new Map();
for (const e of all) {
  const k = fmt(e.data.date) + '|' + e.data.game;
  if (!groups.has(k)) groups.set(k, []);
  groups.get(k).push(String(e.id));
}
for (const ids of groups.values()) ids.sort();

const shots = all
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .map((e) => {
    const no = String(e.id);
    const ids = groups.get(fmt(e.data.date) + '|' + e.data.game) ?? [no];
    const seq = ids.indexOf(no) + 1;
    // 同组多于一张才带序号（01/06），否则只用游戏名
    const label = ids.length > 1 ? `${e.data.game} · ${String(seq).padStart(2, '0')}/${String(ids.length).padStart(2, '0')}` : e.data.game;
    return {
      no: no.toUpperCase(),
      label,
      date: fmt(e.data.date),
      game: e.data.game,
      note: e.data.note,
      image: imgUrl(e.data.image), // 图片走 IMG_CDN（图床开关）
      aspect: e.data.aspect ?? '16:9',
    };
  });
const count = String(shots.length);
// 分类（游戏/场景）在导航栏「画廊」二级菜单里：点分类 → /gallery/?game=xxx。
// 静态站构建时拿不到查询串，所以过滤在浏览器端做（见页面底部脚本）。
---
<SidebarLayout title="画廊" center>
  <div class="wrap">
    <header class="page-head" data-ent>
      <p class="kicker"><b>02</b> / GALLERY 画廊</p>
      <h1>画廊</h1>
      <p class="gal-filter" id="gal-filter" hidden>
        <span class="gf-k">分类</span>
        <span class="gf-v" id="gal-cat">—</span>
        <span class="gf-n"><span id="gal-count">{count}</span> 张</span>
        <a class="gf-clear" href="/gallery/">显示全部</a>
      </p>
    </header>

    <section class="section" style="padding-top:1.6rem">
      <ul class="gal-grid">
        {
          shots.map((s, i) => (
            <li class="gal-item" id={s.no} data-game={s.game} data-ent style={`--ad:${(i % 10) * 70}ms`}>
              <button class="gal-card" type="button" data-gal-open
                data-title={s.label}
                data-meta={`${s.no} · ${s.date} · ${s.game}`}
                data-note={s.note || ''}
                data-img={s.image}
                aria-label={`查看大图：${s.date} ${s.game}（${s.no}）`}
              >
                <span class="gal-cover" style={`aspect-ratio:${s.aspect.replace(':', ' / ')}`}>
                  <img src={s.image} alt={`${s.date} ${s.game} 截图`} loading="lazy" />
                </span>
                <span class="gal-info">
                  <span class="gal-no">{s.no}</span>
                  <span class="gal-title">{s.label}</span>
                  <span class="gal-meta">{s.date}</span>
                </span>
              </button>
            </li>
          ))
        }
      </ul>

      {shots.length === 0 && (
        <p class="sub">暂无截图。把图片放入 <code>public/shots/</code> 并添加 Markdown 即可展示。</p>
      )}
    </section>
  </div>

  <!-- 大图浏览 -->
  <dialog class="gal-dialog" id="galDialog">
    <button class="gd-close" type="button" data-gal-close aria-label="关闭">✕</button>
    <figure>
      <img id="gdImg" src="" alt="" />
      <figcaption>
        <span class="gd-title" id="gdTitle"></span>
        <span class="gd-meta" id="gdMeta"></span>
        <span class="gd-note" id="gdNote"></span>
      </figcaption>
    </figure>
  </dialog>
</SidebarLayout>

<style>
  /* 当前分类回显（分类选择器在导航栏「画廊」二级菜单里） */
  .gal-filter {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0.2rem 0 0;
    padding: 0.35rem 0.7rem 0.35rem 0.9rem;
    border-radius: 999px;
    border: var(--line-w) solid var(--line-2);
    background: var(--glass);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    box-shadow: var(--shadow-sm);
    font-size: 0.8rem;
  }
  .gf-k {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .gf-v { font-weight: 700; color: var(--accent-deep); }
  .gf-clear {
    margin-left: 0.2rem;
    padding: 0.16rem 0.6rem;
    border: var(--line-w) solid var(--line-2);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--ink-2);
    text-decoration: none;
    transition: color 0.16s var(--ease), border-color 0.16s var(--ease), background 0.16s var(--ease);
  }
  .gf-clear:hover {
    color: var(--accent-deep);
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .gal-item[hidden] { display: none !important; }
  /* 画廊页样式：玻璃卡网格，跟随浅/深主题 */
  .gal-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1.1rem;
  }
  .gal-item { display: block; }
  /* 手机端：40 张图单列会有 1.3 万像素高（≈16 屏），改成两列网格更好扫。
     注意 .gal-cover 的 aspect-ratio 是行内样式（来自每条内容的 aspect 字段），
     这里只收紧间距与文案，不强行改比例。 */
  @media (max-width: 620px) {
    .gal-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.7rem;
    }
    .gal-info { padding: 0.6rem 0.7rem 0.7rem; gap: 0.15rem; }
    .gal-no { font-size: 0.58rem; letter-spacing: 0.1em; }
    .gal-title { font-size: 0.82rem; -webkit-line-clamp: 2; }
    .gal-meta { font-size: 0.66rem; }
    /* 列表页头部与筛选条收紧，避免首屏几乎全是留白 */
    .page-head { padding-top: 1.4rem; }
  }

  .gal-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 0;
    border: var(--line-w) solid var(--line-2);
    border-radius: var(--r-l);
    background: var(--glass);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: var(--shadow-sm);
    color: var(--ink);
    cursor: zoom-in;
    overflow: hidden;
    font: inherit;
    text-align: left;
    transition: transform 0.18s var(--ease), box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .gal-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--accent);
  }
  .gal-cover {
    display: block;
    overflow: hidden;
    background: var(--paper-1);
    aspect-ratio: 16 / 9;
  }
  .gal-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s var(--ease);
  }
  .gal-card:hover .gal-cover img { transform: scale(1.05); }

  .gal-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.8rem 1rem 0.95rem;
  }
  .gal-no {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    color: var(--ink-3);
    text-transform: uppercase;
  }
  .gal-title {
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.35;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .gal-meta { font-family: var(--font-mono); font-size: 0.74rem; color: var(--ink-2); }

  /* 大图 dialog */
  .gal-dialog {
    border: var(--line-w) solid var(--line-2);
    border-radius: var(--r-l);
    padding: 0.6rem 0.6rem 0.4rem;
    background: var(--paper, #0c0c0e);
    color: var(--ink);
    box-shadow: var(--shadow-lg);
    max-width: min(1040px, 94vw);
    max-height: 92vh;
  }
  .gal-dialog::backdrop {
    background: rgba(0, 0, 0, 0.62);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .gal-dialog figure { margin: 0; }
  .gal-dialog img {
    display: block;
    width: 100%;
    max-height: 76vh;
    object-fit: contain;
    border-radius: calc(var(--r-l) - 6px);
  }
  .gal-dialog figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.7rem 0.5rem 0.4rem;
  }
  .gd-title { font-weight: 700; font-size: 1.05rem; }
  .gd-meta { font-family: var(--font-mono); font-size: 0.76rem; color: var(--ink-2); }
  .gd-note { font-size: 0.88rem; color: var(--ink-2); }
  .gd-note:empty { display: none; }
  .gd-close {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 2;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: var(--line-w) solid var(--line-2);
    background: color-mix(in srgb, var(--paper, #0c0c0e) 78%, transparent);
    color: var(--ink);
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
  }
  .gd-close:hover { background: var(--accent); color: var(--on-accent); }

  html[data-theme='light'] .gal-dialog { background: #f5f5f6; }

  @media (prefers-reduced-motion: reduce) {
    .gal-card, .gal-cover img { transition: none !important; }
  }
</style>

<script>
  // 画廊大图浏览：卡片 → dialog 大图（支持点击背板/✕/Esc 关闭）
  const dlg = document.getElementById('galDialog');
  if (dlg && typeof dlg.showModal === 'function') {
    const img = document.getElementById('gdImg');
    const titleEl = document.getElementById('gdTitle');
    const metaEl = document.getElementById('gdMeta');
    const noteEl = document.getElementById('gdNote');

    document.addEventListener('click', (e) => {
      const card = e.target.closest('[data-gal-open]');
      if (!card) return;
      const src = card.dataset.img;
      if (!src) return;
      img.src = src;
      img.alt = card.dataset.title || '';
      titleEl.textContent = card.dataset.title || '';
      metaEl.textContent = card.dataset.meta || '';
      noteEl.textContent = card.dataset.note || '';
      dlg.showModal();
      document.body.classList.add('modal-open');
    });
    document.querySelectorAll('[data-gal-close]').forEach((b) =>
      b.addEventListener('click', () => { dlg.close(); document.body.classList.remove('modal-open'); })
    );
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) { dlg.close(); document.body.classList.remove('modal-open'); }
    });
    dlg.addEventListener('close', () => document.body.classList.remove('modal-open'));
  }

  // 分类筛选：导航栏「画廊」二级菜单点分类 → /gallery/?game=xxx。
  // 静态站构建时读不到查询串，所以在浏览器端过滤（软导航后同样重新应用）。
  const applyGameFilter = () => {
    const grid = document.querySelector('.gal-grid');
    if (!grid) return;
    let want = null;
    try {
      want = new URLSearchParams(location.search).get('game');
    } catch (err) {
      want = null;
    }
    const items = Array.from(grid.querySelectorAll('.gal-item'));
    let n = 0;
    items.forEach((it) => {
      const on = !want || it.dataset.game === want;
      it.hidden = !on;
      if (on) n++;
    });
    const chip = document.getElementById('gal-filter');
    const catEl = document.getElementById('gal-cat');
    const countEl = document.getElementById('gal-count');
    if (catEl) catEl.textContent = want || '—';
    if (countEl) countEl.textContent = String(n);
    if (chip) chip.hidden = !want;
  };

  if (!window.__cwGalFilterWired) {
    window.__cwGalFilterWired = true;
    // 挂 document：astro:page-load 在 document 上派发（挂 window 收不到）
    document.addEventListener('astro:page-load', applyGameFilter);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', applyGameFilter, { once: true });
    } else {
      applyGameFilter();
    }
  }
</script>
