---
// CloudWing 品牌标志（来自品牌稿 preview.html，纯矢量 path，零字体依赖）。
//
// 造型：几何平底云 + 三根向上掠出的羽翼，共用一个藏在云内的根部 ——「云生翼」。
// 羽翼的斜向笔势同时呼应 `</>` 的写法。
// 配色：云体用 --brand-cloud（深色底 = 纸白 / 浅色底 = 深空墨），羽翼用 --brand-wing（雾蓝）。
//
// 两种形态：
//   variant="horizontal"  横版字标（CLOUD 深空墨 / WING 雾蓝），导航栏用
//   variant="icon"        纯图标（favicon 同款），空间紧张时用
//
// 用法：<BrandMark variant="horizontal" height={30} />
//      <BrandMark variant="icon" height={20} cloud="#1A1A2E" />  // 浅色底用深空墨
const {
  variant = 'horizontal',
  height = 30,
  cloud = 'var(--brand-cloud)',
  wing = 'var(--brand-wing)',
  class: klass = '',
} = Astro.props;

// 横版：355.06 × 58（比例 6.12）；图标：64 × 64
const isIcon = variant === 'icon';
const ratio = isIcon ? 1 : 355.06 / 58;
const h = height;
const w = Math.round(h * ratio * 100) / 100;
---
{isIcon ? (
  <svg
    class={`brandmark ${klass}`.trim()}
    width={w}
    height={h}
    viewBox="0 0 64 64"
    fill="none"
    role="img"
    aria-label="CloudWing"
  >
    <g transform="translate(-0.94 2.65) scale(0.9915)">
      <g fill="none" stroke={wing} stroke-width="6.5" stroke-linecap="round">
        <path d="M16.00 46.00L41.28 12.46" />
        <path d="M16.00 46.00L53.82 16.45" />
        <path d="M16.00 46.00L56.20 28.10" />
      </g>
      <g fill={cloud}>
        <rect x="7" y="42" width="29" height="8" rx="4" />
        <circle cx="14" cy="42" r="7" />
        <circle cx="23" cy="38" r="9.5" />
        <circle cx="30" cy="42" r="6" />
      </g>
    </g>
  </svg>
) : (
  <svg
    class={`brandmark ${klass}`.trim()}
    width={w}
    height={h}
    viewBox="0 0 355.06 58.00"
    fill="none"
    role="img"
    aria-label="CloudWing"
  >
    {/* 图标部分：云 + 翼 */}
    <g transform="translate(-1.89 -4.38) scale(1.1277)">
      <g fill="none" stroke={wing} stroke-width="6.5" stroke-linecap="round">
        <path d="M16.00 46.00L41.28 12.46" />
        <path d="M16.00 46.00L53.82 16.45" />
        <path d="M16.00 46.00L56.20 28.10" />
      </g>
      <g fill={cloud}>
        <rect x="7" y="42" width="29" height="8" rx="4" />
        <circle cx="14" cy="42" r="7" />
        <circle cx="23" cy="38" r="9.5" />
        <circle cx="30" cy="42" r="6" />
      </g>
    </g>
    {/* 字标：CLOUD 用云体色、WING 用雾蓝（把品牌名拆成「云 / 翼」） */}
    <g transform="translate(78.14 49.50)">
      <path
