---
// 右侧栏：本页目录（TOC，只有正文有标题时出现）+ 最近入库作品。
// TOC 数据由页面用 render() 得到的 headings 传入；高亮/平滑滚动由 ui.js 的 tocSpy() 负责。
import { getCollection } from 'astro:content';

interface Props {
  toc?: { depth: number; slug: string; text: string }[];
}

const { toc = [] } = Astro.props;
const pathname = Astro.url.pathname;

const recent = (await getCollection('works'))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 5)
  .map((e) => ({
    no: 'W-' + String(e.data.order ?? 0).padStart(3, '0'),
    title: e.data.title ?? '未命名档案',
    date: new Date(e.data.date).toISOString().slice(0, 10),
    url: `/works/${e.id}/`,
  }));
---

<aside class="shell-right">
  {toc.length > 0 && (
    <nav class="sidecard" aria-label="本页目录" data-toc>
      <h2>ON THIS PAGE / 本页目录</h2>
      <ul class="toc-list">
        {toc.map((h) => (
          <li class={h.depth >= 3 ? 'd3' : 'd2'}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  )}

  <nav class="sidecard" aria-label="最近入库">
    <h2>RECENT / 最近入库</h2>
    <ul class="recent-list">
      {recent.map((r) => (
        <li>
          <a href={r.url} aria-current={r.url === pathname ? 'page' : undefined} title={`${r.no} · ${r.title}`}>
            <span class="rc-no">{r.no}</span>
            <span class="rc-title">{r.title}</span>
            <span class="rc-date">{r.date}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</aside>
