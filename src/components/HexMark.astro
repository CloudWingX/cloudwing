---
// Hex 徽记（与 favicon 同款的小尺寸内联版）
const size = Astro.props.size ?? 30;
const fill = Astro.props.fill ?? 'currentColor';
---
<svg class="hex" width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
  <path d="M32 6 L54 18 L54 46 L32 58 L10 46 L10 18 Z" fill="none" stroke={fill} stroke-width="3"/>
  <path d="M32 16 L46 24 L46 40 L32 48 L18 40 L18 24 Z" fill="none" stroke={fill} stroke-width="1.4" opacity="0.55"/>
  <circle cx="32" cy="32" r="5" fill="var(--accent)" stroke={fill} stroke-width="2"/>
  <circle cx="32" cy="32" r="1.6" fill={fill}/>
</svg>
