---
// 左侧栏（全站子页面通用，内容固定不随页面变化）：
//   博客（归档 + 每篇文章）/ 画廊（全部截图 + 每张）/ 站点页面
// 只按 pathname 决定「哪个条目高亮」和「哪个分组默认展开」，其余完全一致。
import { getCollection } from 'astro:content';
import { SITE } from '../site';
import WeatherCard from './WeatherCard.astro';
import MusicPlayer from './MusicPlayer.astro';
import '../styles/shell.css';

// 个人信息卡（侧栏左上角）——顶部背景图待定：
//   留空 '' = 使用主题渐变（浅/深各自一套，见 shell.css 的 .pf-bg）；
//   填站内路径（如 '/lanyard/banner.webp'）= 自动改用该图片当横幅。
const PROFILE_BANNER = '';

const pathname = Astro.url.pathname;

const posts = (await getCollection('posts'))
  .filter((p) => !p.data.link)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .map((e) => ({
    title: e.data.title ?? '未命名文章',
    url: `/posts/${e.id}/`,
  }));

const shots = (await getCollection('shots'))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .map((e) => ({
    no: String(e.id).toUpperCase(),
    title: e.data.title ?? '未命名截图',
    url: `/gallery/#${String(e.id).toUpperCase()}`,
  }));

const SITES = [
  { href: '/blog/', label: '归档时间线' },
  { href: '/log/', label: '更新日志' },
  { href: '/nav/', label: '网站导航' },
  { href: '/about/', label: '关于' },
  { href: '/account/', label: '互动' },
];

const cur = (url: string) => (url === pathname ? 'page' : undefined);
---
<aside class="shell-left">
  <!-- 个人信息卡：结构对齐参考站（横幅 + 压在横幅上的圆形头像 + 名字 + 简介 + 链接） -->
  <section class="sidecard pf-card">
    <div class="pf-bg" style={PROFILE_BANNER ? `--pf-banner: url('${PROFILE_BANNER}')` : undefined} aria-hidden="true"></div>
    <div class="pf-avatar-wrap">
      <a class="pf-avatar" href="/about/" aria-label="关于我">
        <img src="/lanyard/avatar-card.320.webp" srcset="/lanyard/avatar-card.160.webp 160w, /lanyard/avatar-card.320.webp 320w" sizes="76px" width="76" height="76" alt={SITE.author} loading="eager" decoding="async" />
      </a>
    </div>
    <div class="pf-body">
      <p class="pf-name">{SITE.author}<span>{SITE.title}</span></p>
      <p class="pf-bio">{SITE.tagline.replace(/^[^—]*——\s*/, '')}</p>
      <p class="pf-links">
        <a href={SITE.github} target="_blank" rel="noreferrer">GitHub</a>
        <a href={SITE.bilibili} target="_blank" rel="noreferrer">Bilibili</a>
        <a href={`mailto:${SITE.email}`}>邮箱</a>
        <a href="/about/">关于 →</a>
      </p>
    </div>
  </section>

  <!-- 天气小帖：紧跟在个人信息卡下面 -->
  <WeatherCard />

  <nav class="sidecard sidetree" aria-label="站点导航树">
    <h2>INDEX / 档案索引</h2>

    <details class="st-group">
      <summary>
        <span class="st-caret">▶</span>
        <span>文章</span>
        <span class="st-n">{posts.length}</span>
      </summary>
      <ul class="st-list">
        <li>
          <a href="/posts/" aria-current={cur('/posts/')}>
            <span class="st-txt">全部文章</span>
          </a>
        </li>
        {posts.map((p) => (
          <li>
            <a href={p.url} aria-current={cur(p.url)} title={p.title}>
              <span class="st-txt">{p.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </details>

    <details class="st-group">
      <summary>
        <span class="st-caret">▶</span>
        <span>站点</span>
        <span class="st-n">{SITES.length}</span>
      </summary>
      <ul class="st-list">
        {SITES.map((s) => (
          <li>
            <a href={s.href} aria-current={cur(s.href)}>
              <span class="st-txt">{s.label}</span>
            </a>
          </li>
        ))}
        <li>
          {/* 搜索已改成悬浮窗（不再是独立页面），这里用按钮触发 */}
          <button type="button" class="st-search" data-search-open>
            <span class="st-txt">搜索</span>
          </button>
        </li>
      </ul>
    </details>

    <details class="st-group">
      <summary>
        <span class="st-caret">▶</span>
        <span>画廊</span>
        <span class="st-n">{shots.length}</span>
      </summary>
      <ul class="st-list">
        <li>
          <a href="/gallery/" aria-current={cur('/gallery/')}>
            <span class="st-txt">全部截图</span>
          </a>
        </li>
        {shots.map((s) => (
          <li>
            <a href={s.url} title={`${s.no} · ${s.title}`}>
              <span class="st-no">{s.no}</span>
              <span class="st-txt">{s.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </details>
  </nav>

  <!-- 音乐播放器：左侧栏最下方（歌曲列表见 site.ts 的 MUSIC） -->
  <MusicPlayer />
</aside>
