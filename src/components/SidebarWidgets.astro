---
// 右侧栏（全站子页面通用，内容固定不随页面变化）：
//   简介卡 / 站点统计 / 活跃日历 / 最近更新 / 今日一言
// 数据全部来自站内内容集合与 site.ts，不依赖任何外部接口，所以任何子页面看到的都一样。
import { getCollection } from 'astro:content';
import { SITE } from '../site';
import SidebarStatValue from './SidebarStatValue.jsx';

const works = (await getCollection('works')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);
const shots = (await getCollection('shots')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);
/* ---------- 站点统计 ---------- */
const tagSet = new Set<string>();
works.forEach((w) => (w.data.tags ?? []).forEach((t: string) => tagSet.add(t)));
const wordCount = works.reduce((n, w) => n + (w.body ?? '').replace(/\s/g, '').length, 0);
const sinceDate = new Date(`${SITE.since}-01-01T00:00:00`);
const runningDays = Math.max(1, Math.round((Date.now() - sinceDate.getTime()) / 86400000));
const stats = [
  { k: '作品', v: works.length },
  { k: '截图', v: shots.length },
  { k: '分类', v: tagSet.size },
  // 字数超千显示成 1.8k：数值给 1.8、后缀给 k，动画只跑数字部分
  { k: '字数', v: wordCount > 999 ? Number((wordCount / 1000).toFixed(1)) : wordCount, suffix: wordCount > 999 ? 'k' : '' },
  { k: '运行', v: runningDays, suffix: ' 天' },
];
const lastActive = [...works, ...shots]
  .map((e) => new Date(e.data.date).getTime())
  .sort((a, b) => b - a)[0];
const lastActiveStr = lastActive ? new Date(lastActive).toISOString().slice(0, 10) : '—';

/* ---------- 活跃日历（当月，有归档的日期打点）---------- */
/* ---------- 更新日历：把「作品 / 截图 / 站点更新」按日期聚合成事件 ---------- */
type CalEvent = { kind: string; title: string; url?: string; note?: string };

const worksEvents = works.map((e) => ({
  date: new Date(e.data.date).toISOString().slice(0, 10),
  kind: '作品',
  title: e.data.title ?? '未命名档案',
  url: `/works/${e.id}/`,
}));
const shotEvents = shots.map((e) => ({
  date: new Date(e.data.date).toISOString().slice(0, 10),
  kind: '截图',
  // 内容里的 title 是「2026-08-18 · MC」，点击后的日期面板本来按天分组，日期会重复；
  // 这里同样只留游戏名。
  title: e.data.game ?? '未命名截图',
  url: `/gallery/#${String(e.id).toUpperCase()}`,
}));
const logEvents = (await getCollection('changelog')).flatMap((e) =>
  (e.data.items ?? []).map((it) => ({
    date: new Date(e.data.date).toISOString().slice(0, 10),
    kind: it.kind || '更新',
    title: it.title,
    note: it.note || '',
  })),
);

// 日期 → 事件列表（新事件在前）
const byDay = new Map<string, CalEvent[]>();
[...worksEvents, ...shotEvents, ...logEvents].forEach((ev) => {
  const list = byDay.get(ev.date) ?? [];
  list.push({ kind: ev.kind, title: ev.title, url: (ev as { url?: string }).url, note: (ev as { note?: string }).note });
  byDay.set(ev.date, list);
});

const pad = (n: number) => String(n).padStart(2, '0');
const now = new Date();
const y = now.getFullYear();
const m = now.getMonth();
const firstWeekday = new Date(y, m, 1).getDay(); // 0 = 周日
const daysInMonth = new Date(y, m + 1, 0).getDate();
const iso = (day: number) => `${y}-${pad(m + 1)}-${pad(day)}`;
const monthEvents = [...byDay.entries()].filter(([d]) => d.startsWith(`${y}-${pad(m + 1)}`));
const dayCount = new Map<string, number>(monthEvents.map(([d, list]) => [d, list.length]));
const kindCount = new Map<string, number>();
monthEvents.forEach(([, list]) => list.forEach((ev) => kindCount.set(ev.kind, (kindCount.get(ev.kind) ?? 0) + 1)));
const kindSummary = [...kindCount.entries()].sort((a, b) => b[1] - a[1]);

const cells: (number | null)[] = [
  ...Array.from({ length: firstWeekday }, () => null),
  ...Array.from({ length: daysInMonth }, (_, i) => i + 1),
];
const monthLabel = `${y} 年 ${m + 1} 月`;
const today = now.getDate();
const todayIso = `${y}-${pad(m + 1)}-${pad(today)}`;
const monthTotal = monthEvents.reduce((n, [, list]) => n + list.length, 0);

// 交给前端渲染当天明细（键为 ISO 日期）
const calData: Record<string, CalEvent[]> = {};
byDay.forEach((list, d) => {
  calData[d] = list;
});
const calJson = JSON.stringify(calData).replace(/</g, '\\u003c');

/* ---------- 最近更新（作品 + 截图混排）---------- */
const recent = [
  ...works.map((e) => ({
    kind: '作品',
    title: e.data.title ?? '未命名档案',
    date: new Date(e.data.date).toISOString().slice(0, 10),
    url: `/works/${e.id}/`,
  })),
  ...shots.map((e) => ({
    kind: '截图',
    // 截图的 title 内容里就是「2026-08-18 · MC」，而这一行的日期已单独显示（右侧），
    // 直接用它会让日期出现两遍；这里只留游戏名。
    title: e.data.game ?? '未命名截图',
    date: new Date(e.data.date).toISOString().slice(0, 10),
    url: `/gallery/#${String(e.id).toUpperCase()}`,
  })),
]
  .sort((a, b) => (a.date < b.date ? 1 : -1))
  .slice(0, 4); // 4 条刚好让右栏在常见视口高度内不超屏，两栏才能齐步吸顶

/* ---------- 今日一言（本地静态，按日期轮换）---------- */
const QUOTES = [
  { t: '学而不思则罔，思而不学则殆。', by: '《论语》' },
  { t: '不积跬步，无以至千里。', by: '《荀子》' },
  { t: '把每一次练习，都变成一条可追溯的档案。', by: SITE.title },
  { t: '知不足，然后能自反也。', by: '《礼记》' },
  { t: '纸上得来终觉浅，绝知此事要躬行。', by: '陆游' },
  { t: '工欲善其事，必先利其器。', by: '《论语》' },
  { t: '博观而约取，厚积而薄发。', by: '苏轼' },
];
const dayIndex = Math.floor(Date.now() / 86400000);
const quote = QUOTES[dayIndex % QUOTES.length];
---

<aside class="shell-right">
  <!-- 站点统计 -->
  <section class="sidecard">
    <h2>STATS / 站点统计</h2>
    <ul class="sw-stats">
      {stats.map((s) => (
        <li>
          <span class="k">{s.k}</span>
          {/* React 岛：数字带 CountUp 计数动画（ReactBits 原码，宿主见 SidebarStatValue.jsx）。
              client:visible —— 侧栏进入视口即开始计数；每次加载/刷新/软导航都会重放。 */}
          <SidebarStatValue client:visible value={s.v} suffix={s.suffix ?? ''} />
        </li>
      ))}
    </ul>
    <p class="sw-last">最后更新 · {lastActiveStr}</p>
  </section>

  <!-- 更新日历：有记录的日子可点，展开当天「做了什么」 -->
  <section class="sidecard sw-cal-card">
    <h2>CALENDAR / 更新日历</h2>
    <p class="sw-month">
      {monthLabel}
      {monthTotal > 0 && <span class="sw-month-n">{monthTotal} 条更新</span>}
    </p>
    <div class="sw-cal" role="group" aria-label={`${monthLabel}更新日历，有记录的日期可点开查看`}>
      {['日', '一', '二', '三', '四', '五', '六'].map((d) => (
        <span class="wd" aria-hidden="true">{d}</span>
      ))}
      {cells.map((d) => {
        if (d === null) return <span class="cell empty" />;
        const key = iso(d);
        const list = byDay.get(key) ?? [];
        const n = list.length;
        const names = list.map((ev) => `${ev.kind}：${ev.title}`).join('；');
        return n > 0 ? (
          <button
            type="button"
            class:list={['cell', 'has', { today: d === today }]}
            data-cal-day={key}
            aria-label={`${m + 1} 月 ${d} 日 ${n} 条记录`}
            title={names}
          >
            {d}
            {n > 1 && <i class="cnt">{n}</i>}
          </button>
        ) : (
          <span class:list={['cell', { today: d === today }]} title={`${m + 1} 月 ${d} 日`}>{d}</span>
        );
      })}
    </div>
    {kindSummary.length > 0 && (
      <p class="sw-cal-legend">
        {kindSummary.map(([k, n]) => (
          <span class="lg-item"><i class="dot" />{k} {n}</span>
        ))}
      </p>
    )}
    <p class="sw-cal-hint" data-cal-hint>点日期看当天做了什么</p>

    <div class="sw-cal-panel" data-cal-panel hidden>
      <p class="sw-cal-panel-head">
        <span data-cal-title>—</span>
        <button type="button" class="sw-cal-close" data-cal-close aria-label="收起当天记录">收起</button>
      </p>
      <ul class="sw-cal-list" data-cal-list></ul>
    </div>
    <script type="application/json" data-cal-data set:html={calJson} />
  </section>

  <!-- 最近更新 -->
  <nav class="sidecard" aria-label="最近更新">
    <h2>RECENT / 最近更新</h2>
    <ul class="recent-list">
      {recent.map((r) => (
        <li>
          <a href={r.url} aria-current={r.url === Astro.url.pathname ? 'page' : undefined} title={`${r.kind} · ${r.title}`}>
            <span class="rc-kind">{r.kind}</span>
            <span class="rc-title">{r.title}</span>
            <span class="rc-date">{r.date}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- 今日一言 -->
  <section class="sidecard sw-quote">
    <h2>QUOTE / 今日一言</h2>
    <blockquote>{quote.t}</blockquote>
    <p class="sw-by">—— {quote.by}</p>
  </section>
</aside>
