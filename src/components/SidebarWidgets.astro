---
// 右侧栏（全站子页面通用，内容固定不随页面变化）：
//   简介卡 / 站点统计 / 活跃日历 / 最近更新 / 今日一言
// 数据全部来自站内内容集合与 site.ts，不依赖任何外部接口，所以任何子页面看到的都一样。
import { getCollection } from 'astro:content';
import { SITE } from '../site';
import SidebarStatValue from './SidebarStatValue.jsx';

const posts = (await getCollection('posts')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);
const shots = (await getCollection('shots')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);
/* ---------- 站点统计 ---------- */
const tagSet = new Set<string>();
posts.forEach((p) => (p.data.tags ?? []).forEach((t: string) => tagSet.add(t)));
const wordCount = posts.reduce((n, p) => n + (p.body ?? '').replace(/\s/g, '').length, 0);
const sinceDate = new Date(`${SITE.since}-01-01T00:00:00`);
const runningDays = Math.max(1, Math.round((Date.now() - sinceDate.getTime()) / 86400000));
const stats = [
  { k: '博客', v: posts.length },
  { k: '截图', v: shots.length },
  { k: '标签', v: tagSet.size },
  // 字数超千显示成 1.8k：数值给 1.8、后缀给 k，动画只跑数字部分
  { k: '字数', v: wordCount > 999 ? Number((wordCount / 1000).toFixed(1)) : wordCount, suffix: wordCount > 999 ? 'k' : '' },
  { k: '运行', v: runningDays, suffix: ' 天' },
];
const lastActive = [...posts, ...shots]
  .map((e) => new Date(e.data.date).getTime())
  .sort((a, b) => b - a)[0];
const lastActiveStr = lastActive ? new Date(lastActive).toISOString().slice(0, 10) : '—';

/* ---------- 更新热力图：把「博客 / 截图 / 站点更新」按日期聚合成事件 ---------- */
type CalEvent = { kind: string; title: string; url?: string; note?: string };

const postEvents = posts.map((e) => ({
  date: new Date(e.data.date).toISOString().slice(0, 10),
  kind: '博客',
  title: e.data.title ?? '未命名文章',
  url: `/blog/#p-${e.id}`,
}));
const shotEvents = shots.map((e) => ({
  date: new Date(e.data.date).toISOString().slice(0, 10),
  kind: '截图',
  // 内容里的 title 是「2026-08-18 · MC」，点击后的日期面板本来按天分组，日期会重复；
  // 这里同样只留游戏名。
  title: e.data.game ?? '未命名截图',
  url: `/gallery/#${String(e.id).toUpperCase()}`,
}));
const logEvents = (await getCollection('changelog')).flatMap((e) =>
  (e.data.items ?? []).map((it) => ({
    date: new Date(e.data.date).toISOString().slice(0, 10),
    kind: it.kind || '更新',
    title: it.title,
    note: it.note || '',
  })),
);

// 日期 → 事件列表（新事件在前）
const byDay = new Map<string, CalEvent[]>();
[...postEvents, ...shotEvents, ...logEvents].forEach((ev) => {
  const list = byDay.get(ev.date) ?? [];
  list.push({ kind: ev.kind, title: ev.title, url: (ev as { url?: string }).url, note: (ev as { note?: string }).note });
  byDay.set(ev.date, list);
});

const pad = (n: number) => String(n).padStart(2, '0');
const now = new Date();
const y = now.getFullYear();
const m = now.getMonth();
const firstWeekday = new Date(y, m, 1).getDay(); // 0 = 周日
const daysInMonth = new Date(y, m + 1, 0).getDate();
const iso = (day: number) => `${y}-${pad(m + 1)}-${pad(day)}`;
const monthEvents = [...byDay.entries()].filter(([d]) => d.startsWith(`${y}-${pad(m + 1)}`));
const dayCount = new Map<string, number>(monthEvents.map(([d, list]) => [d, list.length]));
const kindCount = new Map<string, number>();
monthEvents.forEach(([, list]) => list.forEach((ev) => kindCount.set(ev.kind, (kindCount.get(ev.kind) ?? 0) + 1)));
const kindSummary = [...kindCount.entries()].sort((a, b) => b[1] - a[1]);

const cells: (number | null)[] = [
  ...Array.from({ length: firstWeekday }, () => null),
  ...Array.from({ length: daysInMonth }, (_, i) => i + 1),
];
const monthLabel = `${y} 年 ${m + 1} 月`;
const today = now.getDate();
const todayIso = `${y}-${pad(m + 1)}-${pad(today)}`;
const monthTotal = monthEvents.reduce((n, [, list]) => n + list.length, 0);

// 交给前端渲染当天明细（键为 ISO 日期）
const calData: Record<string, CalEvent[]> = {};
byDay.forEach((list, d) => {
  calData[d] = list;
});
const calJson = JSON.stringify(calData).replace(/</g, '\\u003c');

/* ---------- 最近更新（博客 + 截图混排）---------- */
const recent = [
  ...posts.map((e) => ({
    kind: '博客',
    title: e.data.title ?? '未命名文章',
    date: new Date(e.data.date).toISOString().slice(0, 10),
    url: `/blog/#p-${e.id}`,
  })),
  ...shots.map((e) => ({
    kind: '截图',
    // 截图的 title 内容里就是「2026-08-18 · MC」，而这一行的日期已单独显示（右侧），
    // 直接用它会让日期出现两遍；这里只留游戏名。
    title: e.data.game ?? '未命名截图',
    date: new Date(e.data.date).toISOString().slice(0, 10),
    url: `/gallery/#${String(e.id).toUpperCase()}`,
  })),
]
  .sort((a, b) => (a.date < b.date ? 1 : -1))
  .slice(0, 4); // 4 条刚好让右栏在常见视口高度内不超屏，两栏才能齐步吸顶

/* ---------- 活跃热力图（GitHub contributions 风格）----------
   近 26 周（半年）：列 = 周（旧 → 新），行 = 周一到周日；
   强度按当天事件数分 5 档（0–4），颜色用强调色的透明度阶梯，
   跟随色卡换色。有记录的格子可点开当天明细（沿用 data-cal-day 委托）。 */
const WEEKS = 26;
const dayMs = 86400000;
const today0 = new Date();
today0.setHours(12, 0, 0, 0); // 用正午避开夏令时/时区边界
// 结束于「本周」，起始为 WEEKS 周前的那一周的周日
const end = new Date(today0);
const start = new Date(today0.getTime() - (WEEKS * 7 - 1) * dayMs);
start.setDate(start.getDate() - start.getDay()); // 回退到周日

type HeatCell = { iso: string; day: number; count: number; future: boolean; level: number };
const heatCells: HeatCell[] = [];
const heatMonths: { col: number; label: string }[] = [];
let lastMonthSeen = -1;

for (let i = 0; i < WEEKS * 7; i++) {
  const d = new Date(start.getTime() + i * dayMs);
  const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  const col = Math.floor(i / 7);
  const future = d.getTime() > today0.getTime();
  const count = future ? 0 : (byDay.get(key) ?? []).length;
  const level = count === 0 ? 0 : count === 1 ? 1 : count === 2 ? 2 : count === 3 ? 3 : 4;
  heatCells.push({ iso: key, day: d.getDay(), count, future, level });
  // 月份标签：每月第一次出现的列
  if (d.getDate() <= 7 && lastMonthSeen !== d.getMonth() && col < WEEKS) {
    heatMonths.push({ col, label: `${d.getMonth() + 1}月` });
    lastMonthSeen = d.getMonth();
  }
}
const heatTotal = heatCells.reduce((n, c) => n + c.count, 0);
// 网格按「列=周、行=周几」排：CSS grid 按 column 流式填充
const heatGridCells = [];
for (let r = 0; r < 7; r++) {
  for (let col = 0; col < WEEKS; col++) {
    heatGridCells.push(heatCells[col * 7 + r]);
  }
}

/* ---------- 今日一言（本地静态，按日期轮换）---------- */
const QUOTES = [
  { t: '学而不思则罔，思而不学则殆。', by: '《论语》' },
  { t: '不积跬步，无以至千里。', by: '《荀子》' },
  { t: '把每一次练习，都变成一条可追溯的档案。', by: SITE.title },
  { t: '知不足，然后能自反也。', by: '《礼记》' },
  { t: '纸上得来终觉浅，绝知此事要躬行。', by: '陆游' },
  { t: '工欲善其事，必先利其器。', by: '《论语》' },
  { t: '博观而约取，厚积而薄发。', by: '苏轼' },
];
const dayIndex = Math.floor(Date.now() / 86400000);
const quote = QUOTES[dayIndex % QUOTES.length];
---

<aside class="shell-right">
  <!-- 站点统计 -->
  <section class="sidecard">
    <h2>STATS / 站点统计</h2>
    <ul class="sw-stats">
      {stats.map((s) => (
        <li>
          <span class="k">{s.k}</span>
          {/* 排查开关：暂时输静态文本，隔离 React #424 是否来自本岛 */}
          <SidebarStatValue client:idle value={s.v} suffix={s.suffix ?? ''} />
        </li>
      ))}
    </ul>
    <p class="sw-last">最后更新 · {lastActiveStr}</p>
  </section>

  <!-- 更新热力图：GitHub contributions 风格；有记录的日子可点，展开当天「做了什么」 -->
  <section class="sidecard sw-cal-card">
    <h2>ACTIVITY / 活跃热力图</h2>
    <p class="sw-month">
      近 {WEEKS} 周
      {heatTotal > 0 && <span class="sw-month-n">{heatTotal} 条更新</span>}
    </p>

    <div class="sw-heat" role="group" aria-label={`近 ${WEEKS} 周活跃热力图，有记录的日期可点开查看`}>
      <div class="heat-months" aria-hidden="true">
        {heatMonths.map((mo) => (
          <span class="hm" style={`grid-column:${mo.col + 1}`}>{mo.label}</span>
        ))}
      </div>
      <div class="heat-wrap">
        <div class="heat-wd" aria-hidden="true">
          {['', '一', '', '三', '', '五', ''].map((d, i) => (
            <span class="hwd" style={`grid-row:${i + 1}`}>{d}</span>
          ))}
        </div>
        <div class="heat-grid" style={`--weeks:${WEEKS}`}>
          {heatGridCells.map((c) => {
            if (!c || c.future) return <span class="hc future" />;
            const list = byDay.get(c.iso) ?? [];
            const names = list.map((ev) => `${ev.kind}：${ev.title}`).join('；');
            return c.count > 0 ? (
              <button
                type="button"
                class:list={['hc', `lv${c.level}`, { today: c.iso === todayIso }]}
                data-cal-day={c.iso}
                aria-label={`${c.iso} · ${c.count} 条记录`}
                title={`${c.iso} · ${c.count} 条\n${names}`}
              />
            ) : (
              <span class:list={['hc', `lv${c.level}`, { today: c.iso === todayIso }]} title={c.iso} />
            );
          })}
        </div>
      </div>
      <p class="heat-legend" aria-hidden="true">
        <span class="hl-t">少</span>
        {[0, 1, 2, 3, 4].map((lv) => <i class:list={['hc', `lv${lv}`, 'sm']}/>)}
        <span class="hl-t">多</span>
      </p>
    </div>

    <p class="sw-cal-hint" data-cal-hint>点格子看当天做了什么</p>

    <div class="sw-cal-panel" data-cal-panel hidden>
      <p class="sw-cal-panel-head">
        <span data-cal-title>—</span>
        <button type="button" class="sw-cal-close" data-cal-close aria-label="收起当天记录">收起</button>
      </p>
      <ul class="sw-cal-list" data-cal-list></ul>
    </div>
    <script type="application/json" data-cal-data set:html={calJson} />
  </section>

  <!-- 最近更新 -->
  <nav class="sidecard" aria-label="最近更新">
    <h2>RECENT / 最近更新</h2>
    <ul class="recent-list">
      {recent.map((r) => (
        <li>
          <a href={r.url} aria-current={r.url === Astro.url.pathname ? 'page' : undefined} title={`${r.kind} · ${r.title}`}>
            <span class="rc-kind">{r.kind}</span>
            <span class="rc-title">{r.title}</span>
            <span class="rc-date">{r.date}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- 今日一言 -->
  <section class="sidecard sw-quote">
    <h2>QUOTE / 今日一言</h2>
    <blockquote>{quote.t}</blockquote>
    <p class="sw-by">—— {quote.by}</p>
  </section>
</aside>
