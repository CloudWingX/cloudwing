---
// 全站背景视频（fixed 铺满视口，位于所有内容之下）。
//
// ★跨页不重建★：外层带 `transition:persist="video-bg"`。
//   Astro 的 ClientRouter 在软导航时是用 `data-astro-transition-persist` 匹配元素的
//   （见 astro/dist/transitions/swap-functions.js），没有这属性的元素会被整棵换掉 ——
//   视频就会**重新建一个 <video>、readyState 归零、重新起播**，
//   表现就是"一切换页面视频就闪一下/像失效了"（实测：seq 1→2、readyState 4→0）。
//   加上 persist 后是同一个节点被搬过去，播放位置连续、不重新加载。
//
// 层次（z-index，见 global.css 的「背景层次」注释）：
//   body 底色渐变        最底
//   .video-bg          -4   视频本体 + 遮罩（半透明，让底色透上来）
//   .grid-bg           -2   原有漂移光晕（保留，叠在视频之上）
//   .pparticles-layer  -1   原有粒子（保留，叠在视频之上）
//   内容 / 导航栏        0+
//
// 健壮性：prefers-reduced-motion 只显示首帧；自动播放被拦时保持首帧；
// 标签页切后台暂停。
import { VIDEO_BG } from '../site';
const on = Boolean(VIDEO_BG.src);
---
{
  on && (
    <div
      class="video-bg"
      transition:persist="video-bg"
      aria-hidden="true"
      style={`--vid-opacity-dark:${VIDEO_BG.opacityDark};--vid-opacity-light:${VIDEO_BG.opacityLight};--vid-dim:${VIDEO_BG.dim};`}
    >
      <video
        class="video-bg__el"
        src={VIDEO_BG.src}
        poster={VIDEO_BG.poster || undefined}
        autoplay
        loop
        muted
        playsinline
        preload="metadata"
        disablepictureinpicture
        tabindex="-1"
      ></video>
      {/* 强调色预设的色膜：给整个画面（含视频）换色调，**不替换背景**。
          颜色/浓度由 --tint-c / --tint-a 控制，默认 0 = 不着色。 */}
      <span class="tint-layer" aria-hidden="true"></span>
    </div>
  )
}
<style>
  .video-bg {
    position: fixed;
    inset: 0;
    /* -4：压在页面底色之上、原有光晕(-2)/粒子(-1) 之下 */
    z-index: -4;
    pointer-events: none;
    overflow: hidden;
    /* 降级底：视频没 load 出来之前 / 加载失败时显示的静态底色。
       ★2026-09-18 三轮修正（关键）★：这里原来还叠了一张 `bg-poster.jpg` 静帧 +
       一层偏亮的 radial 渐变。它们**在 video 之下**，而 video 是半透明的 ——
       于是"兜底底图"会透过 video 一起参与合成，把画面洗成一块高亮青色：
       实测标题正后方 rgb(115,174,195)，白字对比只有 2.45（需 3 / 副标题 4.5）。
       这也解释了为什么"调 video 的 opacity 反而更亮"（越低越露出亮底图）。
       现在只留**纯粹的深色底**（与页面 --bg-deep 同族），video 叠在它上面：
       实测同样位置 rgb(7,27,36)、对比 17+，而且再也不用靠遮罩层压高光。
       ⚠️ 不要再把 poster / 亮渐变加回这一层；要"兜底好看"应该另开一层放在 video 之上
       （但那就又变成"盖在内容上的薄膜"了，用户已经明确不要）。 */
    background: #05080c;
  }
  /* 视频加载失败：藏掉 <video>，只留上面的渐变/静帧兜底 */
  .video-bg.is-failed .video-bg__el { visibility: hidden; }
  /* 视频本身**半透明**：让它像一层"会动的纹理"叠在页面底色下面。
     这样页面底色仍是主调，浅色主题的深色文字 / 深色主题的浅色文字
     都继续成立 —— 不需要为了放视频去改任何文字颜色。
     浓度由 site.ts 的 VIDEO_BG.opacity* 控制。 */
  .video-bg__el {
    width: 100%;
    height: 100%;
    object-fit: cover; /* 任意画幅都铺满视口，不留黑边 */
    opacity: var(--vid-opacity-dark, 0.45);
    /* 强调色预设对背景视频做"色相旋转"（改颜色，不改背景本身）：
       视频文件/透明度/遮罩/层级都不动，只是整体转色相，
       这样"余烬"之类的暖色预设才能让画面真的变暖，且与强调色同族。 */
    filter: hue-rotate(var(--vid-hue, 0deg)) saturate(var(--vid-sat, 1)) brightness(var(--vid-dim, 1));
    transition: filter 0.2s linear; /* 实际过渡由脚本补间变量完成，这里防首帧跳变 */
  }
  @media (prefers-reduced-motion: reduce) {
    .video-bg__el { transition: none; }
  }
  /* 视频一旦能出画，就淡入 —— 避免加载瞬间的"跳一下"。
     没加 has-poster 时（组件未接管）保持可见，避免万一脚本失效导致视频被永久藏住。 */
  .video-bg.has-poster:not(.is-playing) .video-bg__el { opacity: 0; }
  .video-bg__el { transition: opacity 0.6s var(--ease, ease); }
  /* ★★ 这里曾经有一层 `.video-bg::after` 遮罩（上浅下深的黑色渐变）—— 已整块删除
     （2026-09-18 三轮；用户连续三轮指出"标题后方的黑色矩形"→"首页两边有瑕疵"→
     "在导航栏和主容器两侧能看见边缘"）★★
     它原本的作用是压住素材高光、保证白字对比度。但**只要在内容层之上再盖一层东西，
     无论多浓多淡都会被看出来**，三轮都在为它返工。
     **正解：压暗要压在被压对象自己的图层里** —— 现在用：
       · `src/site.ts` 的 `VIDEO_BG.dim` → `.video-bg__el` 的 `filter: brightness()`（视频自身）；
       · `.video-bg` 的兜底底改成纯深色 `#05080c`（原来是 poster 静帧 + 亮渐变，
         它们在半透明 video **之下**，会把画面整体洗亮 —— 见上面 `.video-bg` 的注释）；
       · 副标题 `.hero-subtitle` 的白度 .7 → .92。
     ⚠️ `VIDEO_BG.scrimTop/Mid/Bottom/Light` 四个令牌已废弃（仅保留字段），**不要接回样式**。
     ⚠️ 以后若还想加"薄膜"，先读 HANDOFF §36.2/§36.3：两次同源事故都出在"只铺在容器盒里"。 */

  /* 兜底：万一切到浅色态（本设计只提供暗色，这里仅为防御） */
  /* ── 强调色预设的"整页颜色滤镜" ──
     一层纯色 + 混合模式，给整个画面（含背景视频）换色调，
     **视频本身不动**（不改 src/opacity/遮罩，符合"不要更换背景"）。
     颜色与浓度由 --tint-c / --tint-a 驱动，首页的色卡按钮会给这两个变量补间，
     过渡时就会经过中间色。--tint-a 默认 0 = 完全不着色（默认态与之前一模一样）。
     放在 .video-bg 之后、与视频同层：视觉效果是"画面整体偏色"，不是盖一层灰。 */
  .tint-layer {
    position: fixed;
    inset: 0;
    z-index: -3; /* 视频(-4) 之上、光晕(-2)/粒子(-1) 之下 */
    pointer-events: none;
    background: var(--tint-c, #9fd3e8);
    mix-blend-mode: color;
    opacity: var(--tint-a, 0);
    transition: opacity 0.2s linear; /* 首帧不闪；补间由脚本负责 */
  }
  @media (prefers-reduced-motion: reduce) {
    .tint-layer { transition: none; }
  }
</style>

<script>
  // 背景视频的健壮性处理（幂等标记挂在元素上：软导航是同一个节点，不会重复绑定）。
  // 状态类都加在 .video-bg 上：
  //   has-poster  组件已接管 → 未出画前藏住 <video>，露出深色渐变/静帧兜底（不闪白）
  //   is-playing  能出画了 → 淡入
  //   is-failed   加载/解码失败 → 藏掉 <video>，只留兜底底图（降级）
  //   is-paused   用户手动暂停 → 保持首帧，页面照常阅读
  function initVideoBg() {
    var v = document.querySelector('.video-bg__el');
    var wrap = document.querySelector('.video-bg');
    if (!v || !wrap || v.__cwWired) return;
    v.__cwWired = true;
    wrap.classList.add('has-poster'); // 由脚本接管淡入（脚本没跑时视频保持可见，不会永久隐藏）

    var playing = function () { wrap.classList.add('is-playing'); wrap.classList.remove('is-failed'); };

    // 减少动态：只显示首帧，不播放
    var rm = window.matchMedia('(prefers-reduced-motion: reduce)');
    var userPaused = false;

    var apply = function () {
      if (rm.matches || userPaused) {
        v.pause();
        if (rm.matches) v.autoplay = false;
        playing(); // 暂停也要显示画面（首帧）
        return;
      }
      var p = v.play();
      if (p && typeof p.catch === 'function') {
        p.then(playing).catch(function () { playing(); }); // 被拦也显示首帧
      } else playing();
    };

    // 能出画了就显示
    v.addEventListener('loadeddata', playing);
    v.addEventListener('canplay', playing);
    if (v.readyState >= 2) playing();
    // 失败降级：藏掉视频，页面用深色渐变 + 静帧兜底
    v.addEventListener('error', function () { wrap.classList.add('is-failed'); });
    // 兜底：若 8 秒后仍没出画，也亮出画面（避免一直空白）
    setTimeout(playing, 8000);

    apply();
    if (rm.addEventListener) rm.addEventListener('change', apply);

    // 标签页切到后台时暂停，省电省流量
    document.addEventListener('visibilitychange', function () {
      if (document.hidden) v.pause();
      else apply();
    });

    // 供导航栏的「暂停动态」按钮调用（可访问性要求：提供暂停入口）
    window.__cwVideoToggle = function () {
      userPaused = !userPaused;
      apply();
      return userPaused;
    };
    window.__cwVideoPaused = function () { return userPaused || rm.matches; };
  }
  initVideoBg();
  document.addEventListener('astro:page-load', initVideoBg);
</script>
