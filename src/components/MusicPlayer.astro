---
// 左侧栏底部「音乐播放器」。
//   歌曲列表来自 site.ts 的 MUSIC（§67 起为真实曲目）。
//   交互逻辑在 src/scripts/ui.js 的 musicPlayer()：document 事件委托 + window 单例，
//   软导航换页后依然有效（侧栏会被重建，委托不受影响）。
//   歌词：点「词」按钮在播放器下方弹出歌词面板；.lrc 按约定路径
//   /music/lyrics/<id>.lrc 自动加载（零配置），纯音乐曲目显示「纯音乐」。
import { MUSIC } from '../site';

const tracks = MUSIC.map((t, i) => ({ ...t, index: i }));
const hasTracks = tracks.length > 0;
// 曲目数据以 | 分隔写进 data-*，供 ui.js 的 musicPlayer() 读取（避免在 ui.js 里再引一份配置）。
const join = (fn: (t: (typeof tracks)[number]) => string) => tracks.map(fn).join('|');
---
<section
  class="sidecard music-card"
  data-music
  data-music-count={tracks.length}
  data-music-ids={join((t) => t.id)}
  data-music-srcs={join((t) => t.src)}
  data-music-titles={join((t) => t.title)}
  data-music-artists={join((t) => t.artist || '未知作者')}
  data-music-inst={join((t) => (t.instrumental ? '1' : ''))}
  aria-label="音乐播放器"
>
  <h2>MUSIC / 音乐</h2>

  {
    hasTracks ? (
      <>
        <p class="mu-title" data-mu-title>{tracks[0].title}</p>
        <p class="mu-artist" data-mu-artist>{tracks[0].artist || '未知作者'}</p>

        <div class="mu-bar" data-mu-bar role="slider" aria-label="播放进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" tabindex="0">
          <span class="mu-fill" data-mu-fill />
        </div>

        <p class="mu-time"><span data-mu-cur>0:00</span><span data-mu-dur>--:--</span></p>

        <div class="mu-ctrl">
          <button type="button" class="mu-btn" data-mu-prev aria-label="上一首" title="上一首">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 5v14M6 12l8-7M6 12l8 7" />
            </svg>
          </button>
          <button type="button" class="mu-btn mu-play" data-mu-toggle aria-label="播放" title="播放 / 暂停">
            <svg class="mu-ico-play" viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" /></svg>
            <svg class="mu-ico-pause" viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M7.5 5h3.2v14H7.5zM13.3 5h3.2v14h-3.2z" /></svg>
          </button>
          <button type="button" class="mu-btn" data-mu-next aria-label="下一首" title="下一首">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 5v14M18 12L10 5M18 12l-8 7" />
            </svg>
          </button>
          <button
            type="button"
            class="mu-btn mu-lybtn"
            data-mu-lyrics
            aria-label="歌词"
            aria-expanded="false"
            title="歌词"
          >
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 5h16M4 10h16M4 15h10" />
            </svg>
          </button>
          <span class="mu-no" data-mu-no>01 / {String(tracks.length).padStart(2, '0')}</span>
        </div>

        <!-- 歌词面板：默认收起，点「词」展开；内容与高亮由 ui.js 的 musicPlayer() 接管 -->
        <div class="mu-lyrics" data-mu-lyrics-panel hidden>
          <div class="mu-lyrics-inner" data-mu-lyrics-inner></div>
        </div>
      </>
    ) : (
      <>
        <div class="mu-empty">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 18V6l10-2v12" />
            <circle cx="6.5" cy="18" r="2.5" />
            <circle cx="16.5" cy="16" r="2.5" />
          </svg>
          <span>歌曲待添加</span>
        </div>
        <p class="mu-hint">把音频放进 <code>public/music/</code>，再到 <code>src/site.ts</code> 的 <code>MUSIC</code> 里加一条即可。</p>
      </>
    )
  }
</section>
