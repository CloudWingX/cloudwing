---
/* ============================================================
   顶部导航 —— 按 reference（code_20260918.html）像素级复刻形态
   · 几何/间距/断点/过渡全部照参考：1300→1140、64→56、32→24、
     0→999px 圆角、gap 32→24、按钮 8px→9999px
     （2026-09-22 晚容器放宽：未滚动 1300→1600、滚动后 1140→1440，
      与 global.css 的 --w-max = 1600 对齐，见下方 .site-header 的注释）
   · 强调色保留站点雾蓝（--accent），不用参考里的紫/粉/红
   · 按用户要求去掉导航里的搜索入口（悬浮窗仍可由 ⌘/Ctrl+K 打开）
   · 保留站点功能：品牌标志、移动端 StaggeredMenu 抽屉（≤768px）、二级菜单数据
   ============================================================ */
import { SITE, NAV } from '../site';
import { getCollection } from 'astro:content';
import BrandMark from './BrandMark.astro';

const { current = '/' } = Astro.props;
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);

/* 父项高亮口径：路由落在自己**或任一 child** 上时都算当前
   （/blog/ /log/ 不再是顶栏一级项，高亮要落到「记录」上）。 */
const isActiveGroup = (item: (typeof NAV)[number]) =>
  isActive(item.href) || (item.children ?? []).some((c) => isActive(c.href));

/* 显示名微调（历史口径）：作品库→作品、关于→档案 */
const showLabel = (l: string) => l.replace(/作品库$/, '作品').replace(/^关于$/, '档案');

/* ---------- 各子页面的分类 → 对应导航项的二级菜单（移动端菜单里用） ----------
   画廊的分类 = 截图所属游戏（game）。由内容集合现算，新增截图后菜单自动更新。
   （作品库已于 2026-09-19 移除，博客归档页无二级分类。） */
const shotsAll = await getCollection('shots');

const countBy = (list: string[]) => {
  const m = new Map<string, number>();
  list.forEach((k) => k && m.set(k, (m.get(k) ?? 0) + 1));
  return [...m.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh'));
};
const shotGames = countBy(shotsAll.map((e) => e.data.game ?? ''));
const SUBS: Record<string, { label: string; href: string }[]> = {
  '/gallery/': shotGames.map(([g]) => ({ label: g, href: `/gallery/?game=${encodeURIComponent(g)}` })),
};

const items = NAV.map((item) => ({ ...item, sub: SUBS[item.href] ?? [] }));

/* 参考导航右侧是「Star on GitHub · 47.5K」+「Get Pro」。
   本站映射为：GitHub（带真实 star 数）+ Bilibili（站点真实入口）。 */
let stars: string | null = null;
try {
  const r = await fetch('https://api.github.com/repos/CloudWingX/cloudwing', {
    headers: { 'user-agent': 'cloudwing-build' },
    signal: AbortSignal.timeout(4000),
  });
  if (r.ok) {
    const j = await r.json();
    const n = Number(j.stargazers_count);
    if (Number.isFinite(n) && n > 0) stars = n >= 1000 ? `${(n / 1000).toFixed(1)}K` : String(n);
  }
} catch {
  /* 离线或限流：不显示数字，只显示 "GitHub" */
}
---

<header class="site-header" data-nav>
  <div class="header-container">
    <a class="logo" href="/" aria-label={`${SITE.title} · 回到首页`}>
      {/* 站点的横版品牌字标（云 + 羽翼 + CLOUDWING）就是本站的 wordmark，
          对应参考里 "React Bits" 那个位置；高度与参考一致（20px / 滚动后 18px）。 */}
      <BrandMark variant="horizontal" height={20} />
    </a>

    <ul class="nav-links">
      {
        items.map((item) =>
          item.children ? (
            <li class="has-sub">
              <a
                href={item.href}
                aria-haspopup="true"
                aria-expanded="false"
                aria-current={isActiveGroup(item) ? 'page' : undefined}
              >
                {showLabel(item.label)}
                <svg class="caret" viewBox="0 0 10 6" aria-hidden="true">
                  <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
              <ul class="nav-sub" data-nav-sub>
                {item.children.map((c) => (
                  <li>
                    <a href={c.href} aria-current={isActive(c.href) ? 'page' : undefined}>
                      {showLabel(c.label)}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {showLabel(item.label)}
              </a>
            </li>
          )
        )
      }
    </ul>

    <div class="nav-actions">
      {
        SITE.github && (
          <a class="btn btn-github" href={SITE.github} target="_blank" rel="noreferrer" title="Star on GitHub">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.11.81 2.25 0 1.635-.015 2.955-.015 3.36 0 .315.225.69.825.57C20.565 21.795 24 17.31 24 12c0-6.63-5.37-12-12-12z"></path>
            </svg>
            <span>Star on GitHub{stars ? ` · ${stars}` : ''}</span>
          </a>
        )
      }
      {SITE.bilibili && <a class="btn btn-pro" href={SITE.bilibili} target="_blank" rel="noreferrer">Bilibili</a>}
      {/* ★「暂停背景动态」按钮已于 2026-09-18 按用户要求删除：背景视频默认播放，
          不再提供手动暂停入口（减少动态的可访问性需求仍由 prefers-reduced-motion 兜住，
          见 VideoBackground.astro）。 */}
      {/* ── 移动端开关（StaggeredMenu 形态，2026-09-23）：「菜单/关闭」文字滚动 + 加号图标旋转。
          桌面端 display:none，与旧汉堡一样只在 ≤768px 出现；data-mnav-toggle 契约不变。 ── */}
      <button
        type="button"
        class="sm-toggle"
        data-mnav-toggle
        aria-label="打开菜单"
        aria-expanded="false"
        aria-controls="cw-side-menu"
      >
        <span class="sm-tw" aria-hidden="true">
          <span class="sm-ti" data-mnav-text><span>菜单</span></span>
        </span>
        <span class="sm-icon" aria-hidden="true">
          <span class="sm-line-h"></span>
          <span class="sm-line-v"></span>
        </span>
      </button>
    </div>
  </div>

  {/* ── 移动端抽屉（StaggeredMenu 形态，2026-09-23）：右侧全高滑入 + 双色错峰前导层 +
      条目错峰入场 + 序号。仅 ≤768px 渲染作用（桌面端 display:none 兜底）。
      保留 data-mnav-panel / hidden / is-open 契约，动画由 nav-mobile.js 的 gsap 驱动。 ── */}
  <div id="cw-side-menu" class="sm-drawer" data-mnav-panel hidden>
    <div class="sm-prelayers" aria-hidden="true">
      <div class="sm-prelayer sm-pl-b"></div>
      <div class="sm-prelayer sm-pl-a"></div>
    </div>
    <aside class="sm-panel" aria-label="站点菜单">
      <ul class="sm-list">
        {
          items.map((item) =>
            item.children ? (
              <li class="sm-item has-sub">
                <a
                  class="sm-link"
                  href={item.href}
                  aria-expanded="false"
                  aria-current={isActiveGroup(item) ? 'page' : undefined}
                >
                  <span class="sm-label">{showLabel(item.label)}</span>
                  <svg class="caret" viewBox="0 0 10 6" aria-hidden="true">
                    <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
                <div class="sm-sub">
                  {item.children.map((c) => (
                    <a href={c.href} aria-current={isActive(c.href) ? 'page' : undefined}>
                      {showLabel(c.label)}
                    </a>
                  ))}
                </div>
              </li>
            ) : (
              <li class="sm-item">
                <a class="sm-link" href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  <span class="sm-label">{showLabel(item.label)}</span>
                </a>
              </li>
            )
          )
        }
      </ul>
      {/* 一级 6 项 +「记录」组内 4 个子链接 = 10 个 <a>（verify-nav-shrink 断言同步）。 */}
    </aside>
  </div>
</header>

<style>
  /* ============================================================
     导航令牌（几何取自参考实测值）
     未滚动：max-w 1600 / h 64 / pad 32 / radius 0
     滚动后：max-w 1440 / h 56 / pad 24 / radius 999 / 玻璃加深
     ⚠️ 未滚动的 1600 必须与 global.css 的 --w-max 同步：那是"主内容容器盒宽"
        （header / main / footer 三者一致），导航内部的左右内边距比 .wrap 小
        （32 vs 52），所以是"同一容器宽、同一左缘、内容各自内缩"，不是窄一圈。
        2026-09-22 晚：--w-max 1300 → 1600（宽屏放宽），未滚动同步改；
        滚动后保持 160 收缩差：1140 → 1440（1300 时代是 1300−160=1140）。
     ============================================================ */
  .site-header {
    --nav-w: 1600px;
    --nav-w-scrolled: 1440px;
    --nav-h: 64px;
    --nav-h-scrolled: 56px;
    --nav-pad-x: 32px;
    --nav-pad-x-scrolled: 24px;
    --nav-top: 0px;
    --nav-top-scrolled: 16px;
    --nav-radius: 0px;
    --nav-radius-scrolled: 9999px;
    --nav-bg: transparent;
    --nav-bg-scrolled: rgba(10, 10, 15, 0.7);
    --nav-border: transparent;
    --nav-border-scrolled: rgba(255, 255, 255, 0.08);
    --nav-shadow: none;
    --nav-shadow-scrolled: 0 4px 20px rgba(0, 0, 0, 0.15);
    --nav-blur: none;
    --nav-blur-scrolled: blur(12px) saturate(180%);
    --nav-ink: #ffffff;
    --nav-ink-muted: rgba(255, 255, 255, 0.7);
    --nav-ink-dim: rgba(255, 255, 255, 0.5);
    --nav-hover-bg: rgba(255, 255, 255, 0.05);
    --nav-link-fs: 14px;
    --nav-link-fs-scrolled: 14px;
    --nav-link-gap: 32px;
    --nav-link-gap-scrolled: 24px;
    --nav-ctl-fs: 13px;
    --nav-ctl-fs-scrolled: 12px;
    --nav-ctl-gap: 12px;
    --nav-ctl-gap-scrolled: 8px;
    --nav-ctl-pad: 8px 16px;
    --nav-ctl-pad-scrolled: 6px 14px;
    --nav-ctl-radius: 8px;
    --nav-ctl-radius-scrolled: 9999px;
    --nav-ease: cubic-bezier(0.4, 0, 0.2, 1);
    --nav-drawer-bg: rgba(10, 10, 15, 0.95);

    /* position:fixed（与参考一致）—— 导航不占文档流，Hero 从 y=0 开始，
       正是参考里 hero.getBoundingClientRect().y === 0 的成因。
       子页面内容由 .shell 的 padding-top 让位（见 shell.css）。 */
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 70;
    /* 只留纵向 padding：横向留白放到 .header-container 上。
       原因：父层的横向 padding 会让子元素 max-width:100% 解析成"父层内容宽"
       （实测 1024 下容器只有 911.6 而不是 1009），参考是满宽容器。 */
    padding: var(--nav-top) 0 0;
    /* 站点全局 body 是 line-height:1.8，会把导航撑高（实测 64→71）；
       参考用的是 normal，这里显式跟随，保证容器高度就是 --nav-h。 */
    line-height: normal;
    transition: padding-top 0.4s var(--nav-ease);
  }

  /* ── 容器条 ──
     ⚠️ max-width 必须写字面 px：写成 var(--nav-w) 时 Astro 的作用域编译会把它
     变成 `calc(0.1066% + 1278.64px)`，在带 padding 的父层下算不到目标值。
     所以 --nav-w / --nav-w-scrolled 只是"记着真值"的注释性令牌，
     下面两处 max-width 必须与它们（以及 global.css 的 --w-max）**手工保持同步**。
     脚本会兜底：verify-nav-shrink.mjs 断言 1600/1440，
     并断言"导航容器与主内容容器同宽、同左缘"。 */
  .header-container {
    position: relative; /* 不设 z-index：抽屉（67）要盖住导航条，仅开关靠自身 z-68 浮出 */
    box-sizing: border-box;
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    /* 窄于 max-width 时由 margin 撑开左右留白（等价于参考的 padding 效果），
       宽于 max-width 时用 padding 让内容与页面栅格对齐 */
    padding: 0 var(--nav-pad-x);
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    line-height: normal; /* 参考值；站点全局 1.8 会把 64px 的条撑成 71px */
    border-radius: var(--nav-radius);
    background: var(--nav-bg);
    border: 1px solid var(--nav-border);
    box-shadow: var(--nav-shadow);
    /* ⚠️ -webkit- 必须写在标准属性之前（否则构建压缩会整条丢掉，见 HANDOFF §22） */
    -webkit-backdrop-filter: var(--nav-blur);
    backdrop-filter: var(--nav-blur);
    transition:
      max-width 0.4s var(--nav-ease),
      height 0.4s var(--nav-ease),
      padding 0.4s var(--nav-ease),
      border-radius 0.4s var(--nav-ease),
      background 0.4s var(--nav-ease),
      border-color 0.4s var(--nav-ease),
      box-shadow 0.4s var(--nav-ease),
      backdrop-filter 0.4s var(--nav-ease);
  }

  /* ── 左侧品牌 ── */
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 500;
    line-height: 20px; /* 固定行高：站点全局 1.8 会把容器撑高 */
    color: var(--nav-ink);
    text-decoration: none;
    flex: none;
    transition: font-size 0.4s var(--nav-ease), gap 0.4s var(--nav-ease);
  }
  .logo :global(.brandmark) { display: block; flex: none; height: 20px; width: auto; transition: height 0.4s var(--nav-ease); }
  .logo-name { white-space: nowrap; }

  /* ── 中间链接组 ── */
  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--nav-link-gap);
    list-style: none;
    margin: 0;
    padding: 0;
    line-height: 20px;
    transition: gap 0.4s var(--nav-ease);
  }
  .nav-links a {
    position: relative;
    display: inline-block;
    color: var(--nav-ink-muted);
    text-decoration: none;
    font-size: var(--nav-link-fs);
    font-weight: 400;
    line-height: 20px;
    white-space: nowrap;
    transition: color 0.2s ease, font-size 0.4s var(--nav-ease);
  }
  .nav-links a:hover { color: var(--nav-ink); }
  .nav-links a[aria-current='page'] { color: var(--nav-ink); }
  /* 当前页/悬停的下划线：只落在**一级**链接上（下拉里的当前页用强调色文字，不加横线） */
  .nav-links > li > a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 1px;
    background: var(--accent);
  }

  /* ── 「记录」悬停下拉（2026-09-19 晚，站长要求）──
     桌面 hover 浮出 + 键盘 focus-within 兜底；玻璃材质与抽屉同源。 */
  .nav-links li.has-sub { position: relative; }
  .nav-links .has-sub > a { display: inline-flex; align-items: center; gap: 5px; }
  .nav-links .has-sub .caret {
    width: 10px;
    height: 6px;
    flex: none;
    opacity: 0.7;
    transition: transform 0.25s var(--nav-ease), opacity 0.2s ease;
  }
  .nav-links li.has-sub:hover .caret,
  .nav-links li.has-sub:focus-within .caret { transform: rotate(180deg); opacity: 1; }
  .nav-sub {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    transform: translate(-50%, -6px);
    min-width: 132px;
    margin: 0;
    padding: 8px;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: rgba(10, 10, 15, 0.92);
    border: 1px solid var(--nav-border-scrolled);
    border-radius: 14px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
    /* ⚠️ -webkit- 必须写在标准属性之前（构建压缩会丢后写的重复声明，见 HANDOFF §22） */
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    backdrop-filter: blur(20px) saturate(180%);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.25s var(--nav-ease),
      transform 0.25s var(--nav-ease),
      visibility 0.25s;
    z-index: 5;
  }
  /* hover 桥：链接与面板之间留了 12px 缝隙，这块透明垫片防止移过去时菜单收回 */
  .nav-sub::before {
    content: '';
    position: absolute;
    left: -14px;
    right: -14px;
    top: -12px;
    height: 12px;
  }
  .nav-links li.has-sub:hover > .nav-sub,
  .nav-links li.has-sub:focus-within > .nav-sub {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }
  /* 点击展开态（2026-09-20）：父项 a 不再跳转，nav-mobile.js 给 li 加 .open 钉住菜单；
     与 hover 同款展开，二者叠加互不干扰（hover 移开时 .open 仍保持）。 */
  .nav-links li.has-sub.open .caret { transform: rotate(180deg); opacity: 1; }
  .nav-links li.has-sub.open > .nav-sub {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }
  .nav-sub a {
    display: block;
    padding: 8px 12px;
    border-radius: 8px;
    color: var(--nav-ink-muted);
    text-decoration: none;
    font-size: 14px;
    line-height: 20px;
    white-space: nowrap;
    transition: color 0.2s ease, background 0.2s ease;
  }
  .nav-sub a:hover { color: var(--nav-ink); background: rgba(255, 255, 255, 0.06); }
  .nav-sub a[aria-current='page'] { color: var(--accent); }

  /* ── 右侧动作组 ── */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: none;
  }
  .btn {
    box-sizing: border-box; /* 少了这条 height 会被 padding 撑到 44px（实测） */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 34px;
    padding: var(--nav-ctl-pad);
    border: none;
    border-radius: var(--nav-ctl-radius);
    font-size: var(--nav-ctl-fs);
    font-weight: 500;
    line-height: 1;
    letter-spacing: normal;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.3s var(--nav-ease);
    /* 站点 global.css 在 ≤640px 给 .btn 加了 min-height:44px（Apple HIG 触控规则），
       会把手机端导航从 64px 撑到 44px 高的按钮行。参考在手机端仍是紧凑条，
       导航的触控面积由整条导航保证，所以这里显式取消那条规则。 */
    min-height: 0;
  }
  .btn-github {
    background: var(--nav-hover-bg);
    border: 1px solid var(--nav-border-scrolled);
    color: var(--nav-ink);
  }
  .btn-github:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.15);
  }
  .btn-github svg { width: 16px; height: 16px; flex: none; transition: width 0.4s var(--nav-ease), height 0.4s var(--nav-ease); }
  /* 「Get Pro」→ 站点 Bilibili 入口：用品牌强调色做底（不用参考的紫粉红渐变）。
     参考里 .btn-pro 是 32px 高（比 GitHub 那颗矮 2px），这里照做。
     ⚠️ 底色必须**不透明**：半透明的 accent 压在暗色视频上会合成成近黑，
     深色文字对比度只剩 1:1（contrast-audit 抓到过）。 */
  .btn-pro {
    height: 32px;
    background: var(--accent);
    color: #0a0a0f;
  }
  .btn-pro:hover { filter: brightness(1.08); transform: translateY(-1px); }

  /* ── 滚动收缩态 ── */
  html[data-scrolled='1'] .site-header { padding-top: var(--nav-top-scrolled); }
  html[data-scrolled='1'] .header-container {
    max-width: 1440px; /* = 1600 − 160，与未滚动保持同一收缩差（见顶部令牌注释） */
    height: 56px;
    padding: 0 var(--nav-pad-x-scrolled);
    border-radius: var(--nav-radius-scrolled);
    background: var(--nav-bg-scrolled);
    border-color: var(--nav-border-scrolled);
    box-shadow: var(--nav-shadow-scrolled);
    -webkit-backdrop-filter: var(--nav-blur-scrolled);
    backdrop-filter: var(--nav-blur-scrolled);
  }
  html[data-scrolled='1'] .logo { font-size: 14px; gap: 8px; }
  html[data-scrolled='1'] .logo :global(.brandmark) { height: 18px; }
  html[data-scrolled='1'] .nav-links { gap: var(--nav-link-gap-scrolled); }
  html[data-scrolled='1'] .btn {
    height: 32px;
    padding: var(--nav-ctl-pad-scrolled);
    font-size: var(--nav-ctl-fs-scrolled);
    border-radius: var(--nav-ctl-radius-scrolled);
  }
  html[data-scrolled='1'] .btn-github svg { width: 14px; height: 14px; }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .header-container,
    .logo,
    .nav-links,
    .nav-actions,
    .nav-sub,
    .btn { transition: none; }
  }

  /* 「暂停背景动态」按钮已于 2026-09-18 删除（背景视频默认播放），相关样式一并移除。 */

  /* ============================================================
     移动端导航 —— StaggeredMenu 形态（2026-09-23，源自 React Bits 同名组件）
     · 开关：「菜单/关闭」文字竖向滚动 + 加号图标旋转 225° 成叉（gsap 驱动）
     · 抽屉：右侧全高滑入 + 2 层强调色前导层错峰跟进 + 条目 yPercent 错峰入场
     · 桌面端（≥769px）整体 display:none，顶栏链接/二级下拉不受任何影响
     · 动画只动 transform / opacity / 自定义属性；prefers-reduced-motion 由 JS 归零时长
     ============================================================ */
  .sm-toggle {
    position: relative;
    z-index: 68; /* 高于抽屉（67）：菜单按钮永远浮在抽屉之上可点 */
    display: none; /* 桌面端不渲染 */
    align-items: center;
    gap: 8px;
    background: none;
    border: none;
    padding: 4px;
    cursor: pointer;
    color: var(--nav-ink);
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
  }
  .sm-tw {
    position: relative;
    display: inline-block;
    height: 1em;
    overflow: hidden; /* 竖向滚动文字的裁剪窗 */
  }
  .sm-ti {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }
  /* 行元素由 JS 动态重建（滚动序列），:global 兜住作用域外生成的节点 */
  .sm-ti :global(span) { display: block; height: 1em; line-height: 1; }
  .sm-icon {
    position: relative;
    width: 16px;
    height: 16px;
    flex: none;
    will-change: transform;
  }
  .sm-line-h,
  .sm-line-v {
    position: absolute;
    left: 0;
    top: calc(50% - 1px);
    width: 100%;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
  }
  .sm-line-v { transform: rotate(90deg); }

  /* ── 抽屉容器：全屏但自身不吃事件（点击外部关闭由 document 委托负责） ── */
  .sm-drawer {
    position: fixed;
    inset: 0;
    z-index: 67; /* 高于导航条（无层级）/低于开关（68）：抽屉盖住导航栏 */
    pointer-events: none;
  }
  /* 抽屉打开时摘掉胶囊的 backdrop-filter：防止 container 形成层叠上下文
     把开关困在抽屉之下（只有滚动态胶囊才有 blur，展开瞬间被抽屉盖住无感） */
  .site-header.mnav-open .header-container {
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
  .sm-panel { pointer-events: auto; }

  /* 前导层：与抽屉同几何，错峰滑入形成层叠色带 */
  .sm-prelayers {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: clamp(170px, 38vw, 200px);
    pointer-events: none;
    overflow: hidden;
  }
  .sm-prelayer {
    position: absolute;
    inset: 0;
    transform: translateX(100%); /* SSR 初始即屏外，JS 接管前不闪现 */
  }
  .sm-pl-a { background: rgba(var(--accent-rgb), 0.30); }
  .sm-pl-b { background: rgba(var(--accent-rgb), 0.14); }

  .sm-panel {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: clamp(170px, 38vw, 200px);
    box-sizing: border-box;
    padding: calc(var(--nav-h) + 24px) 0 28px 20px; /* 右侧零留白：编号贴内容排 */
    overflow-y: auto;
    background: rgba(10, 10, 15, 0.5); /* 低可见度磨砂：透出背景视频 */
    border-left: 1px solid var(--nav-border-scrolled);
    box-shadow: -24px 0 60px rgba(0, 0, 0, 0.45);
    /* ⚠️ -webkit- 必须写在标准属性之前（构建压缩会丢后写的重复声明，见 HANDOFF §22） */
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    backdrop-filter: blur(16px) saturate(140%);
    transform: translateX(100%);
    display: flex;
    flex-direction: column;
  }

  /* 条目列表：counter 编号（decimal-leading-zero）+ 标签错峰入场 */
  .sm-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    counter-reset: smitem;
  }
  .sm-item {
    position: relative;
    overflow: hidden; /* 标签 yPercent 140 入场时从这里钻出来 */
  }
  .sm-link {
    position: relative;
    display: flex; /* 编号内联跟排，右侧零留白 */
    align-items: baseline;
    gap: 10px;
    padding: 6px 0;
    color: var(--nav-ink);
    text-decoration: none;
    font-size: 1.9rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.01em;
  }
  .sm-label { display: inline-block; will-change: transform; transform-origin: 50% 100%; }
  .sm-link::after {
    counter-increment: smitem;
    content: counter(smitem, decimal-leading-zero);
    flex: none;
    font-family: var(--font-mono, monospace);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--accent);
    opacity: var(--sm-num, 0); /* gsap 按序号错峰补间到 1 */
    pointer-events: none;
  }
  .sm-link:hover, .sm-link[aria-current='page'] { color: var(--accent-deep); }

  /* 「记录」组内子链接：默认收进下拉（点父项展开，见 nav-mobile.js 捕获委托） */
  .sm-sub {
    display: none; /* 收起态：不占位 */
    flex-direction: column;
    padding: 2px 0 10px 14px;
  }
  .sm-item.open .sm-sub { display: flex; }
  .sm-item .sm-link .caret {
    width: 10px;
    height: 6px;
    flex: none;
    align-self: center;
    opacity: 0.7;
    transition: transform 0.25s var(--nav-ease), opacity 0.2s ease;
  }
  .sm-item.open .sm-link .caret { transform: rotate(180deg); opacity: 1; }
  .sm-item.open .sm-sub a[aria-current='page'] { color: var(--accent-deep); }
  .sm-sub a {
    color: var(--nav-ink-muted);
    text-decoration: none;
    font-size: 15px;
    line-height: 1.4;
    padding: 6px 0;
  }
  .sm-sub a[aria-current='page'] { color: var(--accent-deep); }

  /* ── 断点（参考实测：≤1024 pad 24 且容器满宽、≤768 换汉堡）──
     参考在 768–1100 之间没有处理，因为它的 4 个链接比本站 5 个短；
     本站链接更宽，故在 1100 以下先收窄间距，避免内容被容器挤出。 */
  @media (max-width: 1100px) {
    .site-header {
      --nav-pad-x: 24px;
      --nav-pad-x-scrolled: 20px;
      --nav-link-gap: 24px;
      --nav-link-gap-scrolled: 18px;
    }
  }
  /* 参考：≤1024 时容器满宽（参考实测 w=1009 = 视口宽 − 滚动条） */
  @media (max-width: 1024px) {
    .header-container { max-width: 100%; }
    html[data-scrolled='1'] .header-container { max-width: calc(100% - 40px); }
  }
  @media (max-width: 768px) {
    .nav-links { display: none; }
    .sm-toggle { display: flex; } /* StaggeredMenu 开关只在移动端出现 */
    .site-header {
      --nav-pad-x: 20px;
      --nav-pad-x-scrolled: 16px;
    }
    .header-container { max-width: 100%; }
    html[data-scrolled='1'] .header-container { max-width: 100%; height: 52px; }
    .btn-github span { display: none; }
    .btn-github { padding: 8px 10px; }
  }
  /* 双保险：桌面端即使 HTML 被复用也绝不渲染移动抽屉 */
  @media (min-width: 769px) {
    .sm-drawer { display: none; }
  }
</style>

<script>
  // 移动端汉堡菜单（下拉玻璃面板的开关、Esc/点外部收起、aria 同步）。
  // ⚠️ 这段 import 不能丢：nav-mobile.js 只在这里被引用，删掉汉堡就没反应
  // （2026-09-18 改版时曾漏掉，verify-nav-shrink 的移动端断言抓到了）。
  import '../scripts/nav-mobile.js';
</script>
