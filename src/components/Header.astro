---
/* ============================================================
   顶部导航 —— 按 reference（code_20260918.html）像素级复刻形态
   · 几何/间距/断点/过渡全部照参考：1280→1120、64→56、32→24、
     0→999px 圆角、gap 32→24、按钮 8px→9999px
   · 强调色保留站点雾蓝（--accent），不用参考里的紫/粉/红
   · 按用户要求去掉导航里的搜索入口（悬浮窗仍可由 ⌘/Ctrl+K 打开）
   · 保留站点功能：品牌标志、动效暂停按钮、移动端下拉菜单、二级菜单数据
   ============================================================ */
import { SITE, NAV } from '../site';
import { getCollection } from 'astro:content';
import BrandMark from './BrandMark.astro';

const { current = '/' } = Astro.props;
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);

/* ---------- 各子页面的分类 → 对应导航项的二级菜单（移动端菜单里用） ----------
   作品库的分类 = 作品标签（tags），画廊的分类 = 截图所属游戏（game）。
   两者都由内容集合现算，新增作品/截图后菜单自动更新，不用改这里。 */
const worksAll = await getCollection('works');
const shotsAll = await getCollection('shots');

const countBy = (list: string[]) => {
  const m = new Map<string, number>();
  list.forEach((k) => k && m.set(k, (m.get(k) ?? 0) + 1));
  return [...m.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh'));
};
const workTags = countBy(worksAll.flatMap((e) => e.data.tags ?? []));
const shotGames = countBy(shotsAll.map((e) => e.data.game ?? ''));
const SUBS: Record<string, { label: string; href: string }[]> = {
  '/works/': workTags.map(([t]) => ({ label: t, href: `/works/?tag=${encodeURIComponent(t)}` })),
  '/gallery/': shotGames.map(([g]) => ({ label: g, href: `/gallery/?game=${encodeURIComponent(g)}` })),
};

const items = NAV.map((item) => ({ ...item, sub: SUBS[item.href] ?? [] }));

/* 参考导航右侧是「Star on GitHub · 47.5K」+「Get Pro」。
   本站映射为：GitHub（带真实 star 数）+ Bilibili（站点真实入口）。 */
let stars: string | null = null;
try {
  const r = await fetch('https://api.github.com/repos/CloudWingX/cloudwing', {
    headers: { 'user-agent': 'cloudwing-build' },
    signal: AbortSignal.timeout(4000),
  });
  if (r.ok) {
    const j = await r.json();
    const n = Number(j.stargazers_count);
    if (Number.isFinite(n) && n > 0) stars = n >= 1000 ? `${(n / 1000).toFixed(1)}K` : String(n);
  }
} catch {
  /* 离线或限流：不显示数字，只显示 "GitHub" */
}
---

<header class="site-header" data-nav>
  <div class="header-container">
    <a class="logo" href="/" aria-label={`${SITE.title} · 回到首页`}>
      {/* 站点的横版品牌字标（云 + 羽翼 + CLOUDWING）就是本站的 wordmark，
          对应参考里 "React Bits" 那个位置；高度与参考一致（20px / 滚动后 18px）。 */}
      <BrandMark variant="horizontal" height={20} />
    </a>

    <ul class="nav-links">
      {
        items.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label.replace(/作品库$/, '作品').replace(/^关于$/, '档案')}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="nav-actions">
      {
        SITE.github && (
          <a class="btn btn-github" href={SITE.github} target="_blank" rel="noreferrer" title="Star on GitHub">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.11.81 2.25 0 1.635-.015 2.955-.015 3.36 0 .315.225.69.825.57C20.565 21.795 24 17.31 24 12c0-6.63-5.37-12-12-12z"></path>
            </svg>
            <span>Star on GitHub{stars ? ` · ${stars}` : ''}</span>
          </a>
        )
      }
      {SITE.bilibili && <a class="btn btn-pro" href={SITE.bilibili} target="_blank" rel="noreferrer">Bilibili</a>}
      <button
        type="button"
        class="motion-toggle"
        data-motion-toggle
        aria-label="暂停背景动态"
        aria-pressed="false"
        title="暂停 / 播放背景动态"
      >
        <svg class="mt-pause" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <path d="M9 5v14M15 5v14"></path>
        </svg>
        <svg class="mt-play" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 4.8 19 12 7 19.2Z"></path>
        </svg>
      </button>
      <button
        type="button"
        class="hamburger"
        data-mnav-toggle
        aria-label="打开菜单"
        aria-expanded="false"
        aria-controls="cw-mobile-menu"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  {/* ── 移动端菜单：从顶部下拉（参考同款：淡入 + 轻微下移 + 逐项错峰）── */}
  <div id="cw-mobile-menu" class="mobile-menu" data-mnav-panel hidden>
    {items.map((item) => (
      <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
    ))}
    {
      items
        .filter((i) => i.sub.length > 0)
        .map((i) => (
          <div class="mm-group">
            <span class="mm-group-t">{i.label}分类</span>
            <div class="mm-chips">
              {i.sub.map((s) => (
                <a class="mm-chip" href={s.href}>{s.label}</a>
              ))}
            </div>
          </div>
        ))
    }
    <div class="mm-actions">
      {SITE.github && <a class="mm-btn" href={SITE.github} target="_blank" rel="noreferrer">GitHub</a>}
      {SITE.bilibili && <a class="mm-btn" href={SITE.bilibili} target="_blank" rel="noreferrer">Bilibili</a>}
      <a class="mm-btn" href="/rss.xml">RSS</a>
    </div>
  </div>
</header>

<style>
  /* ============================================================
     导航令牌（几何全部取自参考实测值）
     未滚动：max-w 1280 / h 64 / pad 32 / radius 0
     滚动后：max-w 1120 / h 56 / pad 24 / radius 999 / 玻璃加深
     ============================================================ */
  .site-header {
    --nav-w: 1280px;
    --nav-w-scrolled: 1120px;
    --nav-h: 64px;
    --nav-h-scrolled: 56px;
    --nav-pad-x: 32px;
    --nav-pad-x-scrolled: 24px;
    --nav-top: 0px;
    --nav-top-scrolled: 16px;
    --nav-radius: 0px;
    --nav-radius-scrolled: 9999px;
    --nav-bg: transparent;
    --nav-bg-scrolled: rgba(10, 10, 15, 0.7);
    --nav-border: transparent;
    --nav-border-scrolled: rgba(255, 255, 255, 0.08);
    --nav-shadow: none;
    --nav-shadow-scrolled: 0 4px 20px rgba(0, 0, 0, 0.15);
    --nav-blur: none;
    --nav-blur-scrolled: blur(12px) saturate(180%);
    --nav-ink: #ffffff;
    --nav-ink-muted: rgba(255, 255, 255, 0.7);
    --nav-ink-dim: rgba(255, 255, 255, 0.5);
    --nav-hover-bg: rgba(255, 255, 255, 0.05);
    --nav-link-fs: 14px;
    --nav-link-fs-scrolled: 14px;
    --nav-link-gap: 32px;
    --nav-link-gap-scrolled: 24px;
    --nav-ctl-fs: 13px;
    --nav-ctl-fs-scrolled: 12px;
    --nav-ctl-gap: 12px;
    --nav-ctl-gap-scrolled: 8px;
    --nav-ctl-pad: 8px 16px;
    --nav-ctl-pad-scrolled: 6px 14px;
    --nav-ctl-radius: 8px;
    --nav-ctl-radius-scrolled: 9999px;
    --nav-ease: cubic-bezier(0.4, 0, 0.2, 1);
    --nav-drawer-bg: rgba(10, 10, 15, 0.95);

    /* position:fixed（与参考一致）—— 导航不占文档流，Hero 从 y=0 开始，
       正是参考里 hero.getBoundingClientRect().y === 0 的成因。
       子页面内容由 .shell 的 padding-top 让位（见 shell.css）。 */
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 70;
    /* 只留纵向 padding：横向留白放到 .header-container 上。
       原因：父层的横向 padding 会让子元素 max-width:100% 解析成"父层内容宽"
       （实测 1024 下容器只有 911.6 而不是 1009），参考是满宽容器。 */
    padding: var(--nav-top) 0 0;
    /* 站点全局 body 是 line-height:1.8，会把导航撑高（实测 64→71）；
       参考用的是 normal，这里显式跟随，保证容器高度就是 --nav-h。 */
    line-height: normal;
    transition: padding-top 0.4s var(--nav-ease);
  }

  /* ── 容器条 ──
     ⚠️ max-width 必须写字面 px：写成 var(--nav-w) 时 Astro 的作用域编译会把它
     变成 `calc(0.1066% + 1278.64px)`，在带 padding 的父层下算不到 1280。 */
  .header-container {
    box-sizing: border-box;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    /* 窄于 max-width 时由 margin 撑开左右留白（等价于参考的 padding 效果），
       宽于 max-width 时用 padding 让内容与页面栅格对齐 */
    padding: 0 var(--nav-pad-x);
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    line-height: normal; /* 参考值；站点全局 1.8 会把 64px 的条撑成 71px */
    border-radius: var(--nav-radius);
    background: var(--nav-bg);
    border: 1px solid var(--nav-border);
    box-shadow: var(--nav-shadow);
    /* ⚠️ -webkit- 必须写在标准属性之前（否则构建压缩会整条丢掉，见 HANDOFF §22） */
    -webkit-backdrop-filter: var(--nav-blur);
    backdrop-filter: var(--nav-blur);
    transition:
      max-width 0.4s var(--nav-ease),
      height 0.4s var(--nav-ease),
      padding 0.4s var(--nav-ease),
      border-radius 0.4s var(--nav-ease),
      background 0.4s var(--nav-ease),
      border-color 0.4s var(--nav-ease),
      box-shadow 0.4s var(--nav-ease),
      backdrop-filter 0.4s var(--nav-ease);
  }

  /* ── 左侧品牌 ── */
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 500;
    line-height: 20px; /* 固定行高：站点全局 1.8 会把容器撑高 */
    color: var(--nav-ink);
    text-decoration: none;
    flex: none;
    transition: font-size 0.4s var(--nav-ease), gap 0.4s var(--nav-ease);
  }
  .logo :global(.brandmark) { display: block; flex: none; height: 20px; width: auto; transition: height 0.4s var(--nav-ease); }
  .logo-name { white-space: nowrap; }

  /* ── 中间链接组 ── */
  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--nav-link-gap);
    list-style: none;
    margin: 0;
    padding: 0;
    line-height: 20px;
    transition: gap 0.4s var(--nav-ease);
  }
  .nav-links a {
    position: relative;
    display: inline-block;
    color: var(--nav-ink-muted);
    text-decoration: none;
    font-size: var(--nav-link-fs);
    font-weight: 400;
    line-height: 20px;
    white-space: nowrap;
    transition: color 0.2s ease, font-size 0.4s var(--nav-ease);
  }
  .nav-links a:hover { color: var(--nav-ink); }
  .nav-links a[aria-current='page'] { color: var(--nav-ink); }
  /* 当前页/悬停的下划线：用站点雾蓝强调色（参考里是文字变色，这里保留品牌色） */
  .nav-links a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 1px;
    background: var(--accent);
  }

  /* ── 右侧动作组 ── */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: none;
  }
  .btn {
    box-sizing: border-box; /* 少了这条 height 会被 padding 撑到 44px（实测） */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 34px;
    padding: var(--nav-ctl-pad);
    border: none;
    border-radius: var(--nav-ctl-radius);
    font-size: var(--nav-ctl-fs);
    font-weight: 500;
    line-height: 1;
    letter-spacing: normal;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.3s var(--nav-ease);
    /* 站点 global.css 在 ≤640px 给 .btn 加了 min-height:44px（Apple HIG 触控规则），
       会把手机端导航从 64px 撑到 44px 高的按钮行。参考在手机端仍是紧凑条，
       导航的触控面积由整条导航保证，所以这里显式取消那条规则。 */
    min-height: 0;
  }
  .btn-github {
    background: var(--nav-hover-bg);
    border: 1px solid var(--nav-border-scrolled);
    color: var(--nav-ink);
  }
  .btn-github:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.15);
  }
  .btn-github svg { width: 16px; height: 16px; flex: none; transition: width 0.4s var(--nav-ease), height 0.4s var(--nav-ease); }
  /* 「Get Pro」→ 站点 Bilibili 入口：用品牌强调色做底（不用参考的紫粉红渐变）。
     参考里 .btn-pro 是 32px 高（比 GitHub 那颗矮 2px），这里照做。
     ⚠️ 底色必须**不透明**：半透明的 accent 压在暗色视频上会合成成近黑，
     深色文字对比度只剩 1:1（contrast-audit 抓到过）。 */
  .btn-pro {
    height: 32px;
    background: var(--accent);
    color: #0a0a0f;
  }
  .btn-pro:hover { filter: brightness(1.08); transform: translateY(-1px); }

  /* ── 滚动收缩态 ── */
  html[data-scrolled='1'] .site-header { padding-top: var(--nav-top-scrolled); }
  html[data-scrolled='1'] .header-container {
    max-width: 1120px;
    height: 56px;
    padding: 0 var(--nav-pad-x-scrolled);
    border-radius: var(--nav-radius-scrolled);
    background: var(--nav-bg-scrolled);
    border-color: var(--nav-border-scrolled);
    box-shadow: var(--nav-shadow-scrolled);
    -webkit-backdrop-filter: var(--nav-blur-scrolled);
    backdrop-filter: var(--nav-blur-scrolled);
  }
  html[data-scrolled='1'] .logo { font-size: 14px; gap: 8px; }
  html[data-scrolled='1'] .logo :global(.brandmark) { height: 18px; }
  html[data-scrolled='1'] .nav-links { gap: var(--nav-link-gap-scrolled); }
  html[data-scrolled='1'] .btn {
    height: 32px;
    padding: var(--nav-ctl-pad-scrolled);
    font-size: var(--nav-ctl-fs-scrolled);
    border-radius: var(--nav-ctl-radius-scrolled);
  }
  html[data-scrolled='1'] .btn-github svg { width: 14px; height: 14px; }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .header-container,
    .logo,
    .nav-links,
    .nav-actions,
    .btn { transition: none; }
  }

  /* ── 可访问性：暂停背景动态（WCAG 2.2.2）── */
  .motion-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    flex: none;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 9999px;
    background: transparent;
    color: var(--nav-ink-dim);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .site-header:hover .motion-toggle,
  .motion-toggle:focus-visible { opacity: 1; }
  .motion-toggle:hover,
  .motion-toggle:focus-visible { color: var(--nav-ink); border-color: var(--nav-border-scrolled); }
  .motion-toggle .mt-play { display: none; }
  .motion-toggle[aria-pressed='true'] { color: var(--accent-deep); border-color: var(--accent); }
  .motion-toggle[aria-pressed='true'] .mt-pause { display: none; }
  .motion-toggle[aria-pressed='true'] .mt-play { display: inline-flex; }

  /* ── 汉堡按钮（参考同款：三条线 → 叉号）── */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    padding: 4px;
    width: 28px;
    height: 28px;
    flex: none;
    background: none;
    border: none;
    cursor: pointer;
  }
  .hamburger span {
    display: block;
    width: 20px;
    height: 2px;
    border-radius: 2px;
    background: var(--nav-ink);
    transition: all 0.3s var(--nav-ease);
  }
  .site-header.mnav-open .hamburger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .site-header.mnav-open .hamburger span:nth-child(2) { opacity: 0; transform: translateX(-10px); }
  .site-header.mnav-open .hamburger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* ── 移动端下拉菜单 ── */
  .mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 16px 32px 20px;
    background: var(--nav-drawer-bg);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--nav-border-scrolled);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-16px);
    transition: opacity 0.35s var(--nav-ease), transform 0.35s var(--nav-ease), visibility 0.35s;
  }
  .mobile-menu.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu > a {
    color: var(--nav-ink);
    text-decoration: none;
    font-size: 16px;
    padding: 8px 0;
  }
  .mobile-menu > a[aria-current='page'] { color: var(--accent); }
  .mm-group { display: flex; flex-direction: column; gap: 8px; }
  .mm-group-t {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--nav-ink-dim);
  }
  .mm-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .mm-chip {
    padding: 5px 12px;
    border-radius: 9999px;
    border: 1px solid var(--nav-border-scrolled);
    background: rgba(255, 255, 255, 0.05);
    color: var(--nav-ink-muted);
    font-size: 13px;
    text-decoration: none;
  }
  .mm-actions { display: flex; flex-wrap: wrap; gap: 10px; padding-top: 4px; }
  .mm-btn {
    padding: 8px 16px;
    border-radius: 8px;
    border: 1px solid var(--nav-border-scrolled);
    background: rgba(255, 255, 255, 0.05);
    color: var(--nav-ink);
    font-size: 13px;
    text-decoration: none;
    cursor: pointer;
  }

  /* ── 断点（参考实测：≤1024 pad 24 且容器满宽、≤768 换汉堡）──
     参考在 768–1100 之间没有处理，因为它的 4 个链接比本站 5 个短；
     本站链接更宽，故在 1100 以下先收窄间距，避免内容被容器挤出。 */
  @media (max-width: 1100px) {
    .site-header {
      --nav-pad-x: 24px;
      --nav-pad-x-scrolled: 20px;
      --nav-link-gap: 24px;
      --nav-link-gap-scrolled: 18px;
    }
  }
  /* 参考：≤1024 时容器满宽（参考实测 w=1009 = 视口宽 − 滚动条） */
  @media (max-width: 1024px) {
    .header-container { max-width: 100%; }
    html[data-scrolled='1'] .header-container { max-width: calc(100% - 40px); }
  }
  @media (max-width: 768px) {
    .nav-links { display: none; }
    .hamburger { display: flex; }
    .site-header {
      --nav-pad-x: 20px;
