---
import { SITE, NAV } from '../site';
import { getCollection } from 'astro:content';
import BrandMark from './BrandMark.astro';

const { current = '/' } = Astro.props;
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);

/* ---------- 各子页面的分类 → 对应导航项的二级菜单 ----------
   作品库的分类 = 作品标签（tags），画廊的分类 = 截图所属游戏（game）。
   两者都由内容集合现算，新增作品/截图后菜单自动更新，不用改这里。 */
const worksAll = await getCollection('works');
const shotsAll = await getCollection('shots');

const countBy = (list: string[]) => {
  const m = new Map<string, number>();
  list.forEach((k) => k && m.set(k, (m.get(k) ?? 0) + 1));
  return [...m.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh'));
};

const workTags = countBy(worksAll.flatMap((e) => e.data.tags ?? []));
const shotGames = countBy(shotsAll.map((e) => e.data.game ?? ''));

const SUBS: Record<string, { label: string; href: string; count?: number; sub?: boolean }[]> = {
  '/works/': [
    { label: '全部作品', href: '/works/', sub: true },
    ...workTags.map(([t, n]) => ({ label: t, href: `/works/?tag=${encodeURIComponent(t)}`, count: n })),
  ],
  '/gallery/': [
    { label: '全部截图', href: '/gallery/', sub: true },
    ...shotGames.map(([g, n]) => ({ label: g, href: `/gallery/?game=${encodeURIComponent(g)}`, count: n })),
  ],
};

const items = NAV.map((item) => ({ ...item, sub: SUBS[item.href] ?? [] }));
const pad = (n: number) => String(n).padStart(2, '0');

/* 侧边面板底部的社交链接（ReactBits StaggeredMenu 的 socialItems 位） */
const socials = [
  SITE.github && { label: 'GitHub', href: SITE.github },
  SITE.bilibili && { label: 'Bilibili', href: SITE.bilibili },
  SITE.email && { label: 'Email', href: `mailto:${SITE.email}` },
  { label: 'RSS', href: '/rss.xml' },
].filter(Boolean) as { label: string; href: string }[];
---
<header class="site-header" data-nav>
  {/* 悬浮玻璃胶囊：宽 min(1200px, 100% - 40px)、距顶 16px、高 56px（滚动后 52px）、圆角 999px。
      玻璃材质与尺寸都走 --nav-* 令牌（见样式里的「导航胶囊令牌」块）——
      想换成浅色玻璃只改那一块，不必动结构。 */}
  <div class="hd">
    {/* 内容行：Logo · 中间留白 · 右侧链接组 */}
    <div class="hd-in">
    <a class="brand" href="/" aria-label="CloudWing 云翼 · 回到首页">
      {/* 品牌标志：横版字标（云 + 三根羽翼 + CLOUD/WING），见 BrandMark.astro */}
      <BrandMark variant="horizontal" height={30} />
      {/* 空间充足时附带中文站点名；极窄屏由 CSS 隐藏（品牌标本身已含字标） */}
      <span class="bname">{SITE.title}</span>
    </a>

    <nav class="nav" aria-label="主导航">
      {
        items.map((item) =>
          item.sub.length > 0 ? (
            <span class="nav-item has-sub" data-nav-sub>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
              <button
                type="button"
                class="nav-caret"
                data-nav-caret
                aria-expanded="false"
                aria-haspopup="true"
                aria-label={`展开${item.label}的分类`}
              >
                <svg viewBox="0 0 12 12" width="10" height="10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                  <path d="M2.6 4.4 6 7.8l3.4-3.4" />
                </svg>
              </button>
              <ul class="nav-sub" data-nav-panel hidden>
                {item.sub.map((s) => (
                  <li>
                    <a href={s.href} class:list={[{ 'is-all': s.sub }]}>
                      <span class="ns-label">{s.label}</span>
                      {s.count !== undefined && <span class="ns-count">{pad(s.count)}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </span>
          ) : (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ),
        )
      }
    </nav>

    <div class="acts">
      {SITE.github && (
        <a class="pill ext" href={SITE.github} target="_blank" rel="noreferrer" title="GitHub">
          <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
          </svg>
          <span>GitHub</span>
        </a>
      )}
      {/* 搜索改成悬浮窗触发（原先是 /search/ 独立页面，见 ui.js 的 searchModal()） */}
      <button type="button" class="pill search-pill" data-search-open aria-label="站内搜索" title="站内搜索（⌘/Ctrl + K）">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m16.2 16.2 4.3 4.3" />
        </svg>
        <span>搜索</span>
      </button>
      {/* 主题开关已删除：站点只有一套暗色电影感主题（见 global.css 的 :root 注释） */}
      {/* 可访问性：给"动态背景"一个显式的暂停入口（WCAG 2.2.2 暂停/停止/隐藏）。
          默认仅在 hover/focus 时淡入，不干扰画面；由 VideoBackground 的脚本接管。 */}
      <button
        type="button"
        class="motion-toggle"
        data-motion-toggle
        aria-label="暂停背景动态"
        aria-pressed="false"
        title="暂停 / 播放背景动态"
      >
        <svg class="mt-pause" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <path d="M9 5v14M15 5v14" />
        </svg>
        <svg class="mt-play" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 4.8 19 12 7 19.2Z" />
        </svg>
      </button>
      {/* 移动端汉堡（照 ReactBits：三条线，点开变叉号） */}
      <button
        type="button"
        class="hamburger"
        data-mnav-toggle
        aria-label="打开菜单"
        aria-expanded="false"
        aria-controls="cw-mobile-menu"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
    </div>
  </div>

  {/* ── 移动端菜单（照 ReactBits：从顶部下拉的玻璃面板，淡入 + 轻微下移）── */}
  <div id="cw-mobile-menu" class="mobile-menu" data-mnav-panel hidden>
    {items.map((item) => (
      <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
    ))}
    <div class="mm-actions">
      <button type="button" class="mm-btn" data-search-open>搜索</button>
      {socials.slice(0, 2).map((s) => (
        <a class="mm-btn" href={s.href} target={s.href.startsWith('http') ? '_blank' : undefined} rel="noreferrer">
          {s.label}
        </a>
      ))}
    </div>
  </div>
</header>



<style>
  /* ============================================================
     顶部导航（参考 reactbits.dev 主站导航）
     细玻璃条 + 左侧品牌 + 常驻链接胶囊 + 右侧幽灵胶囊按钮
     ============================================================ */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 70;
    padding: 0; /* 抵消旧版顶栏全局留白 */
    /* 下滑自动收起（ui.js 的 autoHideHeader 切 .hd-hidden）；上滑滑回。
       侧栏的吸顶位移用更短的时长（见 shell.css），保证导航栏滑回时
       侧栏已经让开，两者任何时刻都不重叠。 */
    transition: transform 0.28s var(--ease), opacity 0.28s var(--ease);
    will-change: transform, opacity;
  }
  .site-header.hd-hidden {
    transform: translateY(-102%);
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
  }

  /* ══════════════════════════════════════════════════════════════
     移动端菜单 —— 照 ReactBits 的 .mobile-menu
     顶部下拉的玻璃面板：淡入 + 轻微下移（translateY(-10px) → 0）
     配色换成站点令牌（ReactBits 原文是 rgba(10,10,15,.95) + 白字，这里一致）
     ══════════════════════════════════════════════════════════════ */
  .hamburger {
    display: none; /* 桌面隐藏，≤768px 显示 */
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 8px;
    min-width: 40px;
    min-height: 40px;
    background: none;
    border: 0;
    border-radius: 10px;
    color: var(--nav-ink);
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .hamburger:hover { background: var(--nav-hover-bg); }
  .hamburger span {
    width: 20px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  /* 打开后变叉号 */
  .site-header.mnav-open .hamburger span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .site-header.mnav-open .hamburger span:nth-child(2) { opacity: 0; }
  .site-header.mnav-open .hamburger span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  .mobile-menu {
    position: fixed;
    /* 贴在导航下方：未滚动时导航 64px 高、滚动后 16+52px */
    top: var(--mn-top, 64px);
    left: 0;
    width: 100%;
    padding: 16px 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: rgba(10, 10, 15, 0.95);
    -webkit-backdrop-filter: blur(20px) saturate(1.4);
    backdrop-filter: blur(20px) saturate(1.4);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    z-index: 60;
    transform: translateY(-10px);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  /* 滚动后导航下沉 16px，菜单跟着下移，避免被胶囊压住 */
  html[data-scrolled='1'] .mobile-menu { --mn-top: 68px; }
  .mobile-menu.is-open {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu a {
    color: var(--nav-ink);
    text-decoration: none;
    font-size: 16px;
    font-weight: 500;
    padding: 8px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .mobile-menu a[aria-current='page'] { color: var(--accent); }
  .mm-actions { display: flex; flex-wrap: wrap; gap: 10px; padding-top: 4px; }
  .mm-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 0 18px;
    border-radius: 999px;
    border: 1px solid var(--nav-border-scrolled);
    background: rgba(255, 255, 255, 0.06);
    color: var(--nav-ink);
    font-family: inherit;
    font-size: 14px;
    cursor: pointer;
    text-decoration: none;
  }
  @media (max-width: 768px) {
    .hamburger { display: flex; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hamburger span,
    .mobile-menu { transition: none; }
  }

  /* ── 顶部指示线：悬停跟随 + 当前页激活 ── */
  .nav { position: relative; }
  .nav-ind {
    position: absolute;
    left: 0;
    bottom: 2px;
    height: 2px;
    width: 0;
    border-radius: 2px;
    background: var(--accent);
    pointer-events: none;
    opacity: 0;
    will-change: transform, width, opacity;
  }
  .nav-ind--hover { background: color-mix(in srgb, var(--accent) 55%, transparent); }

  /* ══════════════════════════════════════════════════════════════
     导航令牌 —— 想换配色只改这一块（结构/尺寸/交互与配色解耦）
     ══════════════════════════════════════════════════════════════ */
  .site-header {
    /* ══ 滚缩参数（照 ReactBits 的 shrink-on-scroll）══
       未滚动：贴顶通栏（padding-top 0、容器 1280 宽 64 高、无圆角、无底色）
       滚动后：下沉 16px 收成胶囊（1120 宽 52 高、圆角 999px、玻璃底）
       只改这几个变量，形态过渡全部由 CSS transition 完成。 */
    --nav-top: 0px;
    --nav-top-scrolled: 16px;
    --nav-w: 1280px;
    --nav-w-scrolled: 1120px;
    --nav-h: 64px;
    --nav-h-scrolled: 52px;
    --nav-pad-x: 32px;
    --nav-pad-x-scrolled: 22px;
    /* 内容行内边距：未滚动时靠容器 padding 即可，滚动后容器 padding 22px 已含，
       内容行给一点内侧留白避免贴边 */
    --nav-in-pad-scrolled: 0px;
    /* 形态过渡曲线（与 ReactBits 一致） */
    --ease-nav: cubic-bezier(0.4, 0, 0.2, 1);
    --nav-radius: 0px;
    --nav-radius-scrolled: 999px;
    /* 未滚动：完全透明（贴顶通栏，让视频铺满）
       滚动后：半透明玻璃 + 描边 + 阴影 */
    --nav-bg: transparent;
    --nav-bg-scrolled: rgba(9, 12, 16, 0.7);
    --nav-border: transparent;
    --nav-border-scrolled: rgba(255, 255, 255, 0.2);
    --nav-shadow: none;
    --nav-shadow-scrolled: 0 4px 20px rgba(0, 0, 0, 0.36);
    --nav-blur: none;
    --nav-blur-scrolled: blur(12px) saturate(1.8);
    --nav-ink: #ffffff;
    --nav-ink-dim: #c9d1d9;
    --nav-hover-bg: rgba(255, 255, 255, 0.08);
    --nav-link-fs: 14px;
    --nav-link-fs-scrolled: 13px;
    --nav-link-gap: 24px;
    --nav-link-gap-scrolled: 16px;
    --nav-link-pad: 8px 14px;
    --nav-link-pad-scrolled: 6px 11px;
    --nav-link-radius: 10px;
    /* 顶栏控件：滚动后同步收小 */
    --nav-ctl-h: 40px;
    --nav-ctl-h-scrolled: 34px;
    /* 移动端下拉面板必须**基本不透明**：它盖在正文之上，0.92 这类半透明会让
       下方的正文与视频透上来（实测像素差 347/765，观感像重影）。
       保留一点渐变与模糊，让它仍是"玻璃片"而不是死板色块。 */
    --nav-drawer-bg: linear-gradient(180deg, rgba(9, 12, 16, 0.99), rgba(9, 12, 16, 0.97));
  }

  .hd {
    /* 胶囊本体。未滚动时是"贴顶通栏"，滚动后收成浮起的圆角玻璃片。
       不要用 overflow:hidden —— .nav-sub（二级菜单）是它的绝对定位后代，会被裁掉。 */
    position: relative;
    isolation: isolate;
    box-sizing: border-box;
    width: 100%;
    max-width: var(--nav-w);
    margin: 0 auto;
    padding: 0 var(--nav-pad-x);
    height: var(--nav-h);
    border-radius: var(--nav-radius);
    background: var(--nav-bg);
    border: 1px solid var(--nav-border);
    box-shadow: var(--nav-shadow);
    -webkit-backdrop-filter: var(--nav-blur);
    backdrop-filter: var(--nav-blur);
    /* 形态过渡（0.4s / cubic-bezier(0.4,0,0.2,1)，与 ReactBits 一致） */
    transition:
      max-width 0.4s var(--ease-nav),
      height 0.4s var(--ease-nav),
      padding 0.4s var(--ease-nav),
      border-radius 0.4s var(--ease-nav),
      background 0.4s var(--ease-nav),
      border-color 0.4s var(--ease-nav),
      box-shadow 0.4s var(--ease-nav),
      backdrop-filter 0.4s var(--ease-nav);
  }
  /* 外层负责"下沉 16px"：padding-top 0 → 16px */
  .site-header {
    transition: transform 0.28s var(--ease), padding-top 0.4s var(--ease-nav);
  }
  /* 移动端：左右各留 16px（规格要求比桌面的 20px 更窄） */
  @media (max-width: 640px) {
    .site-header {
      --nav-w: 100%;
      --nav-w-scrolled: calc(100% - 32px);
    }
  }
  /* 向下滚动超过 80px：下沉 + 收成胶囊（见 ui.js 的 setMaterial） */
  html[data-scrolled='1'] .site-header {
    padding-top: var(--nav-top-scrolled);
  }
  html[data-scrolled='1'] .site-header .hd {
    max-width: var(--nav-w-scrolled);
    height: var(--nav-h-scrolled);
    padding: 0 var(--nav-pad-x-scrolled);
    border-radius: var(--nav-radius-scrolled);
    background: var(--nav-bg-scrolled);
    border-color: var(--nav-border-scrolled);
    box-shadow: var(--nav-shadow-scrolled);
    -webkit-backdrop-filter: var(--nav-blur-scrolled);
    backdrop-filter: var(--nav-blur-scrolled);
  }
  /* 内部元素同步收缩 */
  html[data-scrolled='1'] .site-header .hd-in { padding: 0 var(--nav-in-pad-scrolled, 0px); }
  html[data-scrolled='1'] .site-header .nav { gap: var(--nav-link-gap-scrolled); }
  html[data-scrolled='1'] .site-header .nav a {
    font-size: var(--nav-link-fs-scrolled);
    padding: var(--nav-link-pad-scrolled);
  }
  html[data-scrolled='1'] .site-header :is(.pill, .sm-toggle) { height: var(--nav-ctl-h-scrolled); }
  @media (prefers-reduced-motion: reduce) {
    .hd,
    .site-header { transition: none; }
  }

  /* 内容行：Logo · 中间留白 · 右侧链接组 */
  .hd-in {
    height: 100%;
    /* 容器已给左右 padding（32 → 22），这里只留很小的内侧微调 */
    padding: 0 4px;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  /* 背景动态开关（可访问性）：与主题开关同尺寸；默认低调，不抢画面 */
  .motion-toggle {
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: var(--line-w) solid var(--line-2);
    background: transparent;
    color: var(--ink-3);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }
  .motion-toggle:hover,
  .motion-toggle:focus-visible {
    color: var(--ink);
    border-color: var(--line-hover);
    background: var(--accent-soft);
  }
  .motion-toggle .mt-play { display: none; }
  .motion-toggle[aria-pressed='true'] { color: var(--accent-deep); border-color: var(--accent); }
  .motion-toggle[aria-pressed='true'] .mt-pause { display: none; }
  .motion-toggle[aria-pressed='true'] .mt-play { display: inline-flex; }
  /* —— 品牌（品牌稿横版字标 BrandMark）——
     标志自带 CLOUD/WING 字标，右侧的中文站名只在空间足够时出现。 */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--nav-ink);
    flex: none;
  }
  .brand :global(.brandmark) { display: block; flex: none; }
  .brand .bname {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1;
    color: var(--brand-cloud);
    padding-left: 0.6rem;
    border-left: 1px solid var(--nav-border);
    white-space: nowrap;
  }
  /* 窄屏：字标已经表达了品牌名，中文站名让位（避免与链接组挤在一起） */
  @media (max-width: 1180px) {
    .brand .bname { display: none; }
  }
    display: block;
    font-family: var(--font-mono);
    font-size: 0.54rem;
    font-weight: 500;
    letter-spacing: 0.24em;
