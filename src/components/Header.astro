---
import { SITE, NAV } from '../site';
import { getCollection } from 'astro:content';
import HexMark from './HexMark.astro';

const { current = '/' } = Astro.props;
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);

/* ---------- 各子页面的分类 → 对应导航项的二级菜单 ----------
   作品库的分类 = 作品标签（tags），画廊的分类 = 截图所属游戏（game）。
   两者都由内容集合现算，新增作品/截图后菜单自动更新，不用改这里。 */
const worksAll = await getCollection('works');
const shotsAll = await getCollection('shots');

const countBy = (list: string[]) => {
  const m = new Map<string, number>();
  list.forEach((k) => k && m.set(k, (m.get(k) ?? 0) + 1));
  return [...m.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh'));
};

const workTags = countBy(worksAll.flatMap((e) => e.data.tags ?? []));
const shotGames = countBy(shotsAll.map((e) => e.data.game ?? ''));

const SUBS: Record<string, { label: string; href: string; count?: number; sub?: boolean }[]> = {
  '/works/': [
    { label: '全部作品', href: '/works/', sub: true },
    ...workTags.map(([t, n]) => ({ label: t, href: `/works/?tag=${encodeURIComponent(t)}`, count: n })),
  ],
  '/gallery/': [
    { label: '全部截图', href: '/gallery/', sub: true },
    ...shotGames.map(([g, n]) => ({ label: g, href: `/gallery/?game=${encodeURIComponent(g)}`, count: n })),
  ],
};

const items = NAV.map((item) => ({ ...item, sub: SUBS[item.href] ?? [] }));
const pad = (n: number) => String(n).padStart(2, '0');
---
<header class="site-header" data-nav>
  {/* 悬浮玻璃胶囊：宽 min(1200px, 100% - 40px)、距顶 16px、高 56px（滚动后 52px）、圆角 999px。
      玻璃材质与尺寸都走 --nav-* 令牌（见样式里的「导航胶囊令牌」块）——
      想换成浅色玻璃只改那一块，不必动结构。 */}
  <div class="hd">
    {/* 内容行：Logo · 中间留白 · 右侧链接组 */}
    <div class="hd-in">
    <a class="brand" href="/" aria-label="回到首页">
      <HexMark size={24} fill="var(--ink)" />
      <span class="bname">
        {SITE.latin}
      </span>
    </a>

    <nav class="nav" aria-label="主导航">
      {
        items.map((item) =>
          item.sub.length > 0 ? (
            <span class="nav-item has-sub" data-nav-sub>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
              <button
                type="button"
                class="nav-caret"
                data-nav-caret
                aria-expanded="false"
                aria-haspopup="true"
                aria-label={`展开${item.label}的分类`}
              >
                <svg viewBox="0 0 12 12" width="10" height="10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                  <path d="M2.6 4.4 6 7.8l3.4-3.4" />
                </svg>
              </button>
              <ul class="nav-sub" data-nav-panel hidden>
                {item.sub.map((s) => (
                  <li>
                    <a href={s.href} class:list={[{ 'is-all': s.sub }]}>
                      <span class="ns-label">{s.label}</span>
                      {s.count !== undefined && <span class="ns-count">{pad(s.count)}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </span>
          ) : (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ),
        )
      }
    </nav>

    <div class="acts">
      {SITE.github && (
        <a class="pill ext" href={SITE.github} target="_blank" rel="noreferrer" title="GitHub">
          <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
          </svg>
          <span>GitHub</span>
        </a>
      )}
      {/* 搜索改成悬浮窗触发（原先是 /search/ 独立页面，见 ui.js 的 searchModal()） */}
      <button type="button" class="pill search-pill" data-search-open aria-label="站内搜索" title="站内搜索（⌘/Ctrl + K）">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m16.2 16.2 4.3 4.3" />
        </svg>
        <span>搜索</span>
      </button>
      {/* 主题开关已删除：站点只有一套暗色电影感主题（见 global.css 的 :root 注释） */}
      {/* 可访问性：给"动态背景"一个显式的暂停入口（WCAG 2.2.2 暂停/停止/隐藏）。
          默认仅在 hover/focus 时淡入，不干扰画面；由 VideoBackground 的脚本接管。 */}
      <button
        type="button"
        class="motion-toggle"
        data-motion-toggle
        aria-label="暂停背景动态"
        aria-pressed="false"
        title="暂停 / 播放背景动态"
      >
        <svg class="mt-pause" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <path d="M9 5v14M15 5v14" />
        </svg>
        <svg class="mt-play" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 4.8 19 12 7 19.2Z" />
        </svg>
      </button>
      <button type="button" class="burger" data-nav-burger aria-label="打开菜单" aria-expanded="false">
        <span class="b-line"></span>
        <span class="b-line"></span>
      </button>
    </div>
    </div>
  </div>

  <!-- 移动端抽屉 -->
  <div class="drawer" data-nav-drawer hidden>
    {items.map((item) => (
      <>
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
        {item.sub.length > 1 && (
          <div class="drawer-sub">
            {item.sub.slice(1).map((s) => (
              <a href={s.href}>
                <span>{s.label}</span>
                {s.count !== undefined && <i>{pad(s.count)}</i>}
              </a>
            ))}
          </div>
        )}
      </>
    ))}
    <button type="button" class="drawer-search" data-search-open>搜索</button>
    {SITE.github && (
      <a class="ext" href={SITE.github} target="_blank" rel="noreferrer">GitHub ↗</a>
    )}
  </div>
</header>

<style>
  /* ============================================================
     顶部导航（参考 reactbits.dev 主站导航）
     细玻璃条 + 左侧品牌 + 常驻链接胶囊 + 右侧幽灵胶囊按钮
     ============================================================ */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 70;
    padding: 0; /* 抵消旧版顶栏全局留白 */
    /* 下滑自动收起（ui.js 的 autoHideHeader 切 .hd-hidden）；上滑滑回。
       侧栏的吸顶位移用更短的时长（见 shell.css），保证导航栏滑回时
       侧栏已经让开，两者任何时刻都不重叠。 */
    transition: transform 0.28s var(--ease), opacity 0.28s var(--ease);
    will-change: transform, opacity;
  }
  .site-header.hd-hidden {
    transform: translateY(-102%);
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
  }

  /* ══════════════════════════════════════════════════════════════
     导航胶囊令牌 —— 想换配色只改这一块
     结构/尺寸/交互与配色解耦：下面是"暗色玻璃"版，适配当前暗色电影感站点。
     若要换成规格原文里的**浅色通透**版（白胶囊 + 深字），把这些值换成：
       --nav-bg: rgba(255,255,255,.72);       --nav-bg-scrolled: rgba(255,255,255,.85);
       --nav-border: rgba(255,255,255,.6);    --nav-shadow: 0 4px 24px rgba(0,0,0,.06);
       --nav-shadow-scrolled: 0 8px 32px rgba(0,0,0,.10);
       --nav-ink: #1a1a2e;   --nav-ink-dim: #555;   --nav-hover-bg: rgba(0,0,0,.04);
       --nav-blur: blur(20px) saturate(1.4);  --nav-drawer-bg: rgba(255,255,255,.92);
     ══════════════════════════════════════════════════════════════ */
  .site-header {
    --nav-w: min(1200px, calc(100% - 40px));
    --nav-top: 16px;
    --nav-h: 56px;
    --nav-h-scrolled: 52px;
    /* 半透明 → 视频能透上来（保持暗色电影感） */
    --nav-bg: rgba(9, 12, 16, 0.55);
    --nav-bg-scrolled: rgba(9, 12, 16, 0.78);
    --nav-border: rgba(255, 255, 255, 0.2);
    --nav-border-scrolled: rgba(255, 255, 255, 0.3);
    --nav-shadow: 0 4px 24px rgba(0, 0, 0, 0.28);
    --nav-shadow-scrolled: 0 8px 32px rgba(0, 0, 0, 0.42);
    --nav-blur: blur(20px) saturate(1.4);
    --nav-ink: #ffffff;
    --nav-ink-dim: #c9d1d9;
    --nav-hover-bg: rgba(255, 255, 255, 0.08);
    --nav-link-fs: 14px;
    --nav-link-pad: 8px 14px;
    --nav-link-radius: 10px;
    /* 移动端下拉面板必须**基本不透明**：它盖在正文之上，0.92 这类半透明会让
       下方的正文与视频透上来（实测像素差 347/765，观感像重影）。
       保留一点渐变与模糊，让它仍是"玻璃片"而不是死板色块。 */
    --nav-drawer-bg: linear-gradient(180deg, rgba(9, 12, 16, 0.99), rgba(9, 12, 16, 0.97));
  }

  .hd {
    /* 悬浮胶囊本体：不再是通栏条，而是一块居中、圆角 999px 的玻璃片。
       这里不要用 overflow:hidden —— .nav-sub（二级菜单）是它的绝对定位后代，会被裁掉。 */
    position: relative;
    isolation: isolate;
    width: var(--nav-w);
    height: var(--nav-h);
    margin: var(--nav-top) auto 0;
    border-radius: 999px;
    background: var(--nav-bg);
    border: 1px solid var(--nav-border);
    box-shadow: var(--nav-shadow);
    -webkit-backdrop-filter: var(--nav-blur);
    backdrop-filter: var(--nav-blur);
    /* 只过渡高度/背景/阴影/边框 —— 不硬切 position，也不动 transform（那是收起的职责） */
    transition:
      height 0.28s var(--ease),
      background 0.28s var(--ease),
      box-shadow 0.28s var(--ease),
      border-color 0.28s var(--ease);
  }
  /* 移动端：左右各留 16px（规格要求比桌面的 20px 更窄） */
  @media (max-width: 640px) {
    .site-header { --nav-w: calc(100% - 32px); }
  }
  /* 向下滚动超过 80px：胶囊变矮、玻璃加深、阴影加重（见 ui.js 的 setMaterial） */
  html[data-scrolled='1'] .site-header .hd {
    height: var(--nav-h-scrolled);
    background: var(--nav-bg-scrolled);
    border-color: var(--nav-border-scrolled);
    box-shadow: var(--nav-shadow-scrolled);
  }
  @media (prefers-reduced-motion: reduce) {
    .hd { transition: none; }
  }

  /* 内容行：Logo · 中间留白 · 右侧链接组 */
  .hd-in {
    height: 100%;
    padding: 0 10px 0 18px;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  /* 背景动态开关（可访问性）：与主题开关同尺寸；默认低调，不抢画面 */
  .motion-toggle {
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: var(--line-w) solid var(--line-2);
    background: transparent;
    color: var(--ink-3);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }
  .motion-toggle:hover,
  .motion-toggle:focus-visible {
    color: var(--ink);
    border-color: var(--line-hover);
    background: var(--accent-soft);
  }
  .motion-toggle .mt-play { display: none; }
  .motion-toggle[aria-pressed='true'] { color: var(--accent-deep); border-color: var(--accent); }
  .motion-toggle[aria-pressed='true'] .mt-pause { display: none; }
  .motion-toggle[aria-pressed='true'] .mt-play { display: inline-flex; }
  /* —— 品牌（Logo）——
     规格：15px / 字重 600 / --nav-ink / 字距 -0.01em */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--nav-ink);
    flex: none;
  }
  .brand .bname {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1;
    text-transform: none; /* 胶囊风格下不再全大写，更轻盈 */
  }
  .brand .bname small {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.54rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    color: var(--nav-ink-dim);
  }

  /* —— 中部链接胶囊 —— */
  .nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    flex: 1 1 auto;
    min-width: 0;
  }
  /* —— 链接：14px / 500 / padding 8px 14px / 圆角 10px —— */
  .nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: var(--nav-link-pad);
    border-radius: var(--nav-link-radius);
    border: 0;
    font-family: var(--font-body);
    font-size: var(--nav-link-fs);
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--nav-ink-dim);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease, background 0.2s ease;
  }
  .nav a:hover {
    color: var(--nav-ink);
    background: var(--nav-hover-bg);
  }
  /* 当前页：底部 2px 雾蓝短横线（**不整块高亮**，保持轻盈） */
  .nav a[aria-current='page'] {
    color: var(--nav-ink);
    background: transparent;
  }
  .nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 3px;
    translate: -50% 0;
    width: 18px;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
  }

  /* —— 导航二级菜单（各子页面的分类）—— */
  .nav-item {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }
  .nav-caret {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink-3);
    cursor: pointer;
    transition: transform 0.18s var(--ease), color 0.16s ease, background 0.16s ease;
  }
  .nav-caret:hover {
    color: var(--accent-deep);
    background: var(--accent-soft);
  }
  .nav-item[data-open='true'] .nav-caret {
    color: var(--accent-deep);
    transform: rotate(180deg);
  }
  .nav-item[data-open='true'] > a {
    color: var(--ink);
    background: var(--accent-soft);
  }
  .nav-sub {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%) translateY(-6px);
    min-width: 190px;
    margin: 0;
    padding: 0.4rem;
    list-style: none;
    /* 与顶栏同一套玻璃：明显的边框 + 边框内高斯模糊。
       背景用 --glass-panel（比 --glass-strong 更实）：二级菜单浮在正文/卡片之上，
       太透会让底下的内容透进来、看起来像渲染错乱（实测就是这个症状）。 */
    border: var(--line-w) solid var(--line-2);
    border-radius: 14px;
    background: var(--glass-panel);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.18s var(--ease), transform 0.18s var(--ease), visibility 0.18s;
    z-index: 80;
  }
  .nav-item[data-open='true'] .nav-sub {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }
  .nav-sub[hidden] {
    display: block; /* 用 opacity/visibility 做动画，这里不让 hidden 直接掐掉过渡 */
  }
  .nav-sub li + li {
    margin-top: 2px;
  }
  .nav-sub a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    padding: 0.4rem 0.6rem;
    border-radius: 10px;
    font-size: 0.76rem;
    letter-spacing: 0.04em;
    color: var(--ink-2);
  }
  .nav-sub a:hover {
    color: var(--ink);
    background: var(--accent-soft);
  }
  .nav-sub a.is-all {
    color: var(--accent-deep);
    font-weight: 500;
  }
  .nav-sub .ns-count {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .nav-sub li + li.is-all,
  .nav-sub li:first-child + li {
    border-top: 1px solid var(--line-1);
  }
  .nav-sub li:first-child + li {
    margin-top: 0.3rem;
    padding-top: 0.3rem;
  }

  /* —— 右侧动作（幽灵胶囊按钮簇） —— */
  .acts {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: none;
  }
  .pill,
  .burger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    height: 40px;
    border-radius: 999px;
    /* 走全局粗细令牌（原先写死 1px，且 Astro 作用域选择器优先级更高，
       会盖掉 global/motion 里的 var(--line-w) 加粗） */
    border: var(--line-w) solid var(--line-2);
    background: var(--glass-soft);
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.06em;
    cursor: pointer;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: background 0.16s ease, color 0.16s ease, border-color 0.16s ease, transform 0.16s var(--ease);
  }
  .pill {
    padding: 0 1rem;
  }
  .pill:hover,
    color: var(--accent-deep);
    border-color: var(--accent);
    background: var(--accent-soft);
    transform: translateY(-1px);
  }
    width: 40px;
    flex: none;
    padding: 0;
  }
  .burger {
    display: none;
    width: 40px;
    padding: 0;
    flex-direction: column;
    gap: 5px;
  }
  .b-line {
    width: 16px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.25s ease;
  }

  .site-header.menu-open .b-line:first-child { transform: translateY(3.5px) rotate(45deg); }
  .site-header.menu-open .b-line:last-child { transform: translateY(-3.5px) rotate(-45deg); }
  .site-header.menu-open .burger { color: var(--accent-deep); }

  /* —— 移动端菜单：从顶部下拉的玻璃面板 ——
     规格：背景 rgba(255,255,255,.92) + blur(24px)、圆角 20px、淡入 + 轻微下移 */
  .drawer {
    position: absolute;
    top: calc(100% + 10px);
    left: 16px;
    right: 16px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px;
    border-radius: 20px;
    border: 1px solid var(--nav-border);
    background: var(--nav-drawer-bg);
    -webkit-backdrop-filter: blur(24px) saturate(1.4);
    backdrop-filter: blur(24px) saturate(1.4);
    box-shadow: var(--nav-shadow-scrolled);
    animation: nav-in 0.24s var(--ease);
  }
  .drawer[hidden] { display: none; }
  /* 抽屉里的二级分类（缩进一级，挂在对应页面项下面） */
  .drawer-sub {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: -2px 0 6px 1.15rem;
    padding-left: 0.7rem;
    border-left: var(--line-w) solid var(--line-2);
  }
  .drawer-sub a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.6rem;
    border: var(--line-w) solid var(--line-2);
    border-radius: 999px;
    font-size: 0.74rem;
    color: var(--ink-2);
    background: transparent;
  }
  .drawer-sub a i {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 0.62rem;
    color: var(--ink-3);
  }
  .drawer-sub a:hover {
    color: var(--accent-deep);
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  @keyframes nav-in {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: none; }
  }
  .drawer a {
    display: block;
    padding: 0.65rem 1rem;
    border-radius: 12px;
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 0.88rem;
    letter-spacing: 0.08em;
    text-decoration: none;
  }
  .drawer a:hover { background: var(--accent-soft); color: var(--ink); }
  /* 抽屉里的「搜索」是按钮（触发悬浮窗），外观与链接一致 */
  .drawer-search {
    display: block;
    width: 100%;
    text-align: left;
    padding: 0.65rem 1rem;
    border: 0;
    border-radius: 12px;
    background: transparent;
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 0.88rem;
    letter-spacing: 0.08em;
    cursor: pointer;
  }
  .drawer-search:hover { background: var(--accent-soft); color: var(--ink); }
  .drawer a[aria-current='page'] { color: var(--accent-deep); background: var(--accent-soft); }
  .drawer a.ext { color: var(--ink-3); font-size: 0.8rem; }

  @media (max-width: 960px) {
    .nav { display: none; }
    .burger { display: inline-flex; }
  }
  /* 手机端：品牌 + 4 个圆按钮挤在一条 40px 高的胶囊里太局促。
     收紧品牌字号/图标、缩小按钮与间距，并允许品牌在极窄屏被压缩（省略号），
     避免出现"贴边"或溢出。 */
  @media (max-width: 620px) {
    .topbar { gap: 0.5rem; padding: 0.4rem 0.45rem 0.4rem 0.75rem; }
    .brand { gap: 0.4rem; min-width: 0; overflow: hidden; }
    .brand .hex { width: 22px; height: 22px; }
    .brand .bname { font-size: 0.82rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .brand .bname small { font-size: 0.46rem; letter-spacing: 0.16em; }
    .acts { gap: 5px; }
    .pill,    .pill.ext, .pill.search-pill { width: 36px; }
    .nav-caret { width: 18px; height: 18px; }
  }
  @media (max-width: 520px) {
    .pill.ext span { display: none; }
    .pill.ext { padding: 0; }
    .pill.search-pill span { display: none; }
    .pill.search-pill { padding: 0; }
  }
  @media (max-width: 400px) {
    .brand .bname small { display: none; }  /* 极窄屏先去掉副标题，保住导航按钮 */
  }
  /* 中等宽度（≤960）导航链接隐藏时，搜索胶囊保留文字更易识别 */
  @media (max-width: 960px) and (min-width: 521px) {
    .pill.search-pill { padding: 0 0.85rem; }
  }
</style>

<script>
  // 移动端菜单：汉堡切换抽屉。
  // 用“全局单次监听 + document 事件委托”实现：ClientRouter 软导航会重建 Header，
  // 若把监听绑在首屏元素上，导航后新汉堡会失效 —— 委托到 document 则 DOM 重建后依然生效。
  const setOpen = (open) => {
    const header = document.querySelector('[data-nav]');
    const drawer = header?.querySelector('[data-nav-drawer]');
    const burger = header?.querySelector('[data-nav-burger]');
    if (!header || !drawer || !burger) return;
    header.classList.toggle('menu-open', open);
    drawer.hidden = !open;
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
  };

  const onDocClick = (e) => {
    const burger = e.target.closest('[data-nav-burger]');
    const header = document.querySelector('[data-nav]');
    const drawer = header?.querySelector('[data-nav-drawer]');
    if (!header || !drawer) return;

    if (burger) {
      // 点汉堡：当前 hidden → 打开，否则关闭
      setOpen(drawer.hidden);
      return;
    }
    // 点击抽屉内的链接 → 关闭（链接自身的导航由 ClientRouter 处理）
    if (e.target.closest('[data-nav-drawer] a')) {
      setOpen(false);
      return;
    }
    // 点击抽屉/汉堡以外的区域 → 关闭
    if (!e.target.closest('[data-nav-drawer]') && !e.target.closest('.site-header')) {
      setOpen(false);
    }
  };

  // 只挂载一次（脚本模块在软导航时会重新执行，幂等保护避免重复监听）
  if (!window.__cwNavWired) {
    window.__cwNavWired = true;
    document.addEventListener('click', onDocClick);
  }
</script>
