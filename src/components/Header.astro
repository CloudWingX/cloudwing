---
import { SITE, NAV } from '../site';
import { getCollection } from 'astro:content';
import HexMark from './HexMark.astro';

const { current = '/' } = Astro.props;
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);

/* ---------- 各子页面的分类 → 对应导航项的二级菜单 ----------
   作品库的分类 = 作品标签（tags），画廊的分类 = 截图所属游戏（game）。
   两者都由内容集合现算，新增作品/截图后菜单自动更新，不用改这里。 */
const worksAll = await getCollection('works');
const shotsAll = await getCollection('shots');

const countBy = (list: string[]) => {
  const m = new Map<string, number>();
  list.forEach((k) => k && m.set(k, (m.get(k) ?? 0) + 1));
  return [...m.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh'));
};

const workTags = countBy(worksAll.flatMap((e) => e.data.tags ?? []));
const shotGames = countBy(shotsAll.map((e) => e.data.game ?? ''));

const SUBS: Record<string, { label: string; href: string; count?: number; sub?: boolean }[]> = {
  '/works/': [
    { label: '全部作品', href: '/works/', sub: true },
    ...workTags.map(([t, n]) => ({ label: t, href: `/works/?tag=${encodeURIComponent(t)}`, count: n })),
  ],
  '/gallery/': [
    { label: '全部截图', href: '/gallery/', sub: true },
    ...shotGames.map(([g, n]) => ({ label: g, href: `/gallery/?game=${encodeURIComponent(g)}`, count: n })),
  ],
};

const items = NAV.map((item) => ({ ...item, sub: SUBS[item.href] ?? [] }));
const pad = (n: number) => String(n).padStart(2, '0');
---
<header class="site-header" data-nav>
  <div class="hd">
    <a class="brand" href="/" aria-label="回到首页">
      <HexMark size={24} fill="var(--ink)" />
      <span class="bname">
        {SITE.latin}
      </span>
    </a>

    <nav class="nav" aria-label="主导航">
      {
        items.map((item) =>
          item.sub.length > 0 ? (
            <span class="nav-item has-sub" data-nav-sub>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
              <button
                type="button"
                class="nav-caret"
                data-nav-caret
                aria-expanded="false"
                aria-haspopup="true"
                aria-label={`展开${item.label}的分类`}
              >
                <svg viewBox="0 0 12 12" width="10" height="10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                  <path d="M2.6 4.4 6 7.8l3.4-3.4" />
                </svg>
              </button>
              <ul class="nav-sub" data-nav-panel hidden>
                {item.sub.map((s) => (
                  <li>
                    <a href={s.href} class:list={[{ 'is-all': s.sub }]}>
                      <span class="ns-label">{s.label}</span>
                      {s.count !== undefined && <span class="ns-count">{pad(s.count)}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </span>
          ) : (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ),
        )
      }
    </nav>

    <div class="acts">
      {SITE.github && (
        <a class="pill ext" href={SITE.github} target="_blank" rel="noreferrer" title="GitHub">
          <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
          </svg>
          <span>GitHub</span>
        </a>
      )}
      <a class="pill search-pill" href="/search/" aria-label="站内搜索" title="站内搜索">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m16.2 16.2 4.3 4.3" />
        </svg>
        <span>搜索</span>
      </a>
      <button type="button" class="theme-toggle" aria-label="当前为白日模式，点击切换到夜间模式" aria-pressed="false" title="白日 / 夜间">
        <span class="ico-moon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20.2 13.6A8.6 8.6 0 0 1 10.4 3.8a8.6 8.6 0 1 0 9.8 9.8Z"/></svg>
        </span>
        <span class="ico-sun" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><circle cx="12" cy="12" r="4.1"/><path d="M12 2.8v2.3M12 18.9v2.3M2.8 12h2.3M18.9 12h2.3M5.5 5.5l1.6 1.6M16.9 16.9l1.6 1.6M18.5 5.5l-1.6 1.6M7.1 16.9l-1.6 1.6"/></svg>
        </span>
      </button>
      <button type="button" class="burger" data-nav-burger aria-label="打开菜单" aria-expanded="false">
        <span class="b-line"></span>
        <span class="b-line"></span>
      </button>
    </div>
  </div>

  <!-- 移动端抽屉 -->
  <div class="drawer" data-nav-drawer hidden>
    {items.map((item) => (
      <>
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
        {item.sub.length > 1 && (
          <div class="drawer-sub">
            {item.sub.slice(1).map((s) => (
              <a href={s.href}>
                <span>{s.label}</span>
                {s.count !== undefined && <i>{pad(s.count)}</i>}
              </a>
            ))}
          </div>
        )}
      </>
    ))}
    <a href="/search/" aria-current={isActive('/search/') ? 'page' : undefined}>搜索</a>
    {SITE.github && (
      <a class="ext" href={SITE.github} target="_blank" rel="noreferrer">GitHub ↗</a>
    )}
  </div>
</header>

<style>
  /* ============================================================
     顶部导航（参考 reactbits.dev 主站导航）
     细玻璃条 + 左侧品牌 + 常驻链接胶囊 + 右侧幽灵胶囊按钮
     ============================================================ */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 70;
    padding: 0; /* 抵消旧版顶栏全局留白 */
    /* 下滑自动收起（ui.js 的 autoHideHeader 切 .hd-hidden）；上滑滑回。
       侧栏的吸顶位移用更短的时长（见 shell.css），保证导航栏滑回时
       侧栏已经让开，两者任何时刻都不重叠。 */
    transition: transform 0.28s var(--ease), opacity 0.28s var(--ease);
    will-change: transform, opacity;
  }
  .site-header.hd-hidden {
    transform: translateY(-102%);
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
  }

  .hd {
    max-width: calc(var(--w-max) + 2 * var(--gutter));
    margin: 0 auto;
    padding: 12px var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  /* —— 品牌 —— */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--ink);
    flex: none;
  }
  .brand .bname {
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    line-height: 1.05;
  }
  .brand .bname small {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.54rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    color: var(--ink-3);
  }

  /* —— 中部链接胶囊 —— */
  .nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    flex: 1 1 auto;
    min-width: 0;
  }
  .nav a {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    border: 1px solid transparent;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: var(--ink-2);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.16s ease, background 0.16s ease, border-color 0.16s ease;
  }
  .nav a:hover {
    color: var(--ink);
    background: var(--accent-soft);
  }
  .nav a[aria-current='page'] {
    color: var(--accent-deep);
    background: var(--accent-soft);
    border-color: color-mix(in srgb, var(--accent) 28%, transparent);
  }

  /* —— 导航二级菜单（各子页面的分类）—— */
  .nav-item {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }
  .nav-caret {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink-3);
    cursor: pointer;
    transition: transform 0.18s var(--ease), color 0.16s ease, background 0.16s ease;
  }
  .nav-caret:hover {
    color: var(--accent-deep);
    background: var(--accent-soft);
  }
  .nav-item[data-open='true'] .nav-caret {
    color: var(--accent-deep);
    transform: rotate(180deg);
  }
  .nav-item[data-open='true'] > a {
    color: var(--ink);
    background: var(--accent-soft);
  }
  .nav-sub {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%) translateY(-6px);
    min-width: 190px;
    margin: 0;
    padding: 0.4rem;
    list-style: none;
    border: var(--line-w) solid var(--line-2);
    border-radius: 14px;
    background: var(--glass-strong);
    -webkit-backdrop-filter: blur(20px) saturate(1.5);
    backdrop-filter: blur(20px) saturate(1.5);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.18s var(--ease), transform 0.18s var(--ease), visibility 0.18s;
    z-index: 80;
  }
  .nav-item[data-open='true'] .nav-sub {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }
  .nav-sub[hidden] {
    display: block; /* 用 opacity/visibility 做动画，这里不让 hidden 直接掐掉过渡 */
  }
  .nav-sub li + li {
    margin-top: 2px;
  }
  .nav-sub a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    padding: 0.4rem 0.6rem;
    border-radius: 10px;
    font-size: 0.76rem;
    letter-spacing: 0.04em;
    color: var(--ink-2);
  }
  .nav-sub a:hover {
    color: var(--ink);
    background: var(--accent-soft);
  }
  .nav-sub a.is-all {
    color: var(--accent-deep);
    font-weight: 600;
  }
  .nav-sub .ns-count {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .nav-sub li + li.is-all,
  .nav-sub li:first-child + li {
    border-top: 1px solid var(--line-1);
  }
  .nav-sub li:first-child + li {
    margin-top: 0.3rem;
    padding-top: 0.3rem;
  }

  /* —— 右侧动作（幽灵胶囊按钮簇） —— */
  .acts {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: none;
  }
  .pill,
  .theme-toggle,
  .burger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    height: 40px;
    border-radius: 999px;
    /* 走全局粗细令牌（原先写死 1px，且 Astro 作用域选择器优先级更高，
       会盖掉 global/motion 里的 var(--line-w) 加粗） */
    border: var(--line-w) solid var(--line-2);
    background: var(--glass-soft);
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.06em;
    cursor: pointer;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: background 0.16s ease, color 0.16s ease, border-color 0.16s ease, transform 0.16s var(--ease);
  }
  .pill {
    padding: 0 1rem;
  }
  .pill:hover,
  .theme-toggle:hover {
    color: var(--accent-deep);
    border-color: var(--accent);
    background: var(--accent-soft);
    transform: translateY(-1px);
  }
  .theme-toggle {
    width: 40px;
    flex: none;
    padding: 0;
  }
  .burger {
    display: none;
    width: 40px;
    padding: 0;
    flex-direction: column;
    gap: 5px;
  }
  .b-line {
    width: 16px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.25s ease;
  }

  .site-header.menu-open .b-line:first-child { transform: translateY(3.5px) rotate(45deg); }
  .site-header.menu-open .b-line:last-child { transform: translateY(-3.5px) rotate(-45deg); }
  .site-header.menu-open .burger { color: var(--accent-deep); }

  /* —— 移动端抽屉 —— */
  .drawer {
    position: absolute;
    top: calc(100% - 4px);
    left: var(--gutter);
    right: var(--gutter);
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px;
    border-radius: 18px;
    border: var(--line-w) solid var(--line-2);
    background: var(--glass-strong);
    backdrop-filter: blur(24px) saturate(1.5);
    -webkit-backdrop-filter: blur(24px) saturate(1.5);
    box-shadow: var(--shadow-lg);
    animation: nav-in 0.22s var(--ease);
  }
  .drawer[hidden] { display: none; }
  /* 抽屉里的二级分类（缩进一级，挂在对应页面项下面） */
  .drawer-sub {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: -2px 0 6px 1.15rem;
    padding-left: 0.7rem;
    border-left: var(--line-w) solid var(--line-2);
  }
  .drawer-sub a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.6rem;
    border: var(--line-w) solid var(--line-2);
    border-radius: 999px;
    font-size: 0.74rem;
    color: var(--ink-2);
    background: transparent;
  }
  .drawer-sub a i {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 0.62rem;
    color: var(--ink-3);
  }
  .drawer-sub a:hover {
    color: var(--accent-deep);
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  @keyframes nav-in {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: none; }
  }
  .drawer a {
    display: block;
    padding: 0.65rem 1rem;
    border-radius: 12px;
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 0.88rem;
    letter-spacing: 0.08em;
    text-decoration: none;
  }
  .drawer a:hover { background: var(--accent-soft); color: var(--ink); }
  .drawer a[aria-current='page'] { color: var(--accent-deep); background: var(--accent-soft); }
  .drawer a.ext { color: var(--ink-3); font-size: 0.8rem; }

  @media (max-width: 960px) {
    .nav { display: none; }
    .burger { display: inline-flex; }
  }
  /* 手机端：品牌 + 4 个圆按钮挤在一条 40px 高的胶囊里太局促。
     收紧品牌字号/图标、缩小按钮与间距，并允许品牌在极窄屏被压缩（省略号），
     避免出现"贴边"或溢出。 */
  @media (max-width: 620px) {
    .topbar { gap: 0.5rem; padding: 0.4rem 0.45rem 0.4rem 0.75rem; }
    .brand { gap: 0.4rem; min-width: 0; overflow: hidden; }
    .brand .hex { width: 22px; height: 22px; }
    .brand .bname { font-size: 0.82rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .brand .bname small { font-size: 0.46rem; letter-spacing: 0.16em; }
    .acts { gap: 5px; }
    .pill, .theme-toggle, .burger { height: 36px; }
    .pill.ext, .pill.search-pill { width: 36px; }
    .nav-caret { width: 18px; height: 18px; }
  }
  @media (max-width: 520px) {
    .pill.ext span { display: none; }
    .pill.ext { padding: 0; }
    .pill.search-pill span { display: none; }
    .pill.search-pill { padding: 0; }
  }
  @media (max-width: 400px) {
    .brand .bname small { display: none; }  /* 极窄屏先去掉副标题，保住导航按钮 */
  }
  /* 中等宽度（≤960）导航链接隐藏时，搜索胶囊保留文字更易识别 */
  @media (max-width: 960px) and (min-width: 521px) {
    .pill.search-pill { padding: 0 0.85rem; }
  }
</style>

<script>
  // 移动端菜单：汉堡切换抽屉。
  // 用“全局单次监听 + document 事件委托”实现：ClientRouter 软导航会重建 Header，
  // 若把监听绑在首屏元素上，导航后新汉堡会失效 —— 委托到 document 则 DOM 重建后依然生效。
  const setOpen = (open) => {
    const header = document.querySelector('[data-nav]');
    const drawer = header?.querySelector('[data-nav-drawer]');
    const burger = header?.querySelector('[data-nav-burger]');
    if (!header || !drawer || !burger) return;
    header.classList.toggle('menu-open', open);
    drawer.hidden = !open;
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
  };

  const onDocClick = (e) => {
    const burger = e.target.closest('[data-nav-burger]');
    const header = document.querySelector('[data-nav]');
    const drawer = header?.querySelector('[data-nav-drawer]');
    if (!header || !drawer) return;

    if (burger) {
      // 点汉堡：当前 hidden → 打开，否则关闭
      setOpen(drawer.hidden);
      return;
    }
    // 点击抽屉内的链接 → 关闭（链接自身的导航由 ClientRouter 处理）
    if (e.target.closest('[data-nav-drawer] a')) {
      setOpen(false);
      return;
    }
    // 点击抽屉/汉堡以外的区域 → 关闭
    if (!e.target.closest('[data-nav-drawer]') && !e.target.closest('.site-header')) {
      setOpen(false);
    }
  };

  // 只挂载一次（脚本模块在软导航时会重新执行，幂等保护避免重复监听）
  if (!window.__cwNavWired) {
    window.__cwNavWired = true;
    document.addEventListener('click', onDocClick);
  }
</script>
