---
import { SITE, NAV } from '../site';
import { getCollection } from 'astro:content';
import BrandMark from './BrandMark.astro';

const { current = '/' } = Astro.props;
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);

/* ---------- 各子页面的分类 → 对应导航项的二级菜单 ----------
   作品库的分类 = 作品标签（tags），画廊的分类 = 截图所属游戏（game）。
   两者都由内容集合现算，新增作品/截图后菜单自动更新，不用改这里。 */
const worksAll = await getCollection('works');
const shotsAll = await getCollection('shots');

const countBy = (list: string[]) => {
  const m = new Map<string, number>();
  list.forEach((k) => k && m.set(k, (m.get(k) ?? 0) + 1));
  return [...m.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh'));
};

const workTags = countBy(worksAll.flatMap((e) => e.data.tags ?? []));
const shotGames = countBy(shotsAll.map((e) => e.data.game ?? ''));

const SUBS: Record<string, { label: string; href: string; count?: number; sub?: boolean }[]> = {
  '/works/': [
    { label: '全部作品', href: '/works/', sub: true },
    ...workTags.map(([t, n]) => ({ label: t, href: `/works/?tag=${encodeURIComponent(t)}`, count: n })),
  ],
  '/gallery/': [
    { label: '全部截图', href: '/gallery/', sub: true },
    ...shotGames.map(([g, n]) => ({ label: g, href: `/gallery/?game=${encodeURIComponent(g)}`, count: n })),
  ],
};

const items = NAV.map((item) => ({ ...item, sub: SUBS[item.href] ?? [] }));
const pad = (n: number) => String(n).padStart(2, '0');

/* 侧边面板底部的社交链接（ReactBits StaggeredMenu 的 socialItems 位） */
const socials = [
  SITE.github && { label: 'GitHub', href: SITE.github },
  SITE.bilibili && { label: 'Bilibili', href: SITE.bilibili },
  SITE.email && { label: 'Email', href: `mailto:${SITE.email}` },
  { label: 'RSS', href: '/rss.xml' },
].filter(Boolean) as { label: string; href: string }[];
---
<header class="site-header" data-nav>
  {/* 悬浮玻璃胶囊：宽 min(1200px, 100% - 40px)、距顶 16px、高 56px（滚动后 52px）、圆角 999px。
      玻璃材质与尺寸都走 --nav-* 令牌（见样式里的「导航胶囊令牌」块）——
      想换成浅色玻璃只改那一块，不必动结构。 */}
  <div class="hd">
    {/* 内容行：Logo · 中间留白 · 右侧链接组 */}
    <div class="hd-in">
    <a class="brand" href="/" aria-label="CloudWing 云翼 · 回到首页">
      {/* 品牌标志：横版字标（云 + 三根羽翼 + CLOUD/WING），见 BrandMark.astro */}
      <BrandMark variant="horizontal" height={30} />
      {/* 空间充足时附带中文站点名；极窄屏由 CSS 隐藏（品牌标本身已含字标） */}
      <span class="bname">{SITE.title}</span>
    </a>

    <nav class="nav" aria-label="主导航">
      {
        items.map((item) =>
          item.sub.length > 0 ? (
            <span class="nav-item has-sub" data-nav-sub>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
              <button
                type="button"
                class="nav-caret"
                data-nav-caret
                aria-expanded="false"
                aria-haspopup="true"
                aria-label={`展开${item.label}的分类`}
              >
                <svg viewBox="0 0 12 12" width="10" height="10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                  <path d="M2.6 4.4 6 7.8l3.4-3.4" />
                </svg>
              </button>
              <ul class="nav-sub" data-nav-panel hidden>
                {item.sub.map((s) => (
                  <li>
                    <a href={s.href} class:list={[{ 'is-all': s.sub }]}>
                      <span class="ns-label">{s.label}</span>
                      {s.count !== undefined && <span class="ns-count">{pad(s.count)}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </span>
          ) : (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ),
        )
      }
    </nav>

    <div class="acts">
      {SITE.github && (
        <a class="pill ext" href={SITE.github} target="_blank" rel="noreferrer" title="GitHub">
          <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
          </svg>
          <span>GitHub</span>
        </a>
      )}
      {/* 搜索改成悬浮窗触发（原先是 /search/ 独立页面，见 ui.js 的 searchModal()） */}
      <button type="button" class="pill search-pill" data-search-open aria-label="站内搜索" title="站内搜索（⌘/Ctrl + K）">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m16.2 16.2 4.3 4.3" />
        </svg>
        <span>搜索</span>
      </button>
      {/* 主题开关已删除：站点只有一套暗色电影感主题（见 global.css 的 :root 注释） */}
      {/* 可访问性：给"动态背景"一个显式的暂停入口（WCAG 2.2.2 暂停/停止/隐藏）。
          默认仅在 hover/focus 时淡入，不干扰画面；由 VideoBackground 的脚本接管。 */}
      <button
        type="button"
        class="motion-toggle"
        data-motion-toggle
        aria-label="暂停背景动态"
        aria-pressed="false"
        title="暂停 / 播放背景动态"
      >
        <svg class="mt-pause" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <path d="M9 5v14M15 5v14" />
        </svg>
        <svg class="mt-play" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 4.8 19 12 7 19.2Z" />
        </svg>
      </button>
      {/* ReactBits StaggeredMenu 的开关：加号 ⇄ 叉号（整体旋转 225°，见 nav-staggered.js） */}
      <button
        type="button"
        class="sm-toggle"
        data-sm-toggle
        aria-label="打开菜单"
        aria-expanded="false"
        aria-controls="cw-staggered-panel"
      >
        <span class="sm-toggle-textWrap" aria-hidden="true">
          <span class="sm-toggle-textInner" data-sm-text>
            <span class="sm-toggle-line">菜单</span>
            <span class="sm-toggle-line">关闭</span>
          </span>
        </span>
        <span class="sm-icon" data-sm-icon aria-hidden="true">
          <span class="sm-icon-line" data-sm-plus-h></span>
          <span class="sm-icon-line" data-sm-plus-v></span>
        </span>
      </button>
    </div>
    </div>
  </div>
</header>

{/* ── ReactBits 风格侧边菜单（StaggeredMenu）──
    两层预层 + 主面板依次滑入；菜单项自下而上"旋转 + 上移"入场；社交链接最后淡入。
    动画在 scripts/nav-staggered.js，参数照 ReactBits 原实现。
    ★必须放在 </header> 之外★：.site-header 带 will-change: transform，
    会让它成为 fixed 后代的**包含块** —— 面板会按 header 的高度（约 72px）定位，
    而不是视口，手机上面板会被压成一条。
    ⚠️ 它带 transition:persist 由 Astro 的 ClientRouter 复用，软导航后不回退。 */}
<div class="sm-root" transition:persist="cw-staggered">
  <div class="sm-prelayers" data-sm-prelayers aria-hidden="true">
    <span class="sm-prelayer sm-prelayer--2"></span>
    <span class="sm-prelayer sm-prelayer--1"></span>
  </div>
  <aside id="cw-staggered-panel" class="sm-panel" data-sm-panel aria-hidden="true" aria-label="站点菜单">
    <ul class="sm-panel-list" data-numbering>
      {items.map((item) => (
        <li class="sm-panel-itemWrap">
          <a class="sm-panel-item" href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            <span class="sm-panel-itemLabel">{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
    <div class="sm-socials">
      <p class="sm-socials-title">联系与订阅</p>
      <ul class="sm-socials-list">
        {socials.map((s) => (
          <li>
            <a
              class="sm-socials-link"
              href={s.href}
              target={s.href.startsWith('http') ? '_blank' : undefined}
              rel={s.href.startsWith('http') ? 'noreferrer' : undefined}
            >
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </aside>
</div>

<style>
  /* ============================================================
     顶部导航（参考 reactbits.dev 主站导航）
     细玻璃条 + 左侧品牌 + 常驻链接胶囊 + 右侧幽灵胶囊按钮
     ============================================================ */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 70;
    padding: 0; /* 抵消旧版顶栏全局留白 */
    /* 下滑自动收起（ui.js 的 autoHideHeader 切 .hd-hidden）；上滑滑回。
       侧栏的吸顶位移用更短的时长（见 shell.css），保证导航栏滑回时
       侧栏已经让开，两者任何时刻都不重叠。 */
    transition: transform 0.28s var(--ease), opacity 0.28s var(--ease);
    will-change: transform, opacity;
  }
  .site-header.hd-hidden {
    transform: translateY(-102%);
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
  }

  /* ══════════════════════════════════════════════════════════════
     ReactBits 风格侧边菜单（StaggeredMenu）+ 顶部指示线
     参数照 ReactBits 原实现（reactbits.dev）：
       预层 xPercent 滑入，每层延迟 0.07s（power4.out）
       菜单项 yPercent 140→0 + rotate 10→0，stagger 0.1（power4.out）
       社交链接最后淡入
     配色用页面的 --nav-* / --accent，保持暗色电影感。
     ══════════════════════════════════════════════════════════════ */

  /* ── 开关按钮：加号 ⇄ 叉号 ── */
  .sm-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 40px;
    padding: 0 0.85rem;
    border: var(--line-w) solid var(--line-2);
    border-radius: 999px;
    background: var(--glass-soft);
    color: var(--nav-ink-dim);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    line-height: 1;
    cursor: pointer;
    overflow: visible; /* 图标旋转到 225° 时可能需要溢出一点，别裁掉 */
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }
  .sm-toggle:hover,
  .sm-toggle:focus-visible {
    color: var(--nav-ink);
    border-color: var(--line-hover);
    background: var(--accent-soft);
  }
  /* 文案上下滚动切换（ReactBits 的 textCycle）：容器 1em 高，内部整体 yPercent 位移 */
  .sm-toggle-textWrap {
    position: relative;
    display: inline-block;
    height: 1em;
    overflow: hidden;
    white-space: nowrap;
  }
  .sm-toggle-textInner {
    display: flex;
    flex-direction: column;
    line-height: 1;
    will-change: transform;
  }
  .sm-toggle-line {
    display: block;
    height: 1em;
    line-height: 1;
  }
  /* 加号：两条线十字交叉；外层整体旋转即变叉号 */
  .sm-icon {
    position: relative;
    width: 14px;
    height: 14px;
    flex: 0 0 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    will-change: transform;
  }
  .sm-icon-line {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 100%;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transform: translate(-50%, -50%);
    will-change: transform;
  }

  /* ── 预层（2 层，依次滑入；只有 transform + opacity）── */
  .sm-root {
    /* 覆盖层容器：不参与布局，只作为面板/预层的父级（在 header 之外，避免 header 的
       will-change: transform 成为 fixed 的包含块）*/
    position: fixed;
    inset: 0;
    z-index: 64;
    pointer-events: none;
    /* ★必须裁切★：关闭态下面板/预层停在视口右侧之外（translateX(100%)），
       不裁切会让文档产生约 380px 的横向溢出（实测窄视口溢出 1px）。 */
    overflow: hidden;
  }
  /* 预层容器：主面板**之后**（更靠近观察者）会盖住菜单文字，
     所以靠 z-index 把它压到面板下面 —— 面板是 z-index 2，预层 0，两者都在 .sm-root 内。 */
  .sm-prelayers {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: var(--sm-panel-w);
    pointer-events: none;
    z-index: 0;
    opacity: 0;
  }
  .sm-prelayer {
    position: absolute;
    inset: 0;
    transform: translateX(0);
    opacity: 0;
    will-change: transform, opacity;
  }
  /* 两层预层：--1 在下、--2 在上，形成"阶梯"错位 */
  .sm-prelayer--2 { z-index: 1; background: color-mix(in srgb, var(--accent) 26%, #05070a); }
  .sm-prelayer--1 { z-index: 0; background: color-mix(in srgb, var(--accent) 12%, #05070a); }

  /* ── 主面板 ── */
  .sm-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    /* dvh 兜底：移动端浏览器工具栏收起/展开时视口高度会变，避免面板被截断 */
    height: 100dvh;
    width: var(--sm-panel-w);
    padding: 6.2rem 2rem 2rem;
    display: flex;
    flex-direction: column;
    background: var(--sm-panel-bg);
    /* 面板与页面都很暗，仅靠边框分不开 —— 用"亮边 + 大范围投影"建立层次：
       左缘一条雾蓝细线（--accent 低透明）＋ 向左的大范围暗影，让面板像浮在空中。 */
    border-left: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    -webkit-backdrop-filter: blur(26px) saturate(1.4);
    backdrop-filter: blur(26px) saturate(1.4);
    box-shadow: -1px 0 0 0 color-mix(in srgb, var(--accent) 22%, transparent),
      -40px 0 90px rgba(0, 0, 0, 0.55);
    z-index: 2;
    opacity: 0;
    pointer-events: auto;
    overflow-y: auto;
    will-change: transform, opacity;
  }
  html[data-sm-open='1'] .sm-panel { /* 打开时禁止页面滚动，由脚本加锁 */ }
  .sm-panel-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    counter-reset: smItem;
  }
  .sm-panel-itemWrap { position: relative; overflow: hidden; line-height: 1; }
  .sm-panel-item {
    position: relative;
    display: inline-block;
    padding-right: 1.4em;
    color: var(--ink-2);
    font-family: var(--font-display);
    font-size: clamp(2rem, 7vw, 3.2rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.06;
    text-decoration: none;
    transition: color 0.25s ease;
  }
  .sm-panel-item:hover { color: var(--accent); }
  .sm-panel-item[aria-current='page'] { color: var(--accent); }
  /* 编号（ReactBits 的 displayItemNumbering）*/
  .sm-panel-list[data-numbering] .sm-panel-item::after {
    counter-increment: smItem;
    content: counter(smItem, decimal-leading-zero);
    position: absolute;
    top: 0.15em;
    right: 0;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.06em;
    color: var(--accent);
    opacity: var(--sm-num-opacity, 0);
  }
  /* 入场动画的作用对象（旋转 + 上移）*/
  .sm-panel-itemLabel {
    display: inline-block;
    will-change: transform;
    transform-origin: 50% 100%;
  }

  /* ── 社交链接（最后淡入）── */
  .sm-socials {
    margin-top: auto;
    padding-top: 2.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .sm-socials-title {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    opacity: 0;
  }
  .sm-socials-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
  }
  .sm-socials-link {
    font-size: 1rem;
    font-weight: 500;
    color: var(--ink-2);
    text-decoration: none;
    opacity: 0;
    transition: color 0.3s ease, opacity 0.3s ease;
  }
  /* 悬停时其余淡出、当前高亮（ReactBits 同款）*/
  .sm-socials-list:hover .sm-socials-link:not(:hover) { opacity: 0.35 !important; }
  .sm-socials-link:hover { color: var(--accent); }

  /* ── 顶部指示线：悬停跟随 + 当前页激活 ── */
  .nav { position: relative; }
  .nav-ind {
    position: absolute;
    left: 0;
    bottom: 2px;
    height: 2px;
    width: 0;
    border-radius: 2px;
    background: var(--accent);
    pointer-events: none;
    opacity: 0;
    will-change: transform, width, opacity;
  }
  .nav-ind--hover { background: color-mix(in srgb, var(--accent) 55%, transparent); }

  /* ── 侧边面板的尺寸令牌 ──
     必须放在 :global(:root)：面板在 </header> 之外（见标记里的说明），
     定义在 .site-header 上的自定义属性它继承不到，会退化成 auto。 */
  :global(:root) {
    --sm-panel-w: clamp(280px, 38vw, 420px);
    /* 侧边菜单面板底色。同样必须在 :root —— 面板在 </header> 之外，
       定义在 .site-header 上的变量它继承不到（会变成透明）。 */
    --sm-panel-bg: rgba(7, 10, 14, 0.9);
  }
  @media (max-width: 640px) {
    :global(:root) { --sm-panel-w: 100vw; }
  }

  /* ══════════════════════════════════════════════════════════════
     导航胶囊令牌 —— 想换配色只改这一块
     结构/尺寸/交互与配色解耦：下面是"暗色玻璃"版，适配当前暗色电影感站点。
     若要换成规格原文里的**浅色通透**版（白胶囊 + 深字），把这些值换成：
       --nav-bg: rgba(255,255,255,.72);       --nav-bg-scrolled: rgba(255,255,255,.85);
       --nav-border: rgba(255,255,255,.6);    --nav-shadow: 0 4px 24px rgba(0,0,0,.06);
       --nav-shadow-scrolled: 0 8px 32px rgba(0,0,0,.10);
       --nav-ink: #1a1a2e;   --nav-ink-dim: #555;   --nav-hover-bg: rgba(0,0,0,.04);
       --nav-blur: blur(20px) saturate(1.4);  --nav-drawer-bg: rgba(255,255,255,.92);
     ══════════════════════════════════════════════════════════════ */
  .site-header {
    --nav-w: min(1200px, calc(100% - 40px));
    --nav-top: 16px;
    --nav-h: 56px;
    --nav-h-scrolled: 52px;
    /* 半透明 → 视频能透上来（保持暗色电影感） */
    --nav-bg: rgba(9, 12, 16, 0.55);
    --nav-bg-scrolled: rgba(9, 12, 16, 0.78);
    --nav-border: rgba(255, 255, 255, 0.2);
    --nav-border-scrolled: rgba(255, 255, 255, 0.3);
