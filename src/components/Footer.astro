---
import { SITE } from '../site';
import BrandMark from './BrandMark.astro';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    {/* 页脚同样用品牌标志（纯图标版，不重复横版字标），保持品牌一致 */}
    <span class="ft-brand">
      <BrandMark variant="icon" height={20} />
      <span>© {SITE.since}–{year} {SITE.author} · {SITE.title}</span>
    </span>
    <span>
      {SITE.email && <a href={`mailto:${SITE.email}`}>E-MAIL</a>}
      {SITE.github && <>&nbsp;·&nbsp;<a href={SITE.github} target="_blank" rel="noreferrer">GITHUB</a></>}
      {SITE.bilibili && <>&nbsp;·&nbsp;<a href={SITE.bilibili} target="_blank" rel="noreferrer">BILIBILI</a></>}
      <>&nbsp;·&nbsp;<a href="/rss.xml">RSS</a></>
    </span>
    <span title={SITE.notice}>{SITE.notice}</span>
  </div>
</footer>

<style>
  .ft-brand { display: inline-flex; align-items: center; gap: 0.5rem; }
  .ft-brand :global(.brandmark) { flex: none; }
</style>
