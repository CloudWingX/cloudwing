---
// 作品详情页布局：由 src/pages/works/[slug].astro 传入 entry.data 渲染。
// 作品正文（Markdown 渲染结果 <Content/>）会落入默认 slot。
import { SITE } from '../site';
import Base from './Base.astro';
import GiscusComments from '../components/GiscusComments.astro';

interface Props {
  data: {
    title: string;
    summary?: string;
    date?: string;
    order?: number;
    tags?: string[];
    tools?: string[];
    state?: string;
    cover?: string;
    link?: string;
  };
  newer?: { no: string; title: string; url: string } | null;
  older?: { no: string; title: string; url: string } | null;
  ogImage?: string;
}
const { data, newer = null, older = null, ogImage = '/og/default.png' } = Astro.props;
const title: string = data.title ?? SITE.title;
const summary: string = data.summary ?? '';
const date: string = data.date ? new Date(data.date).toISOString().slice(0, 10) : '';
const order: number = data.order ?? 0;
const tags: string[] = data.tags ?? [];
const tools: string[] = data.tools ?? [];
const state: string = data.state ?? '';
const cover: string | undefined = data.cover;

const no = 'W-' + String(order).padStart(3, '0');
const stateAttr = state.includes('进行') || state.includes('WIP') || state.includes('开发')
  ? 'warn'
  : state.includes('停') || state.includes('废弃') || state.includes('ERR')
    ? 'err'
    : '';
---
<Base title={`${no} · ${title}`} description={summary} center ogImage={ogImage}>
  <div class="wrap">
    <article>
      <header class="work-head">
        <div class="no-big">RECORD / {no}</div>
        <h1>{title}</h1>
        {summary && <p class="sub">{summary}</p>}
        <dl class="meta-grid">
          <div><dt>编号</dt><dd class="num">{no}</dd></div>
          <div><dt>归档日期</dt><dd class="num">{date}</dd></div>
          {state && (
            <div>
              <dt>状态</dt>
              <dd><span class="state" data-state={stateAttr}>{state}</span></dd>
            </div>
          )}
          <div><dt>分类</dt><dd>{tags.join(' / ')}</dd></div>
          {tools.length > 0 && <div><dt>工具链</dt><dd class="num">{tools.join(' · ')}</dd></div>}
          {data.link && (
            <div>
              <dt>链接</dt>
              <dd><a class="ext-link" href={data.link} target="_blank" rel="noreferrer">仓库 / 地址 ↗</a></dd>
            </div>
          )}
        </dl>
      </header>
      {cover && <img class="work-cover" src={cover} alt={`${no} ${title}`} width="1600" height="900" />}      <div class="prose">
        <slot />
      </div>

      <!-- 上/下篇导航（按归档日期相邻） -->
      <nav class="worknav" aria-label="相邻作品">
        {older ? (
          <a class="wn-item wn-prev" href={older.url}>
            <span class="wn-dir">← 上一篇</span>
            <span class="wn-no">{older.no}</span>
            <span class="wn-title">{older.title}</span>
          </a>
        ) : (
          <span class="wn-item wn-empty" aria-hidden="true">
            <span class="wn-dir">← 上一篇</span>
            <span class="wn-title">已经是最早的档案</span>
          </span>
        )}
        {newer ? (
          <a class="wn-item wn-next" href={newer.url}>
            <span class="wn-dir">下一篇 →</span>
            <span class="wn-no">{newer.no}</span>
            <span class="wn-title">{newer.title}</span>
          </a>
        ) : (
          <span class="wn-item wn-empty" aria-hidden="true">
            <span class="wn-dir">下一篇 →</span>
            <span class="wn-title">已经是最新的档案</span>
          </span>
        )}
      </nav>

      <nav class="pager" aria-label="页面导航">
        <a href="/works/">← 返回作品库</a>
        <a href="/">索引首页</a>
      </nav>

      <!-- 作品讨论区（giscus，按页面路径独立讨论） -->
      <section class="work-comments">
        <GiscusComments
          title="讨论"
          desc={`关于《${title}》的想法、问题或补充，欢迎在下方留言（GitHub 账号登录）。`}
        />
      </section>
    </article>
    <dialog id="lightbox" class="lightbox" aria-label="作品大图预览">
      <img alt="" />
      <div class="lb-cap">
        <span class="lb-cap-title"></span>
        <button type="button" class="lb-close">关闭 / ESC</button>
      </div>
    </dialog>
  </div>
</Base>
