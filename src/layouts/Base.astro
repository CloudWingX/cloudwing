---
import { SITE, VIDEO_BG } from '../site';
import ClientRouter from 'astro/components/ClientRouter.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import VideoBackground from '../components/VideoBackground.astro';
import PageParticlesBackground from '../components/PageParticlesBackground.jsx';
import SidebarNav from '../components/SidebarNav.astro';
import SidebarWidgets from '../components/SidebarWidgets.astro';
import '../styles/global.css';
import '../styles/motion.css';

interface Props {
  title?: string;
  description?: string;
  center?: boolean; // 居中版式（列表/详情/关于等页面用）
  bodyClass?: string; // 追加到 <body> 的路由级类名（页面级全局样式定位用）
  ogImage?: string; // 社交分享图（站内绝对路径，默认 /og/default.png）
  sidebar?: boolean; // 子页面三栏壳层：左导航树 + 内容 + 右挂件（首页不传）
}
const { title = SITE.title, description = SITE.tagline, center = false, bodyClass, ogImage = '/og/default.png', sidebar = false } = Astro.props;
const path = Astro.url.pathname;
// 社交分享图统一转绝对 URL（OG 规范要求）
const ogImageAbs = new URL(ogImage, Astro.site ?? Astro.url).href;
// 全站统一背景：React Bits <Particles /> 粒子层（fixed 全页），跟随浅/深主题。
// V53 起互动页也用该层（原先 /account/ 单独用 GridScan 深色背景），故不再有页面级例外。
const withParticles = true;
// 全站背景视频开关（见 site.ts 的 VIDEO_BG）：
// 开着的时候 body 会加 .has-video-bg，让不透明页面底色让位给视频（见 motion.css）。
const hasVideoBg = Boolean(VIDEO_BG.src);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {SITE.latin}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon-dark.svg" media="(prefers-color-scheme: dark)" />
    <!-- RSS 订阅（作品档案更新自动发现） -->
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} · 作品档案`} href="/rss.xml" />
    <!-- 字体：Latin→Inter（Google），中文走系统字体（PingFang SC / 微软雅黑 等）。
         只取 300–500 三档字重 —— 暗色电影感的排版约定是"字重不超过 500"，
         多载 600–900 只会白白增加体积（页面里已无 >500 的用法）。
         这里曾引过第三方中文 webfont「MiSans」，该仓库已 404、字体从未生效过，
         却是一个阻塞渲染的跨域请求 —— 不再引回。 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300..500&display=swap" rel="stylesheet" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} — ${SITE.latin}`} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:url" content={Astro.url.href} />
    <!-- 社交分享图（og:image / Twitter Card） -->
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — ${SITE.title}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — ${SITE.latin}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
    <link rel="canonical" href={Astro.url.href} />
    <meta name="theme-color" content="#070b0f" />
    <script is:inline>
      // 主题：全站只有一套**暗色**（亮色主题与切换按钮已删除）。
      // 这里把 data-theme 尽早写成 dark，避免首屏出现浅色闪烁；主题色 meta 同步为深色。
      (function () {
        document.documentElement.dataset.theme = 'dark';
        // 浏览器 UI（手机地址栏等）颜色：跟随暗色
        var metas = document.querySelectorAll('meta[name="theme-color"]');
        for (var i = 0; i < metas.length; i++) metas[i].setAttribute('content', '#070b0f');
      })();
      // 尽早打上 js 标记，让「入场/显现」动效只在 JS 可用时接管（无 JS 则直接显示）
      document.documentElement.classList.add('js');
    </script>
    <ClientRouter />
  </head>
  <body class:list={[bodyClass, { 'bg-particles': withParticles, 'has-video-bg': hasVideoBg }]}>
    {/* 全站背景视频（最底层，见 VideoBackground.astro 的层次注释） */}
    <VideoBackground />
    {withParticles && (
      // Particles 全页背景（fixed 层，见 .pparticles-layer；旧光斑/网格背景随之停用）
      <PageParticlesBackground client:load />
    )}
    <div class="grid-bg" aria-hidden="true"></div>
    <!-- 全局阅读进度（纯装饰，reduced-motion 下停用） -->
    <div class="prog" aria-hidden="true"></div>
    <Header current={path} />
    {sidebar ? (
      // 子页面三栏壳层：左右侧栏在 <main> 之外，切页时不会被 main 的入场动画带着闪，
      // 内容也完全一致（同一套导航树 + 同一套挂件），切子页面时侧栏视觉不变。
      <div class="shell">
        <SidebarNav />
        <main id="main" class:list={['main-content', { 'center-page': center }]}>
          <slot />
        </main>
        <SidebarWidgets />
      </div>
    ) : (
      <main id="main" class:list={['main-content', { 'center-page': center }]}>
        <slot />
      </main>
    )}
    <Footer />
    {/* 全站搜索悬浮窗（Pagefind；首屏不加载其 JS/CSS，首次打开时再拉，见 ui.js 的 searchModal()） */}
    <SearchModal />
  </body>
  <script>
    import '../scripts/ui.js';
  </script>
</html>
