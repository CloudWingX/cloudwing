---
import { SITE } from '../site';
import ClientRouter from 'astro/components/ClientRouter.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageParticlesBackground from '../components/PageParticlesBackground.jsx';
import SidebarNav from '../components/SidebarNav.astro';
import SidebarWidgets from '../components/SidebarWidgets.astro';
import '../styles/global.css';
import '../styles/motion.css';

interface Props {
  title?: string;
  description?: string;
  center?: boolean; // 居中版式（列表/详情/关于等页面用）
  bodyClass?: string; // 追加到 <body> 的路由级类名（页面级全局样式定位用）
  ogImage?: string; // 社交分享图（站内绝对路径，默认 /og/default.png）
  sidebar?: boolean; // 子页面三栏壳层：左导航树 + 内容 + 右挂件（首页不传）
}
const { title = SITE.title, description = SITE.tagline, center = false, bodyClass, ogImage = '/og/default.png', sidebar = false } = Astro.props;
const path = Astro.url.pathname;
// 社交分享图统一转绝对 URL（OG 规范要求）
const ogImageAbs = new URL(ogImage, Astro.site ?? Astro.url).href;
// 全站统一背景：React Bits <Particles /> 粒子层（fixed 全页），跟随浅/深主题。
// V53 起互动页也用该层（原先 /account/ 单独用 GridScan 深色背景），故不再有页面级例外。
const withParticles = true;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {SITE.latin}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon-dark.svg" media="(prefers-color-scheme: dark)" />
    <!-- RSS 订阅（作品档案更新自动发现） -->
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} · 作品档案`} href="/rss.xml" />
    <!-- v3 字体：Latin→Outfit（Google），中文走系统字体（PingFang SC / 微软雅黑 等）
         这里原本还引一行第三方中文 webfont「MiSans」（jsDelivr 上的一个 GitHub 仓库）：
         该仓库已 404，jsDelivr 上不论 @latest 还是 @main 都取不到内容，字体从未生效过，
         却是一个阻塞渲染的跨域请求 —— 移除后中文排版与之前完全一致，首屏少等一个请求。 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400..900&display=swap" rel="stylesheet" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} — ${SITE.latin}`} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:url" content={Astro.url.href} />
    <!-- 社交分享图（og:image / Twitter Card） -->
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — ${SITE.title}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — ${SITE.latin}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
    <link rel="canonical" href={Astro.url.href} />
    <meta name="theme-color" content="#e9ebee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0c0e" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // 尽早应用主题：白日/夜间 二态，避免闪烁。
      // ★默认夜间★：没有存过偏好（或存的是历史值 auto）时一律用 dark —— 站点开箱即暗色。
      //   用户点过主题开关后会把 light/dark 落盘，之后一律尊重用户选择。
      (function () {
        function g(k) {
          try { var v = localStorage.getItem(k) || sessionStorage.getItem(k); if (v) return v; } catch (e) { /* ignore */ }
          try {
            var m = document.cookie.match(new RegExp('(?:^|; )' + k + '=([^;]*)'));
            if (m && m[1]) return decodeURIComponent(m[1]);
          } catch (e2) { /* ignore */ }
          return null;
        }
        function pref() {
          var p = g('cw-theme-pref');
          if (p === 'light' || p === 'dark') return p;
          var old = g('cw-theme'); // 旧版本：已解析主题当作偏好迁移
          if (old === 'light' || old === 'dark') return old;
          return null; // 无偏好 → 走默认（夜间）
        }
        var mode = pref();
        // 默认夜间：只有用户显式选过 light 才是白日；旧值 auto 也一并归到夜间
        var resolved = mode === 'light' ? 'light' : 'dark';
        document.documentElement.dataset.theme = resolved;
        document.documentElement.dataset.themePref = resolved;
        // 浏览器 UI（手机地址栏等）的颜色：按**实际解析出的主题**给，
        // 不能只靠 prefers-color-scheme —— 默认夜间时，系统是白日的访客会拿到浅色地址栏配深色页面。
        // 取值与上面两个 <meta name="theme-color"> 保持一致（暗 #0c0c0e / 浅 #e9ebee）。
        var tc = resolved === 'dark' ? '#0c0c0e' : '#e9ebee';
        var metas = document.querySelectorAll('meta[name="theme-color"]');
        for (var i = 0; i < metas.length; i++) metas[i].setAttribute('content', tc);
      })();
      // 尽早打上 js 标记，让「入场/显现」动效只在 JS 可用时接管（无 JS 则直接显示）
      document.documentElement.classList.add('js');
    </script>
    <ClientRouter />
  </head>
  <body class:list={[bodyClass, { 'bg-particles': withParticles }]}>
    {withParticles && (
      // Particles 全页背景（fixed 层，见 .pparticles-layer；旧光斑/网格背景随之停用）
      <PageParticlesBackground client:load />
    )}
    <div class="grid-bg" aria-hidden="true"></div>
    <!-- 全局阅读进度（纯装饰，reduced-motion 下停用） -->
    <div class="prog" aria-hidden="true"></div>
    <Header current={path} />
    {sidebar ? (
      // 子页面三栏壳层：左右侧栏在 <main> 之外，切页时不会被 main 的入场动画带着闪，
      // 内容也完全一致（同一套导航树 + 同一套挂件），切子页面时侧栏视觉不变。
      <div class="shell">
        <SidebarNav />
        <main id="main" class:list={['main-content', { 'center-page': center }]}>
          <slot />
        </main>
        <SidebarWidgets />
      </div>
    ) : (
      <main id="main" class:list={['main-content', { 'center-page': center }]}>
        <slot />
      </main>
    )}
    <Footer />
  </body>
  <script>
    import '../scripts/ui.js';
  </script>
</html>
