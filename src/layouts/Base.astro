---
import { execSync } from 'node:child_process';
import { SITE, VIDEO_BG } from '../site';
import ClientRouter from 'astro/components/ClientRouter.astro';
import Header from '../components/Header.astro';
import SearchModal from '../components/SearchModal.astro';
import VideoBackground from '../components/VideoBackground.astro';
import PageParticlesBackground from '../components/PageParticlesBackground.jsx';
import SidebarNav from '../components/SidebarNav.astro';
import SidebarWidgets from '../components/SidebarWidgets.astro';
import '../styles/global.css';
import '../styles/motion.css';

interface Props {
  title?: string;
  description?: string;
  center?: boolean; // 居中版式（列表/详情/关于等页面用）
  bodyClass?: string; // 追加到 <body> 的路由级类名（页面级全局样式定位用）
  ogImage?: string; // 社交分享图（站内绝对路径，默认 /og/default.png）
  sidebar?: boolean; // 子页面三栏壳层：左导航树 + 内容 + 右挂件（首页不传）
}
const { title = SITE.title, description = SITE.tagline, center = false, bodyClass, ogImage = '/og/default.png', sidebar = false } = Astro.props;
const path = Astro.url.pathname;
// 社交分享图统一转绝对 URL（OG 规范要求）
const ogImageAbs = new URL(ogImage, Astro.site ?? Astro.url).href;
// 全站统一背景：React Bits <Particles /> 粒子层（fixed 全页），跟随浅/深主题。
// V53 起互动页也用该层（原先 /account/ 单独用 GridScan 深色背景），故不再有页面级例外。
const withParticles = true;
// 全站背景视频开关（见 site.ts 的 VIDEO_BG）：
// 开着的时候 body 会加 .has-video-bg，让不透明页面底色让位给视频（见 motion.css）。
const hasVideoBg = Boolean(VIDEO_BG.src);
// 构建指纹（§60）：软导航换进来的是新 DOM（带新指纹），而标签页里的 JS 还是首次
// 加载那一版 —— 跨部署存量标签页会出现「DOM 新、逻辑旧」错配；头部内联脚本比对
// 不一致时整页刷新一次自愈（sessionStorage 防循环）。
// §63（2026-09-21）⚠️ 指纹必须**全站构建内恒定**：组件 frontmatter 是逐页执行的，
// 用 Date.now() 会拿到「每页一个指纹」（实测 7 页 7 值），跨页软导航必触发误判
// reload —— 站长侧「每个页面连续快速加载两次 + 白闪」即此。改取**部署提交 SHA**
// （CF Pages CI 注入 CF_PAGES_COMMIT_SHA；本地回退 git rev-parse；都失败用常量，
// 宁可漏一次跨部署自愈，也绝不能逐页漂移误刷）。用 globalThis 记忆化避免逐页 spawn。
if (import.meta.env.PROD && !globalThis.__cwBuildId) {
  globalThis.__cwBuildId =
    process.env.CF_PAGES_COMMIT_SHA ||
    process.env.COMMIT_REF ||
    (() => { try { return execSync('git rev-parse HEAD', { stdio: ['ignore', 'pipe', 'ignore'] }).toString().trim(); } catch { return 'static-build'; } })();
}
const BUILD_ID = import.meta.env.PROD ? globalThis.__cwBuildId : 'dev';
---
<!doctype html>
<!-- §62（2026-09-21）：html 行内深色背景 = 空白导航期/硬加载首绘的防白屏根治。
     ⚠️ 前提：body 的底色渐变已迁移到 body::after（z:-5，视频之下，见 global.css §62），
     body 自身保持无背景 —— 否则不透明 body 背景会按绘制顺序盖住 z:-4 的背景视频层
     （§61.3 实测回归）。ClientRouter 换页同步新文档 html 属性，本样式软导航后不丢。 -->
<html lang="zh-CN" style="background:#03060a">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {SITE.latin}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon-dark.svg" media="(prefers-color-scheme: dark)" />
    <!-- RSS 订阅（博客更新自动发现） -->
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} · 博客`} href="/rss.xml" />
    <!-- 字体：Latin→Inter（Google），中文走系统字体（PingFang SC / 微软雅黑 等）。
         只取 300–500 三档字重 —— 暗色电影感的排版约定是"字重不超过 500"，
         多载 600–900 只会白白增加体积（页面里已无 >500 的用法）。
         这里曾引过第三方中文 webfont「MiSans」，该仓库已 404、字体从未生效过，
         却是一个阻塞渲染的跨域请求 —— 不再引回。 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300..500&display=swap" rel="stylesheet" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} — ${SITE.latin}`} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:url" content={Astro.url.href} />
    <!-- 社交分享图（og:image / Twitter Card） -->
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — ${SITE.title}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — ${SITE.latin}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
    <link rel="canonical" href={Astro.url.href} />
    <meta name="theme-color" content="#070b0f" />
    <!-- §61：浏览器在解析 CSS 前就按暗色起步（首绘画布/表单控件/overscroll 全暗） -->
    <meta name="color-scheme" content="dark" />
    <meta name="cw-build" content={BUILD_ID} />
    <style is:inline>
      /* §61.4/§62 pre-CSS 深色画布：meta color-scheme 救不了所有浏览器的画布
         （Safari/Windows 内核 pre-CSS 首绘就是白）。html 的行内背景已由上方
         style 属性承担；这里只补 color-scheme（表单控件/滚动条等暗色化）。 */
      html { color-scheme: dark; }
    </style>
    <script is:inline>
      // 主题：全站只有一套**暗色**（亮色主题与切换按钮已删除）。
      // 这里把 data-theme 尽早写成 dark，避免首屏出现浅色闪烁；主题色 meta 同步为深色。
      (function () {
        document.documentElement.dataset.theme = 'dark';
        // 浏览器 UI（手机地址栏等）颜色：跟随暗色
        var metas = document.querySelectorAll('meta[name="theme-color"]');
        for (var i = 0; i < metas.length; i++) metas[i].setAttribute('content', '#070b0f');
      })();
      // 尽早打上 js 标记，让「入场/显现」动效只在 JS 可用时接管（无 JS 则直接显示）
      document.documentElement.classList.add('js');
    </script>
    <script is:inline>
      // §60 构建指纹自愈（2026-09-21）：ClientRouter 软导航后，astro:page-load 时
      // 比对「当前 DOM 的 cw-build 戳」与「本标签页 JS 首次加载时记下的戳」。
      // 不一致 = 存量标签页跨部署（DOM 新、JS 旧）→ 整页刷新一次拿齐新 JS。
      // sessionStorage 防环：对同一构建只自动刷一次；刷新后仍不一致（如 CDN 供旧页）就放弃。
      // 这是对「监听器闭包抓旧构建逻辑」这一 §5 铁律跨部署变体的兜底，不是替代。
      (function () {
        var m = document.querySelector('meta[name="cw-build"]');
        window.__cwBuildStamp = m ? m.getAttribute('content') : '';
        document.addEventListener('astro:page-load', function () {
          var cur = document.querySelector('meta[name="cw-build"]');
          cur = cur ? cur.getAttribute('content') : '';
          if (!cur || cur === window.__cwBuildStamp) return;
          try {
            var KEY = 'cwBuildReload';
            if (sessionStorage.getItem(KEY) === cur) return;
            sessionStorage.setItem(KEY, cur);
          } catch (e) {}
          window.__cwBuildStamp = cur;
          location.reload();
        });
      })();
    </script>
    <script is:inline>
      // §67.8 音频 Range 补丁（Service Worker）：CF Pages 静态资产不支持 Range，
      // 线上媒体 seek 行为不稳定（点进度条可能被钳回 0）。sw.js 只碰
      // /music/*.mp3 的 Range 请求（本地缓存整曲后按需切 206），其余流量零参与。
      // 注册越早接管越早；任何失败静默——最坏退回平台原生行为。
      if ('serviceWorker' in navigator) {
        try { navigator.serviceWorker.register('/sw.js').catch(function () {}); } catch (e) {}
      }
    </script>
    <ClientRouter />
  </head>
  <body class:list={[bodyClass, { 'bg-particles': withParticles, 'has-video-bg': hasVideoBg }]}>
    {/* 全站背景视频（最底层，见 VideoBackground.astro 的层次注释） */}
    <VideoBackground />
    {withParticles && (
      // Particles 全页背景（fixed 层，见 .pparticles-layer；旧光斑/网格背景随之停用）
      <PageParticlesBackground client:load />
    )}
    <div class="grid-bg" aria-hidden="true"></div>
    <!-- 全局阅读进度（纯装饰，reduced-motion 下停用） -->
    <div class="prog" aria-hidden="true"></div>
    <Header current={path} />
    {sidebar ? (
      // 子页面三栏壳层：左右侧栏在 <main> 之外，切页时不会被 main 的入场动画带着闪，
      // 内容也完全一致（同一套导航树 + 同一套挂件），切子页面时侧栏视觉不变。
      <div class="shell">
        <SidebarNav />
        <main id="main" class:list={['main-content', { 'center-page': center }]}>
          <slot />
        </main>
        <SidebarWidgets />
      </div>
    ) : (
      <main id="main" class:list={['main-content', { 'center-page': center }]}>
        <slot />
      </main>
    )}
    {/* 全站搜索悬浮窗（Pagefind；首屏不加载其 JS/CSS，首次打开时再拉，见 ui.js 的 searchModal()） */}
    <SearchModal />
  </body>
  <script>
    import '../scripts/ui.js';
  </script>
</html>
