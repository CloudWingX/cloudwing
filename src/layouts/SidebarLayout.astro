---
// 子页面三栏壳层：左导航树 / 中内容 / 右挂件（左右侧栏内容全站统一，切页不变）。
// 壳层本体在 Base.astro 里渲染（侧栏放在 <main> 之外，避免被整页入场动画带着闪）；
// 这里只是一层语义化包装，页面用 <SidebarLayout> 而不是 <Base sidebar>。
import Base from './Base.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  center?: boolean;
  bodyClass?: string;
}
const { title, description, ogImage, center = true, bodyClass } = Astro.props;
---
<Base title={title} description={description} ogImage={ogImage} center={center} bodyClass={bodyClass} sidebar>
  <slot />
</Base>
